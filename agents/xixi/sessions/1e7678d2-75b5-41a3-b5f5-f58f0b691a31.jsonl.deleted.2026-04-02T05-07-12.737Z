sions_send` 到 `main` 超时\n- `gh` CLI 当前受审批限制，无法直接按要求走 `gh api`\n- Discord 公共内容不可直接抓取\n- `openclaw-weixin` 仓库不可见 / 无权限搜索","textSignature":"{\"v\":1,\"id\":\"msg_0c9cc6d6377935420169cd507e29808191b75d453e796f1d75\",\"phase\":\"final_answer\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":142,"output":831,"cacheRead":57984,"cacheWrite":0,"totalTokens":58957,"cost":{"input":0.000355,"output":0.012465,"cacheRead":0.014496,"cacheWrite":0,"total":0.027316}},"stopReason":"stop","timestamp":1775063161723,"responseId":"resp_0c9cc6d6377935420169cd507a1bcc81919b656bc46a93c1f7"}}
