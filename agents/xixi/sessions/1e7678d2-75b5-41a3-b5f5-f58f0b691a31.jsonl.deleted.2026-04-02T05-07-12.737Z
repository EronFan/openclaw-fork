ps://api.github.com/users/altaywtf/orgs\\\",\\n          \\\"repos_url\\\": \\\"https://api.github.com/users/altaywtf/repos\\\",\\n          \\\"events_url\\\": \\\"https://api.github.com/users/altaywtf/events{/privacy}\\\",\\n          \\\"received_events_url\\\": \\\"https://api.github.com/users/altaywtf/received_events\\\",\\n          \\\"type\\\": \\\"User\\\",\\n          \\\"user_view_type\\\": \\\"public\\\",\\n          \\\"site_admin\\\": false\\n        }\\n      ],\\n      \\\"milestone\\\": null,\\n      \\\"comments\\\": 9,\\n      \\\"created_at\\\": \\\"2026-03-26T08:37:42Z\\\",\\n      \\\"updated_at\\\": \\\"2026-04-01T17:04:13Z\\\",\\n      \\\"closed_at\\\": null,\\n      \\\"assignee\\\": {\\n        \\\"login\\\": \\\"altaywtf\\\",\\n        \\\"id\\\": 9790196,\\n        \\\"node_id\\\": \\\"MDQ6VXNlcjk3OTAxOTY=\\\",\\n        \\\"avatar_url\\\": \\\"https://avatars.githubusercontent.com/u/9790196?v=4\\\",\\n        \\\"gravatar_id\\\": \\\"\\\",\\n        \\\"url\\\": \\\"https://api.github.com/users/altaywtf\\\",\\n        \\\"html_url\\\": \\\"https://github.com/altaywtf\\\",\\n        \\\"followers_url\\\": \\\"https://api.github.com/users/altaywtf/followers\\\",\\n        \\\"following_url\\\": \\\"https://api.github.com/users/altaywtf/following{/other_user}\\\",\\n        \\\"gists_url\\\": \\\"https://api.github.com/users/altaywtf/gists{/gist_id}\\\",\\n        \\\"starred_url\\\": \\\"https://api.github.com/users/altaywtf/starred{/owner}{/repo}\\\",\\n        \\\"subscriptions_url\\\": \\\"https://api.github.com/users/altaywtf/subscriptions\\\",\\n        \\\"organizations_url\\\": \\\"https://api.github.com/users/altaywtf/orgs\\\",\\n        \\\"repos_url\\\": \\\"https://api.github.com/users/altaywtf/repos\\\",\\n        \\\"events_url\\\": \\\"https://api.github.com/users/altaywtf/events{/privacy}\\\",\\n        \\\"received_events_url\\\": \\\"https://api.github.com/users/altaywtf/received_events\\\",\\n        \\\"type\\\": \\\"User\\\",\\n        \\\"user_view_type\\\": \\\"public\\\",\\n        \\\"site_admin\\\": false\\n      },\\n      \\\"author_association\\\": \\\"NONE\\\",\\n      \\\"issue_field_values\\\": [],\\n      \\\"type\\\": null,\\n      \\\"active_lock_reason\\\": null,\\n      \\\"draft\\\": false,\\n      \\\"pull_request\\\": {\\n        \\\"url\\\": \\\"https://api.github.com/repos/openclaw/openclaw/pulls/55043\\\",\\n        \\\"html_url\\\": \\\"https://github.com/openclaw/openclaw/pull/55043\\\",\\n        \\\"diff_url\\\": \\\"https://github.com/openclaw/openclaw/pull/55043.diff\\\",\\n        \\\"patch_url\\\": \\\"https://github.com/openclaw/openclaw/pull/55043.patch\\\",\\n        \\\"merged_at\\\": null\\n      },\\n      \\\"body\\\": \\\"## Problem\\\\n\\\\n`CronToolSchema` defines `job` and `patch` as `Type.Object({}, { additionalProperties: true })`, producing `\\\\\\\"properties\\\\\\\": {}`. Strict models (GPT-5.4) follow the schema literally and send `job: {}`, which the gateway rejects.\\\\n\\\\nCloses #55035\\\\n\\\\n## Solution\\\\n\\\\nSpell out the sub-properties for `job`, `patch`, and their nested objects (`schedule`, `payload`, `delivery`, `failureAlert`) so that models know which fields to send.\\\\n\\\\n## What does NOT change\\\\n\\\\n- Runtime validation (handled by `normalizeCronJob*`)\\\\n- `additionalProperties: true` (preserved everywhere)\\\\n- Flattened schema with per-action parameters\\\\n\\\\n## Tests\\\\n\\\\n`cron-tool.schema.test.ts`: 6 regression tests that assert the exact field list for `job`, `patch`, and nested objects. Any accidental field removal breaks the test.\\\",\\n      \\\"reactions\\\": {\\n        \\\"url\\\": \\\"https://api.github.com/repos/openclaw/openclaw/issues/55043/reactions\\\",\\n        \\\"total_count\\\": 2,\\n        \\\"+1\\\": 1,\\n        \\\"-1\\\": 0,\\n        \\\"laugh\\\": 0,\\n        \\\"hooray\\\": 0,\\n        \\\"confused\\\": 0,\\n        \\\"heart\\\": 0,\\n        \\\"rocket\\\": 0,\\n        \\\"eyes\\\": 1\\n      },\\n      \\\"timeline_url\\\": \\\"https://api.github.com/repos/openclaw/openclaw/issues/55043/timeline\\\",\\n      \\\"performed_via_github_app\\\": null,\\n      \\\"state_reason\\\": null,\\n      \\\"score\\\": 1\\n    },\\n    {\\n      \\\"url\\\": \\\"https://api.github.com/repos/openclaw/openclaw/issues/58449\\\",\\n      \\\"repository_url\\\": \\\"https://api.github.com/repos/openclaw/openclaw\\\",\\n      \\\"labels_url\\\": \\\"https://api.github.com/repos/openclaw/openclaw/issues/58449/labels{/name}\\\",\\n      \\\"comments_url\\\": \\\"https://api.github.com/repos/openclaw/openclaw/issues/58449/comments\\\",\\n      \\\"events_url\\\": \\\"https://api.github.com/repos/openclaw/openclaw/issues/58449/events\\\",\\n      \\\"html_url\\\": \\\"https://github.com/openclaw/openclaw/pull/58449\\\",\\n      \\\"id\\\": 4180291384,\\n      \\\"node_id\\\": \\\"PR_kwDOQb6kR87O_hx1\\\",\\n      \\\"number\\\": 58449,\\n      \\\"title\\\": \\\"fix(matrix): honor room account scoping\\\",\\n      \\\"user\\\": {\\n        \\\"login\\\": \\\"Daanvdplas\\\",\\n        \\\"id\\\": 93204684,\\n        \\\"node_id\\\": \\\"U_kgDOBY4wzA\\\",\\n        \\\"avatar_url\\\": \\\"https://avatars.githubusercontent.com/u/93204684?v=4\\\",\\n        \\\"gravatar_id\\\": \\\"\\\",\\n        \\\"url\\\": \\\"https://api.github.com/users/Daanvdplas\\\",\\n        \\\"html_url\\\": \\\"https://github.com/Daanvdplas\\\",\\n        \\\"followers_url\\\": \\\"https://api.github.com/users/Daanvdplas/followers\\\",\\n        \\\"following_url\\\": \\\"https://api.github.com/users/Daanvdplas/following{/other_user}\\\",\\n        \\\"gists_url\\\": \\\"https://api.github.com/users/Daanvdplas/gists{/gist_id}\\\",\\n        \\\"starred_url\\\": \\\"https://api.github.com/users/Daanvdplas/starred{/owner}{/repo}\\\",\\n        \\\"subscriptions_url\\\": \\\"https://api.github.com/users/Daanvdplas/subscriptions\\\",\\n        \\\"organizations_url\\\": \\\"https://api.github.com/users/Daanvdplas/orgs\\\",\\n        \\\"repos_url\\\": \\\"https://api.github.com/users/Daanvdplas/repos\\\",\\n        \\\"events_url\\\": \\\"https://api.github.com/users/Daanvdplas/events{/privacy}\\\",\\n        \\\"received_events_url\\\": \\\"https://api.github.com/users/Daanvdplas/received_events\\\",\\n        \\\"type\\\": \\\"User\\\",\\n        \\\"user_view_type\\\": \\\"public\\\",\\n        \\\"site_admin\\\": false\\n      },\\n      \\\"labels\\\": [\\n        {\\n          \\\"id\\\": 9706244975,\\n          \\\"node_id\\\": \\\"LA_kwDOQb6kR88AAAACQomLbw\\\",\\n          \\\"url\\\": \\\"https://api.github.com/repos/openclaw/openclaw/labels/docs\\\",\\n          \\\"name\\\": \\\"docs\\\",\\n          \\\"color\\\": \\\"0075ca\\\",\\n          \\\"default\\\": false,\\n          \\\"description\\\": \\\"Improvements or additions to documentation\\\"\\n        },\\n        {\\n          \\\"id\\\": 10064298237,\\n          \\\"node_id\\\": \\\"LA_kwDOQb6kR88AAAACV-EA_Q\\\",\\n          \\\"url\\\": \\\"https://api.github.com/repos/openclaw/openclaw/labels/channel:%20matrix\\\",\\n          \\\"name\\\": \\\"channel: matrix\\\",\\n          \\\"color\\\": \\\"1d76db\\\",\\n          \\\"default\\\": false,\\n          \\\"description\\\": \\\"Channel integration: matrix\\\"\\n        },\\n        {\\n          \\\"id\\\": 10190106760,\\n          \\\"node_id\\\": \\\"LA_kwDOQb6kR88AAAACX2CwiA\\\",\\n          \\\"url\\\": \\\"https://api.github.com/repos/openclaw/openclaw/labels/size:%20L\\\",\\n          \\\"name\\\": \\\"size: L\\\",\\n          \\\"color\\\": \\\"b76e79\\\",\\n          \\\"default\\\": false,\\n          \\\"description\\\": null\\n        }\\n      ],\\n      \\\"state\\\": \\\"open\\\",\\n      \\\"locked\\\": false,\\n      \\\"assignees\\\": [\\n        {\\n          \\\"login\\\": \\\"gumadeiras\\\",\\n          \\\"id\\\": 5599352,\\n          \\\"node_id\\\": \\\"MDQ6VXNlcjU1OTkzNTI=\\\",\\n         