nts\",\n          \"type\": \"User\",\n          \"user_view_type\": \"public\",\n          \"site_admin\": false\n        }\n      ],\n      \"milestone\": null,\n      \"comments\": 3,\n      \"created_at\": \"2026-03-30T06:39:14Z\",\n      \"updated_at\": \"2026-04-01T14:01:51Z\",\n      \"closed_at\": null,\n      \"assignee\": {\n        \"login\": \"BradGroux\",\n        \"id\": 3053586,\n        \"node_id\": \"MDQ6VXNlcjMwNTM1ODY=\",\n        \"avatar_url\": \"https://avatars.githubusercontent.com/u/3053586?v=4\",\n        \"gravatar_id\": \"\",\n        \"url\": \"https://api.github.com/users/BradGroux\",\n        \"html_url\": \"https://github.com/BradGroux\",\n        \"followers_url\": \"https://api.github.com/users/BradGroux/followers\",\n        \"following_url\": \"https://api.github.com/users/BradGroux/following{/other_user}\",\n        \"gists_url\": \"https://api.github.com/users/BradGroux/gists{/gist_id}\",\n        \"starred_url\": \"https://api.github.com/users/BradGroux/starred{/owner}{/repo}\",\n        \"subscriptions_url\": \"https://api.github.com/users/BradGroux/subscriptions\",\n        \"organizations_url\": \"https://api.github.com/users/BradGroux/orgs\",\n        \"repos_url\": \"https://api.github.com/users/BradGroux/repos\",\n        \"events_url\": \"https://api.github.com/users/BradGroux/events{/privacy}\",\n        \"received_events_url\": \"https://api.github.com/users/BradGroux/received_events\",\n        \"type\": \"User\",\n        \"user_view_type\": \"public\",\n        \"site_admin\": false\n      },\n      \"author_association\": \"CONTRIBUTOR\",\n      \"issue_field_values\": [],\n      \"type\": null,\n      \"active_lock_reason\": null,\n      \"draft\": false,\n      \"pull_request\": {\n        \"url\": \"https://api.github.com/repos/openclaw/openclaw/pulls/57529\",\n        \"html_url\": \"https://github.com/openclaw/openclaw/pull/57529\",\n        \"diff_url\": \"https://github.com/openclaw/openclaw/pull/57529.diff\",\n        \"patch_url\": \"https://github.com/openclaw/openclaw/pull/57529.patch\",\n        \"merged_at\": null\n      },\n      \"body\": \"## Summary\\n- Adds `channel-list` and `channel-info` message actions to the MS Teams extension\\n- `channel-list`: lists channels in a team with displayName, description, membershipType\\n- `channel-info`: gets full channel details including webUrl and createdDateTime\\n- Both use Microsoft Graph `/teams/{id}/channels` endpoints\\n\\n## Test plan\\n- [x] Unit tests for `listChannelsMSTeams` (channels returned, empty team, undefined value)\\n- [x] Unit tests for `getChannelInfoMSTeams` (full details, sparse data)\\n- [x] `pnpm test -- extensions/msteams` passes (454 tests, 44 files)\\n- [x] `pnpm check` passes\\n\\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\",\n      \"reactions\": {\n        \"url\": \"https://api.github.com/repos/openclaw/openclaw/issues/57529/reactions\",\n        \"total_count\": 1,\n        \"+1\": 1,\n        \"-1\": 0,\n        \"laugh\": 0,\n        \"hooray\": 0,\n        \"confused\": 0,\n        \"heart\": 0,\n        \"rocket\": 0,\n        \"eyes\": 0\n      },\n      \"timeline_url\": \"https://api.github.com/repos/openclaw/openclaw/issues/57529/timeline\",\n      \"performed_via_github_app\": null,\n      \"state_reason\": null,\n      \"score\": 1\n    },\n    {\n      \"url\": \"https://api.github.com/repos/openclaw/openclaw/issues/59049\",\n      \"repository_url\": \"https://api.github.com/repos/openclaw/openclaw\",\n      \"labels_url\": \"https://api.github.com/repos/openclaw/openclaw/issues/59049/labels{/name}\",\n      \"comments_url\": \"https://api.github.com/repos/openclaw/openclaw/issues/59049/comments\",\n      \"events_url\": \"https://api.github.com/repos/openclaw/openclaw/issues/59049/events\",\n      \"html_url\": \"https://github.com/openclaw/openclaw/pull/59049\",\n      \"id\": 4187127766,\n      \"node_id\": \"PR_kwDOQb6kR87PRHuj\",\n      \"number\": 59049,\n      \"title\": \"fix(agents): honor cacheRetention for custom anthropic providers\",\n      \"user\": {\n        \"login\": \"vincentkoc\",\n        \"id\": 25068,\n        \"node_id\": \"MDQ6VXNlcjI1MDY4\",\n        \"avatar_url\": \"https://avatars.githubusercontent.com/u/25068?v=4\",\n        \"gravatar_id\": \"\",\n        \"url\": \"https://api.github.com/users/vincentkoc\",\n        \"html_url\": \"https://github.com/vincentkoc\",\n        \"followers_url\": \"https://api.github.com/users/vincentkoc/followers\",\n        \"following_url\": \"https://api.github.com/users/vincentkoc/following{/other_user}\",\n        \"gists_url\": \"https://api.github.com/users/vincentkoc/gists{/gist_id}\",\n        \"starred_url\": \"https://api.github.com/users/vincentkoc/starred{/owner}{/repo}\",\n        \"subscriptions_url\": \"https://api.github.com/users/vincentkoc/subscriptions\",\n        \"organizations_url\": \"https://api.github.com/users/vincentkoc/orgs\",\n        \"repos_url\": \"https://api.github.com/users/vincentkoc/repos\",\n        \"events_url\": \"https://api.github.com/users/vincentkoc/events{/privacy}\",\n        \"received_events_url\": \"https://api.github.com/users/vincentkoc/received_events\",\n        \"type\": \"User\",\n        \"user_view_type\": \"public\",\n        \"site_admin\": false\n      },\n      \"labels\": [\n        {\n          \"id\": 10069976942,\n          \"node_id\": \"LA_kwDOQb6kR88AAAACWDenbg\",\n          \"url\": \"https://api.github.com/repos/openclaw/openclaw/labels/agents\",\n          \"name\": \"agents\",\n          \"color\": \"5319e7\",\n          \"default\": false,\n          \"description\": \"Agent runtime and tooling\"\n        },\n        {\n          \"id\": 10118530218,\n          \"node_id\": \"LA_kwDOQb6kR88AAAACWxyEqg\",\n          \"url\": \"https://api.github.com/repos/openclaw/openclaw/labels/maintainer\",\n          \"name\": \"maintainer\",\n          \"color\": \"FFD700\",\n          \"default\": false,\n          \"description\": \"Maintainer-authored PR\"\n        },\n        {\n          \"id\": 10190106648,\n          \"node_id\": \"LA_kwDOQb6kR88AAAACX2CwGA\",\n          \"url\": \"https://api.github.com/repos/openclaw/openclaw/labels/size:%20S\",\n          \"name\": \"size: S\",\n          \"color\": \"b76e79\",\n          \"default\": false,\n          \"description\": null\n        }\n      ],\n      \"state\": \"open\",\n      \"locked\": false,\n      \"assignees\": [\n        {\n          \"login\": \"vincentkoc\",\n          \"id\": 25068,\n          \"node_id\": \"MDQ6VXNlcjI1MDY4\",\n          \"avatar_url\": \"https://avatars.githubusercontent.com/u/25068?v=4\",\n          \"gravatar_id\": \"\",\n          \"url\": \"https://api.github.com/users/vincentkoc\",\n          \"html_url\": \"https://github.com/vincentkoc\",\n          \"followers_url\": \"https://api.github.com/users/vincentkoc/followers\",\n          \"following_url\": \"https://api.github.com/users/vincentkoc/following{/other_user}\",\n          \"gists_url\": \"https://api.github.com/users/vincentkoc/gists{/gist_id}\",\n          \"starred_url\": \"https://api.github.com/users/vincentkoc/starred{/owner}{/repo}\",\n          \"subscriptions_url\": \"https://api.github.com/users/vincentkoc/subscriptions\",\n          \"organizations_url\": \"https://api.github.com/users/vincentkoc/orgs\",\n          \"repos_url\": \"https://api.github.com/users/vincentkoc/repos\",\n          \"events_url\": \"https://api.github.com/users/vincentkoc/events{/privacy}\",\n          \"received_events_url\": \"https://api.github.com/users/vincentkoc/received_events\",\n          \"type\": \"User\",\n          \"user_view_type\": \"public\",\n          \"site_admin\": false\n        }\n      ],\n      \"milestone\": null,\n      \"comments\": 1,\n      \"created_at\": \"2026-04-01T13:53:27Z\",\n      \"updated_at\": \"2026-04-01T14:01:46Z\",\n      \"closed_at\": null,\n      \"assignee\": {\n        \"login\": \"vincentkoc\",\n        \"id\": 25068,\n        \"node_id\": \"MDQ6VXNlcjI1MDY4\",\n        \"avatar_url\": \"https://avatars.githubusercontent.com/u/25068?v=4\",\n        \"gravatar_id\": \"\",\n        \"url\": \"https://api.github.com/users/vincentkoc\",\n        \"html_url\": \"https://github.com/vincentkoc\",\n        \"followers_url\": \"https://api.github.com/users/vincentkoc/followers\",\n        \"following_url\": \"https://api.github.com/users/vincentkoc/following{/other_user}\",\n        \"gists_url\": \"https://api.github.com/users/vincentkoc/gists{/gist_id}\",\n        \"starred_url\": \"https://api.github.com/users/vincentkoc/starred{/owner}{/repo}\",\n        \"subscriptions_url\": \"https://api.github.com/users/vincentkoc/subscriptions\",\n        \"organizations_url\": \"https://api.github.com/users/vincentkoc/orgs\",\n        \"repos_url\": \"https://api.github.com/users/vincentkoc/repos\",\n        \"events_url\": \"https://api.github.com/users/vincentkoc/events{/privacy}\",\n        \"received_events_url\": \"https://api.github.com/users/vincentkoc/received_events\",\n        \"type\": \"User\",\n        \"user_view_type\": \"public\",\n        \"site_admin\": false\n      },\n      \"author_association\": \"MEMBER\",\n      \"issue_field_values\": [],\n      \"type\": null,\n      \"active_lock_reason\": null,\n      \"draft\": false,\n      \"pull_request\": {\n        \"url\": \"https://api.github.com/repos/openclaw/openclaw/pulls/59049\",\n        \"html_url\": \"https://github.com/openclaw/openclaw/pull/59049\",\n        \"diff_url\": \"https://github.com/openclaw/openclaw/pull/59049.diff\",\n        \"patch_url\": \"https://github.com/openclaw/openclaw/pull/59049.patch\",\n        \"merged_at\": null\n      },\n      \"body\": \"## Summary\\n\\n- Problem: custom providers using the `anthropic-messages` API never honored explicit `cacheRetention` settings because retention was gated on provider id instead of model API.\\n- Why it matters: Anthropic-compatible proxy/custom-provider users pay full prompt cost and lose cache behavior even when they explicitly configure retention.\\n- What changed: thread `model.api` into cache-retention resolution and allow explicit retention for custom `anthropic-messages` providers; add targeted regression tests.\\n- What did NOT change (scope boundary): direct Anthropic defaults stay the same, Bedrock behavior stays the same, and custom providers still do not get implicit caching unless they opt in.\\n\\n## Change Type (select all)\\n\\n- [x] Bug fix\\n- [ ] Feature\\n- [ ] Refactor required for the fix\\n- [ ] Docs\\n- [ ] Security hardening\\n- [ ] Chore/infra\\n\\n## Scope (select all touched areas)\\n\\n- [ ] Gateway / orchestration\\n- [ ] Skills / tool execution\\n- [ ] Auth / tokens\\n- [ ] Memory / storage\\n- [x] Integrations\\n- [ ] API / contracts\\n- [x] UI / DX\\n- [ ] CI/CD / infra\\n\\n## Linked Issue/PR\\n\\n- Closes #37325\\n- Closes #37733\\n- Related #37418\\n- [x] This PR fixes a bug or regression\\n\\n## Root Cause / Regression History (if applicable)\\n\\n- Root cause: `resolveCacheRetention` keyed behavior off provider id and treated only direct Anthropic or Anthropic Bedrock as cache-capable paths.\\n- Missing detection / guardrail: there was no test covering a custom provider with `model.api === \\\"anthropic-messages\\\"` plus explicit retention config.\\n- Prior context (`git blame`, prior PR, issue, or refactor if known): user reports in #37325 and #37733 plus prior attempt in #58756.\\n- Why this regressed now: custom provider support grew around provider plumbing, but retention logic stayed tied to vendor ids.\\n- If unknown, what was ruled out: N/A.\\n\\n## Regression Test Plan (if applicable)\\n\\n- Coverage level that should have caught this:\\n  - [x] Unit test\\n  - [ ] Seam / integration test\\n  - [ ] End-to-end test\\n  - [ ] Existing coverage already sufficient\\n- Target test or file: `src/agents/pi-embedded-runner/extra-params.cache-retention-default.test.ts`\\n- Scenario the test should lock in: explicit `cacheRetention` is passed through for custom providers using `anthropic-messages`, while the no-config default remains disabled.\\n- Why this is the smallest reliable guardrail: the regression lives entirely in pre-stream extra-param resolution.\\n- Existing test that already covers this (if any): existing direct Anthropic and Bedrock coverage in the same file.\\n- If no new test is added, why not: N/A.\\n\\n## User-visible / Behavior Changes\\n\\nCustom providers using `anthropic-messages` now honor explicit `cacheRetention` values. No behavior change for direct Anthropic or Bedrock users.\\n\\n## Diagram (if applicable)\\n\\n```text\\nBefore:\\ncustom anthropic-messages provider + cacheRetention=long -> provider-id gate fails -> no cache retention sent\\n\\nAfter:\\ncustom anthropic-messages provider + cacheRetention=long -> model-api gate passes -> cache retention sent\\n```\\n\\n## Security Impact (required)\\n\\n- New permissions/capabilities? (`No`)\\n- Secrets/tokens handling changed? (`No`)\\n- New/changed network calls? (`No`)\\n- Command/tool execution surface changed? (`No`)\\n- Data access scope changed? (`No`)\\n- If any `Yes`, explain risk + mitigation: N/A\\n\\n## Repro + Verification\\n\\n### Environment\\n\\n- OS: macOS\\n- Runtime/container: Node 22 / pnpm\\n- Model/provider: custom provider with `anthropic-messages`\\n- Integration/channel (if any): N/A\\n- Relevant config (redacted): provider configured with explicit `cacheRetention`\\n\\n### Steps\\n\\n1. Configure a custom provider whose model reports `api: \\\"anthropic-messages\\\"`.\\n2. Set explicit `cacheRetention` in effective extra params.\\n3. Run the stream path through pre-plugin wrappers.\\n\\n### Expected\\n\\n- Explicit cache retention is preserved for the request.\\n\\n### Actual\\n\\n- Before this change, cache retention was dropped for custom providers.\\n\\n## Evidence\\n\\nAttach at least one:\\n\\n- [x] Failing test/log before + passing after\\n- [ ] Trace/log snippets\\n- [ ] Screenshot/recording\\n- [ ] Perf numbers (if relevant)\\n\\n## Human Verification (required)\\n\\n- Verified scenarios: custom `anthropic-messages` provider with explicit `short` and `long` retention; custom provider without explicit config stays unset.\\n- Edge cases checked: direct Anthropic default path still uses short retention; explicit direct-Anthropic none/short/long behavior still covered.\\n- What you did **not** verify: live provider round-trip against an external Anthropic-compatible proxy.\\n\\n## Review Conversations\\n\\n- [x] I replied to or resolved every bot review conversation I addressed in this PR.\\n- [x] I left unresolved only the conversations that still need reviewer or maintainer judgment.\\n\\nIf a bot review conversation is addressed by this PR, resolve that conversation yourself. Do not leave bot review conversation cleanup for maintainers.\\n\\n## Compatibility / Migration\\n\\n- Backward compatible? (`Yes`)\\n- Config/env changes? (`No`)\\n- Migration needed? (`No`)\\n- If yes, exact upgrade steps: N/A\\n\\n## Risks and Mitigations\\n\\n- Risk: a custom provider may advertise `anthropic-messages` but reject Anthropic cache fields.\\n  - Mitigation: custom providers only get retention when explicitly configured; there is no new implicit default for them.\\n\",\n      \"reactions\": {\n        \"url\": \"https://api.github.com/repos/openclaw/openclaw/issues/59049/reactions\",\n        \"total_count\": 2,\n        \"+1\": 0,\n        \"-1\": 0,\n        \"laugh\": 0,\n        \"hooray\": 0,\n        \"confused\": 0,\n        \"heart\": 0,\n        \"rocket\": 0,\n        \"eyes\": 2\n      },\n      \"timeline_url\": \"https://api.github.com/repos/openclaw/openclaw/issues/59049/timeline\",\n      \"performed_via_github_app\": null,\n      \"state_reason\": null,\n      \"score\": 1\n    },\n    {\n      \"url\": \"https://api.github.com/repos/openclaw/openclaw/issues/39738\",\n      \"repository_url\": \"https://api.github.com/repos/openclaw/openclaw\",\n      \"labels_url\": \"https://api.github.com/repos/openclaw/openclaw/issues/39738/labels{/name}\",\n      \"comments_url\": \"https://api.github.com/repos/openclaw/openclaw/issues/39738/comments\",\n      \"events_url\": \"https://api.github.com/repos/openclaw/openclaw/issues/39738/events\",\n      \"html_url\": \"https://github.com/openclaw/openclaw/pull/39738\",\n \n<<<END_EXTERNAL_UNTRUSTED_CONTENT id=\"53d5ebec132efdb6\">>>"},"isError":false,"timestamp":1775052119107}}
