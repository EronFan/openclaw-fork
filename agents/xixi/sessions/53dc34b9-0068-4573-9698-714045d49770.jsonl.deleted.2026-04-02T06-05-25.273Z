swer\\\"}\"\n            }\n          ],\n          \"api\": \"openai-codex-responses\",\n          \"provider\": \"openai-codex\",\n          \"model\": \"gpt-5.4\",\n          \"usage\": {\n            \"input\": 21252,\n            \"output\": 120,\n            \"totalTokens\": 21372,\n            \"cacheRead\": 0,\n            \"cacheWrite\": 0,\n            \"cost\": {\n              \"total\": 0.05493000000000001\n            }\n          },\n          \"stopReason\": \"stop\",\n          \"timestamp\": 1775050539291,\n          \"responseId\": \"resp_01a434953558a0b60169cd1f2bc1d48191aeffd34e915628a0\",\n          \"__openclaw\": {\n            \"id\": \"998b17a2\",\n            \"seq\": 10\n          }\n        }\n      ]\n    },\n    {\n      \"key\": \"agent:main:subagent:09a6aab0-3aec-4e9c-88a8-bbb9f22926c7\",\n      \"kind\": \"other\",\n      \"channel\": \"feishu\",\n      \"spawnedBy\": \"agent:main:feishu:group:oc_f68e4447ecaeb604046c3d8ef84681f3\",\n      \"label\": \"aoao-p0-p1-batch2-glm5\",\n      \"displayName\": \"feishu:g-oc_f68e4447ecaeb604046c3d8ef84681f3\",\n      \"parentSessionKey\": \"agent:main:feishu:group:oc_f68e4447ecaeb604046c3d8ef84681f3\",\n      \"deliveryContext\": {\n        \"channel\": \"feishu\"\n      },\n      \"updatedAt\": 1775040914704,\n      \"sessionId\": \"2300a29c-7ef1-4a40-89b4-4bcbb56e263d\",\n      \"model\": \"GLM-5.1\",\n      \"contextTokens\": 200000,\n      \"totalTokens\": 5576460,\n      \"estimatedCostUsd\": 0,\n      \"status\": \"done\",\n      \"startedAt\": 1775039987084,\n      \"endedAt\": 1775040903062,\n      \"runtimeMs\": 914055,\n      \"abortedLastRun\": false,\n      \"lastChannel\": \"feishu\",\n      \"transcriptPath\": \"/root/.openclaw/agents/main/sessions/2300a29c-7ef1-4a40-89b4-4bcbb56e263d.jsonl\",\n      \"messages\": [\n        {\n          \"role\": \"assistant\",\n          \"content\": [\n            {\n              \"type\": \"text\",\n              \"text\": \"Exec denied (gat