3.2`**\n2. 保持当前主默认模型还是 `gpt-5.4`，但说明 **今后新建 isolated cron 时要显式带 `--model siliconflow/deepseek-ai/DeepSeek-V3.2`**；否则它不会自动走便宜模型。","textSignature":"{\"v\":1,\"id\":\"msg_06eb29bac2029a2b0169b567a5ac2881919329c8fd50302be6\",\"phase\":\"commentary\"}"},{"type":"toolCall","id":"call_KYXHGgGC5zAN4bq4nfma48ww|fc_06eb29bac2029a2b0169b567a731c48191ac4a40d3c9c8e5f0","name":"edit","arguments":{"file_path":"/root/.openclaw/openclaw.json","old_string":"      \"models\": {\n        \"openai-codex/gpt-5.4\": {},\n        \"siliconflow/Pro/moonshotai/Kimi-K2.5\": {},\n        \"siliconflow/Pro/MiniMaxAI/MiniMax-M2.5\": {},\n        \"siliconflow/Pro/zai-org/GLM-5\": {},\n        \"siliconflow/Pro/zai-org/GLM-4.7\": {},\n        \"siliconflow/Qwen/Qwen3.5-397B-A17B\": {},\n        \"siliconflow/deepseek-ai/DeepSeek-V3.2\": {}\n      },","new_string":"      \"models\": {\n        \"openai-codex/gpt-5.4\": {},\n        \"siliconflow/Pro/moonshotai/Kimi-K2.5\": {},\n        \"siliconflow/Pro/MiniMaxAI/MiniMax-M2.5\": {},\n        \"siliconflow/Pro/zai-org/GLM-5\": {},\n        \"siliconflow/Pro/zai-org/GLM-4.7\": {},\n        \"siliconflow/Qwen/Qwen3.5-397B-A17B\": {},\n        \"siliconflow/deepseek-ai/DeepSeek-V3.2\": {}\n      },\n      \"heartbeat\": {\n        \"model\": \"siliconflow/deepseek-ai/DeepSeek-V3.2\"\n      },"},"partialJson":"{\"file_path\":\"/root/.openclaw/openclaw.json\",\"old_string\":\"      \\\"models\\\": {\\n        \\\"openai-codex/gpt-5.4\\\": {},\\n        \\\"siliconflow/Pro/moonshotai/Kimi-K2.5\\\": {},\\n        \\\"siliconflow/Pro/MiniMaxAI/MiniMax-M2.5\\\": {},\\n        \\\"siliconflow/Pro/zai-org/GLM-5\\\": {},\\n        \\\"siliconflow/Pro/zai-org/GLM-4.7\\\": {},\\n        \\\"siliconflow/Qwen/Qwen3.5-397B-A17B\\\": {},\\n        \\\"siliconflow/deepseek-ai/DeepSeek-V3.2\\\": {}\\n      },\",\"new_string\":\"      \\\"models\\\": {\\n        \\\"openai-codex/gpt-5.4\\\": {},\\n        \\\"siliconflow/Pro/moonshotai/Kimi-K2.5\\\": {},\\n        \\\"