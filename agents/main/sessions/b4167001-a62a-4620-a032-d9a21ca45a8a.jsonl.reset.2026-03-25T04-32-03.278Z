{"type":"message","id":"0b19c276","parentId":"7b5b42a9","timestamp":"2026-03-24T05:58:36.880Z","message":{"role":"toolResult","toolCallId":"call_rxaNcImQtXgLYDwesraZOSnj|fc_050a45ec585c4d650169c2280bf8348191b43e800edada2338","toolName":"read","content":[{"type":"text","text":"import { defineChannelPluginEntry } from \"openclaw/plugin-sdk/core\";\nimport { registerFeishuBitableTools } from \"./src/bitable.js\";\nimport { feishuPlugin } from \"./src/channel.js\";\nimport { registerFeishuChatTools } from \"./src/chat.js\";\nimport { registerFeishuDocTools } from \"./src/docx.js\";\nimport { registerFeishuDriveTools } from \"./src/drive.js\";\nimport { registerFeishuPermTools } from \"./src/perm.js\";\nimport { setFeishuRuntime } from \"./src/runtime.js\";\nimport { registerFeishuSubagentHooks } from \"./src/subagent-hooks.js\";\nimport { registerFeishuWikiTools } from \"./src/wiki.js\";\n\nexport { feishuPlugin } from \"./src/channel.js\";\nexport { setFeishuRuntime } from \"./src/runtime.js\";\nexport { monitorFeishuProvider } from \"./src/monitor.js\";\nexport {\n  sendMessageFeishu,\n  sendCardFeishu,\n  updateCardFeishu,\n  editMessageFeishu,\n  getMessageFeishu,\n} from \"./src/send.js\";\nexport {\n  uploadImageFeishu,\n  uploadFileFeishu,\n  sendImageFeishu,\n  sendFileFeishu,\n  sendMediaFeishu,\n} from \"./src/media.js\";\nexport { probeFeishu } from \"./src/probe.js\";\nexport {\n  addReactionFeishu,\n  removeReactionFeishu,\n  listReactionsFeishu,\n  FeishuEmoji,\n} from \"./src/reactions.js\";\nexport {\n  extractMentionTargets,\n  extractMessageBody,\n  isMentionForwardRequest,\n  formatMentionForText,\n  formatMentionForCard,\n  formatMentionAllForText,\n  formatMentionAllForCard,\n  buildMentionedMessage,\n  buildMentionedCardContent,\n  type MentionTarget,\n} from \"./src/mention.js\";\n\nexport default defineChannelPluginEntry({\n  id: \"feishu\",\n  name: \"Feishu\",\n  description: \"Feishu/Lark channel plugin\",\n  plugin: feishuPlugin,\n  setRuntime: setFeishuRuntime,\n  registerFull(api) {\n    registerFeishuSubagentHooks(api);\n    registerFeishuDocTools(api);\n    registerFeishuChatTools(api);\n    registerFeishuWikiTools(api);\n    registerFeishuDriveTools(api);\n    registerFeishuPermTools(api);\n    registerFeishuBitableTools(api);\n  },\n});\n"}],"isError":false,"timestamp":1774331916871}}
{"type":"message","id":"32d74f97","parentId":"0b19c276","timestamp":"2026-03-24T05:58:39.815Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_TheSBN7mIJI6S8ZrO0g8qJMz|fc_050a45ec585c4d650169c2280eddc0819181ec347159b93a8a","name":"read","arguments":{"path":"/root/.openclaw/workspace/projects/openclaw-pr/src/agents/skills/plugin-skills.ts","offset":1,"limit":260},"partialJson":"{\"path\":\"/root/.openclaw/workspace/projects/openclaw-pr/src/agents/skills/plugin-skills.ts\",\"offset\":1,\"limit\":260}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":640,"output":46,"cacheRead":46080,"cacheWrite":0,"totalTokens":46766,"cost":{"input":0.0016,"output":0.00069,"cacheRead":0.011519999999999999,"cacheWrite":0,"total":0.01381}},"stopReason":"toolUse","timestamp":1774331916877}}
{"type":"message","id":"871cf22f","parentId":"32d74f97","timestamp":"2026-03-24T05:58:39.831Z","message":{"role":"toolResult","toolCallId":"call_TheSBN7mIJI6S8ZrO0g8qJMz|fc_050a45ec585c4d650169c2280eddc0819181ec347159b93a8a","toolName":"read","content":[{"type":"text","text":"import fs from \"node:fs\";\nimport path from \"node:path\";\nimport type { OpenClawConfig } from \"../../config/config.js\";\nimport { createSubsystemLogger } from \"../../logging/subsystem.js\";\nimport {\n  normalizePluginsConfig,\n  resolveEffectiveEnableState,\n  resolveMemorySlotDecision,\n} from \"../../plugins/config-state.js\";\nimport { loadPluginManifestRegistry } from \"../../plugins/manifest-registry.js\";\nimport { isPathInsideWithRealpath } from \"../../security/scan-paths.js\";\n\nconst log = createSubsystemLogger(\"skills\");\n\nexport function resolvePluginSkillDirs(params: {\n  workspaceDir: string | undefined;\n  config?: OpenClawConfig;\n}): string[] {\n  const workspaceDir = (params.workspaceDir ?? \"\").trim();\n  if (!workspaceDir) {\n    return [];\n  }\n  const registry = loadPluginManifestRegistry({\n    workspaceDir,\n    config: params.config,\n  });\n  if (registry.plugins.length === 0) {\n    return [];\n  }\n  const normalizedPlugins = normalizePluginsConfig(params.config?.plugins);\n  const acpEnabled = params.config?.acp?.enabled !== false;\n  const memorySlot = normalizedPlugins.slots.memory;\n  let selectedMemoryPluginId: string | null = null;\n  const seen = new Set<string>();\n  const resolved: string[] = [];\n\n  for (const record of registry.plugins) {\n    if (!record.skills || record.skills.length === 0) {\n      continue;\n    }\n    const enableState = resolveEffectiveEnableState({\n      id: record.id,\n      origin: record.origin,\n      config: normalizedPlugins,\n      rootConfig: params.config,\n    });\n    if (!enableState.enabled) {\n      continue;\n    }\n    // ACP router skills should not be attached when ACP is explicitly disabled.\n    if (!acpEnabled && record.id === \"acpx\") {\n      continue;\n    }\n    const memoryDecision = resolveMemorySlotDecision({\n      id: record.id,\n      kind: record.kind,\n      slot: memorySlot,\n      selectedId: selectedMemoryPluginId,\n    });\n    if (!memoryDecision.enabled) {\n      continue;\n    }\n    if (memoryDecision.selected && record.kind === \"memory\") {\n      selectedMemoryPluginId = record.id;\n    }\n    for (const raw of record.skills) {\n      const trimmed = raw.trim();\n      if (!trimmed) {\n        continue;\n      }\n      const candidate = path.resolve(record.rootDir, trimmed);\n      if (!fs.existsSync(candidate)) {\n        log.warn(`plugin skill path not found (${record.id}): ${candidate}`);\n        continue;\n      }\n      if (!isPathInsideWithRealpath(record.rootDir, candidate, { requireRealpath: true })) {\n        log.warn(`plugin skill path escapes plugin root (${record.id}): ${candidate}`);\n        continue;\n      }\n      if (seen.has(candidate)) {\n        continue;\n      }\n      seen.add(candidate);\n      resolved.push(candidate);\n    }\n  }\n\n  return resolved;\n}\n"}],"isError":false,"timestamp":1774331919822}}
{"type":"message","id":"5a759895","parentId":"871cf22f","timestamp":"2026-03-24T05:58:44.530Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_66gxCaw8Jr3I4pPaBRBUYVN0|fc_050a45ec585c4d650169c228139ac881919a28bfacfe4845d1","name":"read","arguments":{"path":"/root/.openclaw/workspace/projects/openclaw-pr/src/plugins/manifest.ts","offset":1,"limit":220},"partialJson":"{\"path\":\"/root/.openclaw/workspace/projects/openclaw-pr/src/plugins/manifest.ts\",\"offset\":1,\"limit\":220}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":798,"output":42,"cacheRead":46592,"cacheWrite":0,"totalTokens":47432,"cost":{"input":0.0019950000000000002,"output":0.00063,"cacheRead":0.011647999999999999,"cacheWrite":0,"total":0.014273}},"stopReason":"toolUse","timestamp":1774331919828}}
{"type":"message","id":"2ea1075a","parentId":"5a759895","timestamp":"2026-03-24T05:58:44.545Z","message":{"role":"toolResult","toolCallId":"call_66gxCaw8Jr3I4pPaBRBUYVN0|fc_050a45ec585c4d650169c228139ac881919a28bfacfe4845d1","toolName":"read","content":[{"type":"text","text":"import fs from \"node:fs\";\nimport path from \"node:path\";\nimport { MANIFEST_KEY } from \"../compat/legacy-names.js\";\nimport { matchBoundaryFileOpenFailure, openBoundaryFileSync } from \"../infra/boundary-file-read.js\";\nimport { isRecord } from \"../utils.js\";\nimport type { PluginConfigUiHint, PluginKind } from \"./types.js\";\n\nexport const PLUGIN_MANIFEST_FILENAME = \"openclaw.plugin.json\";\nexport const PLUGIN_MANIFEST_FILENAMES = [PLUGIN_MANIFEST_FILENAME] as const;\n\nexport type PluginManifest = {\n  id: string;\n  configSchema: Record<string, unknown>;\n  enabledByDefault?: boolean;\n  kind?: PluginKind;\n  channels?: string[];\n  providers?: string[];\n  /** Cheap provider-auth env lookup without booting plugin runtime. */\n  providerAuthEnvVars?: Record<string, string[]>;\n  /**\n   * Cheap onboarding/auth-choice metadata used by config validation, CLI help,\n   * and non-runtime auth-choice routing before provider runtime loads.\n   */\n  providerAuthChoices?: PluginManifestProviderAuthChoice[];\n  skills?: string[];\n  name?: string;\n  description?: string;\n  version?: string;\n  uiHints?: Record<string, PluginConfigUiHint>;\n};\n\nexport type PluginManifestProviderAuthChoice = {\n  /** Provider id owned by this manifest entry. */\n  provider: string;\n  /** Provider auth method id that this choice should dispatch to. */\n  method: string;\n  /** Stable auth-choice id used by onboarding and other CLI auth flows. */\n  choiceId: string;\n  /** Optional user-facing choice label/hint for grouped onboarding UI. */\n  choiceLabel?: string;\n  choiceHint?: string;\n  /** Optional grouping metadata for auth-choice pickers. */\n  groupId?: string;\n  groupLabel?: string;\n  groupHint?: string;\n  /** Optional CLI flag metadata for one-flag auth flows such as API keys. */\n  optionKey?: string;\n  cliFlag?: string;\n  cliOption?: string;\n  cliDescription?: string;\n  /**\n   * Interactive onboarding surfaces where this auth choice should appear.\n   * Defaults to `[\"text-inference\"]` when omitted.\n   */\n  onboardingScopes?: PluginManifestOnboardingScope[];\n};\n\nexport type PluginManifestOnboardingScope = \"text-inference\" | \"image-generation\";\n\nexport type PluginManifestLoadResult =\n  | { ok: true; manifest: PluginManifest; manifestPath: string }\n  | { ok: false; error: string; manifestPath: string };\n\nfunction normalizeStringList(value: unknown): string[] {\n  if (!Array.isArray(value)) {\n    return [];\n  }\n  return value.map((entry) => (typeof entry === \"string\" ? entry.trim() : \"\")).filter(Boolean);\n}\n\nfunction normalizeStringListRecord(value: unknown): Record<string, string[]> | undefined {\n  if (!isRecord(value)) {\n    return undefined;\n  }\n  const normalized: Record<string, string[]> = {};\n  for (const [key, rawValues] of Object.entries(value)) {\n    const providerId = typeof key === \"string\" ? key.trim() : \"\";\n    if (!providerId) {\n      continue;\n    }\n    const values = normalizeStringList(rawValues);\n    if (values.length === 0) {\n      continue;\n    }\n    normalized[providerId] = values;\n  }\n  return Object.keys(normalized).length > 0 ? normalized : undefined;\n}\n\nfunction normalizeProviderAuthChoices(\n  value: unknown,\n): PluginManifestProviderAuthChoice[] | undefined {\n  if (!Array.isArray(value)) {\n    return undefined;\n  }\n  const normalized: PluginManifestProviderAuthChoice[] = [];\n  for (const entry of value) {\n    if (!isRecord(entry)) {\n      continue;\n    }\n    const provider = typeof entry.provider === \"string\" ? entry.provider.trim() : \"\";\n    const method = typeof entry.method === \"string\" ? entry.method.trim() : \"\";\n    const choiceId = typeof entry.choiceId === \"string\" ? entry.choiceId.trim() : \"\";\n    if (!provider || !method || !choiceId) {\n      continue;\n    }\n    const choiceLabel = typeof entry.choiceLabel === \"string\" ? entry.choiceLabel.trim() : \"\";\n    const choiceHint = typeof entry.choiceHint === \"string\" ? entry.choiceHint.trim() : \"\";\n    const groupId = typeof entry.groupId === \"string\" ? entry.groupId.trim() : \"\";\n    const groupLabel = typeof entry.groupLabel === \"string\" ? entry.groupLabel.trim() : \"\";\n    const groupHint = typeof entry.groupHint === \"string\" ? entry.groupHint.trim() : \"\";\n    const optionKey = typeof entry.optionKey === \"string\" ? entry.optionKey.trim() : \"\";\n    const cliFlag = typeof entry.cliFlag === \"string\" ? entry.cliFlag.trim() : \"\";\n    const cliOption = typeof entry.cliOption === \"string\" ? entry.cliOption.trim() : \"\";\n    const cliDescription =\n      typeof entry.cliDescription === \"string\" ? entry.cliDescription.trim() : \"\";\n    const onboardingScopes = normalizeStringList(entry.onboardingScopes).filter(\n      (scope): scope is PluginManifestOnboardingScope =>\n        scope === \"text-inference\" || scope === \"image-generation\",\n    );\n    normalized.push({\n      provider,\n      method,\n      choiceId,\n      ...(choiceLabel ? { choiceLabel } : {}),\n      ...(choiceHint ? { choiceHint } : {}),\n      ...(groupId ? { groupId } : {}),\n      ...(groupLabel ? { groupLabel } : {}),\n      ...(groupHint ? { groupHint } : {}),\n      ...(optionKey ? { optionKey } : {}),\n      ...(cliFlag ? { cliFlag } : {}),\n      ...(cliOption ? { cliOption } : {}),\n      ...(cliDescription ? { cliDescription } : {}),\n      ...(onboardingScopes.length > 0 ? { onboardingScopes } : {}),\n    });\n  }\n  return normalized.length > 0 ? normalized : undefined;\n}\n\nexport function resolvePluginManifestPath(rootDir: string): string {\n  for (const filename of PLUGIN_MANIFEST_FILENAMES) {\n    const candidate = path.join(rootDir, filename);\n    if (fs.existsSync(candidate)) {\n      return candidate;\n    }\n  }\n  return path.join(rootDir, PLUGIN_MANIFEST_FILENAME);\n}\n\nexport function loadPluginManifest(\n  rootDir: string,\n  rejectHardlinks = true,\n): PluginManifestLoadResult {\n  const manifestPath = resolvePluginManifestPath(rootDir);\n  const opened = openBoundaryFileSync({\n    absolutePath: manifestPath,\n    rootPath: rootDir,\n    boundaryLabel: \"plugin root\",\n    rejectHardlinks,\n  });\n  if (!opened.ok) {\n    return matchBoundaryFileOpenFailure(opened, {\n      path: () => ({\n        ok: false,\n        error: `plugin manifest not found: ${manifestPath}`,\n        manifestPath,\n      }),\n      fallback: (failure) => ({\n        ok: false,\n        error: `unsafe plugin manifest path: ${manifestPath} (${failure.reason})`,\n        manifestPath,\n      }),\n    });\n  }\n  let raw: unknown;\n  try {\n    raw = JSON.parse(fs.readFileSync(opened.fd, \"utf-8\")) as unknown;\n  } catch (err) {\n    return {\n      ok: false,\n      error: `failed to parse plugin manifest: ${String(err)}`,\n      manifestPath,\n    };\n  } finally {\n    fs.closeSync(opened.fd);\n  }\n  if (!isRecord(raw)) {\n    return { ok: false, error: \"plugin manifest must be an object\", manifestPath };\n  }\n  const id = typeof raw.id === \"string\" ? raw.id.trim() : \"\";\n  if (!id) {\n    return { ok: false, error: \"plugin manifest requires id\", manifestPath };\n  }\n  const configSchema = isRecord(raw.configSchema) ? raw.configSchema : null;\n  if (!configSchema) {\n    return { ok: false, error: \"plugin manifest requires configSchema\", manifestPath };\n  }\n\n  const kind = typeof raw.kind === \"string\" ? (raw.kind as PluginKind) : undefined;\n  const enabledByDefault = raw.enabledByDefault === true;\n  const name = typeof raw.name === \"string\" ? raw.name.trim() : undefined;\n  const description = typeof raw.description === \"string\" ? raw.description.trim() : undefined;\n  const version = typeof raw.version === \"string\" ? raw.version.trim() : undefined;\n  const channels = normalizeStringList(raw.channels);\n  const providers = normalizeStringList(raw.providers);\n  const providerAuthEnvVars = normalizeStringListRecord(raw.providerAuthEnvVars);\n  const providerAuthChoices = normalizeProviderAuthChoices(raw.providerAuthChoices);\n  const skills = normalizeStringList(raw.skills);\n\n  let uiHints: Record<string, PluginConfigUiHint> | undefined;\n  if (isRecord(raw.uiHints)) {\n    uiHints = raw.uiHints as Record<string, PluginConfigUiHint>;\n  }\n\n  return {\n    ok: true,\n    manifest: {\n      id,\n      configSchema,\n      ...(enabledByDefault ? { enabledByDefault } : {}),\n\n[105 more lines in file. Use offset=221 to continue.]"}],"isError":false,"timestamp":1774331924537}}
{"type":"message","id":"55b0c70c","parentId":"2ea1075a","timestamp":"2026-03-24T05:58:50.588Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"**Inspecting plugin skills**\n\nI think I need to check the comments about plugin skills and whether they only involve skill prompts. It seems important to look into the loader and the registration process. I might be duplicating something from the plugin manifest skills and the registerFull method. Actually, it looks like skill documentation is separate from tool registration. I should take a look at issue #52572 to see if there’s a problem with double tool registration related to skill directories. Let’s inspect this more closely!","thinkingSignature":"{\"id\":\"rs_050a45ec585c4d650169c228165f788191be6dafbba610aa43\",\"type\":\"reasoning\",\"encrypted_content\":\"gAAAAABpwiga83TNDEFhpJ0zBm1VkrWnwgQ6KJJ-VJwDlisxDdRPl2v71aDkML3fU8Z53gCfkD9rmesGGjfn0lkhq-56k-LiCI_Mnx0nO16ZqRmTGu8kvHWzAKLMCIVHPD5QjyFNp0NpJs8k7K0Aby0_MdQBKFG8hGifLJU0Gx6NIqYy7RIhG8XFEg-xmlfBCOFwC7kDq_ot60AcmZvNJrQ_4Eqylu7qEVEZqS2AdQAtXY3Bd7KbTjxw4ygGwrPBN0b0okiZWWRja8N6s2dFs-CnqQhDrT_9xmL4-Ex0QAHtX_bUDqiPG3i65PYW4Iv4S2xsf9mbGvSj4QqwG76HdPzR-325v_JT2gDWc_MiFDHTX4GC9QIiN7Dz7uGxX0eTlPZWyTW5m_BxbR7NE8EMOCWxfIjbSXfXgDI9AzmbPAIR5tE1a7nQe07oEVIEvVdGq4nHgVeubMGtx8H7hj9tMstQTSwRYUTfdiApy0dn6po1XXv76TcOSENvfnJHl7bSsVNotvJR5XabhXV-6l2hbmjIIpRFilk5EOeRwmI5XbwVBJrclJvPWhgk4t5xw0C-eRFkVJeT1i0hglA66xRdQfOOi_okk2GdxtsbfHaoBo17e4rItab2IO1ec045R88KqiA74bWNaKVwKSrMY5AV4rdt1YYxspc8NLuff927O9VLsNOi1k8ps3i3rGWHnTsaJR4tfeEZAnQZ9_d4uYJLrA592nTX9cbhNZ2eQBsk1dpF75VA9UJ7ZcFVfcl0RUoZJoJXFq_lbrTnsVTKBIIj-SjvP7zyZ6hBX0h3FUJqQYW3fNHCia0tseij8xqffdXyPv_V8LtdogoExpkIHdUQ7nqroZPCK0c_xq0sbnYAiIq7mWs3mEvh9N-RwAM2p7c3IPy4ywuBbhOn_rjpTuffnQTTxiKg-qW-XWw4sf7GEbrIPGs41RIdJmH6yrAo4RcrdVY7O2l8i6iDYcPDEB01TeD_ngMMdeReEG7Eq-RKKwao2ftfbpfzmAJ-JFjq0APr8JlZBLbjPxDMD3InfCA7Mb7xctDy3D9OrtBxePdGtR-OQMRQKUeOxegjwcROMySuvRcUpcJrPEGRDJ0BH12Au9Va9m15yP6WBQbvcFnxXs57jQMMIVaqhNw9up-64d46WOWgPzRf0XBAzgs09n0wfsgrOkjXKYhEou03EJfMkRn2ExrWWA2HR-4l1TLoDFWSmy-N625j5h2AlvrQthislJt_iAd9HFQwxZ4x-QK1GcPIBnKzyAE8vni1ZpgZra7JiMDJTrT04Rgj\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Inspecting plugin skills**\\n\\nI think I need to check the comments about plugin skills and whether they only involve skill prompts. It seems important to look into the loader and the registration process. I might be duplicating something from the plugin manifest skills and the registerFull method. Actually, it looks like skill documentation is separate from tool registration. I should take a look at issue #52572 to see if there’s a problem with double tool registration related to skill directories. Let’s inspect this more closely!\"}]}"},{"type":"toolCall","id":"call_ufRZ5P0NMmTnOzbgzZ3dKgwH|fc_050a45ec585c4d650169c2281a492c8191b9617c88e84e4f45","name":"exec","arguments":{"command":"gh issue view 52572 --repo openclaw/openclaw --json number,title,body,url,comments","workdir":"/root/.openclaw/workspace","yieldMs":10000,"timeout":30},"partialJson":"{\"command\":\"gh issue view 52572 --repo openclaw/openclaw --json number,title,body,url,comments\",\"workdir\":\"/root/.openclaw/workspace\",\"yieldMs\":10000,\"timeout\":30}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":2127,"output":130,"cacheRead":47232,"cacheWrite":0,"totalTokens":49489,"cost":{"input":0.0053175,"output":0.0019500000000000001,"cacheRead":0.011807999999999999,"cacheWrite":0,"total":0.0190755}},"stopReason":"toolUse","timestamp":1774331924542}}
{"type":"message","id":"678632d7","parentId":"55b0c70c","timestamp":"2026-03-24T05:58:51.572Z","message":{"role":"toolResult","toolCallId":"call_ufRZ5P0NMmTnOzbgzZ3dKgwH|fc_050a45ec585c4d650169c2281a492c8191b9617c88e84e4f45","toolName":"exec","content":[{"type":"text","text":"{\"body\":\"### Bug type\\n\\nBehavior bug (incorrect output/state without crash)\\n\\n### Summary\\n\\n**Feishu plugin registers all tools twice**\\n\\nRunning `openclaw status --verbose` on v2026.3.13 (61d171a) shows every Feishu sub-plugin (feishu_doc, feishu_chat, feishu_wiki, feishu_drive, feishu_bitable) registered twice.\\n\\n**Root cause**\\n\\nThe feishu extension has two overlapping registration paths that both fire:\\n\\n1. `openclaw.plugin.json` declares `\\\"skills\\\": [\\\"./skills\\\"]`, which triggers declarative auto-registration of all tools in the `skills/` directory.\\n2. `index.ts` exports a `register()` function that programmatically calls `registerFeishuDocTools()`, `registerFeishuChatTools()`, etc.\\n\\nBoth paths run during plugin load, resulting in duplicate registration.\\n\\n**Expected behavior**\\n\\nEach tool should be registered exactly once.\\n\\n**Suggested fix**\\n\\nRemove the `\\\"skills\\\"` field from `extensions/feishu/openclaw.plugin.json` and let `register()` in `index.ts` be the sole registration entry point (it also handles `setFeishuRuntime` and `registerChannel`).\\n\\nAlternatively, remove the manual `registerXxxTools()` calls from `register()` and rely on the declarative `skills` loading — but that would require moving the runtime/channel init elsewhere.\\n\\n**Repro**\\n\\n```\\nopenclaw status --verbose\\n```\\n\\n**Environment**\\n\\n- OpenClaw 2026.3.13 (61d171a)\\n- macOS 15.7.4\\n\\n### Steps to reproduce\\n\\n[09:52:24] [~/.openclaw] ❱❱❱ openclaw status --verbose\\n\\n### Expected behavior\\n\\n[09:52:24] [~/.openclaw] ❱❱❱ openclaw status --verbose\\n\\n🦞 OpenClaw 2026.3.13 (61d171a) — I'm not saying your workflow is chaotic... I'm just bringing a linter and a helmet.\\n\\n09:52:28 [plugins] feishu_doc: Registered feishu_doc, feishu_app_scopes\\n09:52:28 [plugins] feishu_chat: Registered feishu_chat tool\\n09:52:28 [plugins] feishu_wiki: Registered feishu_wiki tool\\n09:52:28 [plugins] feishu_drive: Registered feishu_drive tool\\n09:52:28 [plugins] feishu_bitable: Registered bitable tools\\n\\n### Actual behavior\\n\\n[09:52:24] [~/.openclaw] ❱❱❱ openclaw status --verbose\\n\\n🦞 OpenClaw 2026.3.13 (61d171a) — I'm not saying your workflow is chaotic... I'm just bringing a linter and a helmet.\\n\\n09:52:28 [plugins] feishu_doc: Registered feishu_doc, feishu_app_scopes\\n09:52:28 [plugins] feishu_chat: Registered feishu_chat tool\\n09:52:28 [plugins] feishu_wiki: Registered feishu_wiki tool\\n09:52:28 [plugins] feishu_drive: Registered feishu_drive tool\\n09:52:28 [plugins] feishu_bitable: Registered bitable tools\\n\\n09:52:28 [plugins] feishu_doc: Registered feishu_doc, feishu_app_scopes\\n09:52:28 [plugins] feishu_chat: Registered feishu_chat tool\\n09:52:28 [plugins] feishu_wiki: Registered feishu_wiki tool\\n09:52:28 [plugins] feishu_drive: Registered feishu_drive tool\\n09:52:28 [plugins] feishu_bitable: Registered bitable tools\\n\\n### OpenClaw version\\n\\n2026.3.13\\n\\n### Operating system\\n\\nmacOS 15.7.4\\n\\n### Install method\\n\\n_No response_\\n\\n### Model\\n\\nanthropic/claude-opus-4-6\\n\\n### Provider / routing chain\\n\\nanthropic\\n\\n### Additional provider/model setup details\\n\\n_No response_\\n\\n### Logs, screenshots, and evidence\\n\\n```shell\\n\\n```\\n\\n### Impact and severity\\n\\n_No response_\\n\\n### Additional information\\n\\n_No response_\",\"comments\":[{\"id\":\"IC_kwDOQb6kR8701J7_\",\"author\":{\"login\":\"Hollychou924\"},\"authorAssociation\":\"NONE\",\"body\":\"## Analysis: Feishu plugin dual registration — root cause and fix\\n\\nThe reporter's analysis is correct. There are two overlapping registration paths that both fire during plugin load.\\n\\n### Root cause\\n\\nThe plugin has two registration mechanisms that both execute:\\n\\n1. **Declarative path**: `openclaw.plugin.json` declares `\\\"skills\\\": [\\\"./skills\\\"]`, which triggers auto-registration of all tools in the `skills/` directory via the plugin loader\\n2. **Programmatic path**: `index.ts` exports a `register()` function that explicitly calls `registerFeishuDocTools()`, `registerFeishuChatTools()`, etc.\\n\\nBoth run independently during plugin initialization, resulting in every tool registered twice.\\n\\n### Why this matters beyond the log noise\\n\\nDuplicate registration isn't just cosmetic:\\n- If the registry doesn't deduplicate on tool name, the LLM sees two definitions of the same tool → unpredictable behavior\\n- If it does deduplicate (last-write-wins), the second registration may overwrite the first with a different runtime binding, potentially causing silent failures\\n- Double memory allocation for tool definitions\\n\\n### Fix\\n\\nThe cleanest fix is to **remove the `\\\"skills\\\"` field from `openclaw.plugin.json`** and keep the programmatic `register()` as the sole entry point. This is the right call because:\\n- `register()` also handles `setFeishuRuntime()` and `registerChannel()` — you can't remove it\\n- The `skills` declarative path doesn't know about these side effects\\n\\n```diff\\n// extensions/feishu/openclaw.plugin.json\\n{\\n  \\\"name\\\": \\\"feishu\\\",\\n-  \\\"skills\\\": [\\\"./skills\\\"],\\n  \\\"register\\\": \\\"./dist/index.js\\\"\\n}\\n```\\n\\nAlternative: if the `skills` declarative path is required for other reasons, add a registration guard in `register()`:\\n\\n```ts\\n// index.ts\\nlet registered = false;\\nexport function register(runtime: FeishuRuntime) {\\n  if (registered) return;  // Guard against double-registration\\n  registered = true;\\n  setFeishuRuntime(runtime);\\n  registerFeishuDocTools();\\n  registerFeishuChatTools();\\n  // ...\\n}\\n```\\n\\nThe idempotency guard is a good defensive measure regardless, in case other plugin loading paths could trigger double-registration.\",\"createdAt\":\"2026-03-23T02:21:28Z\",\"includesCreatedEdit\":false,\"isMinimized\":false,\"minimizedReason\":\"\",\"reactionGroups\":[],\"url\":\"https://github.com/openclaw/openclaw/issues/52572#issuecomment-4107575039\",\"viewerDidAuthor\":false}],\"number\":52572,\"title\":\"[Bug]: **Feishu plugin registers all tools twice**\",\"url\":\"https://github.com/openclaw/openclaw/issues/52572\"}"}],"details":{"status":"completed","exitCode":0,"durationMs":973,"aggregated":"{\"body\":\"### Bug type\\n\\nBehavior bug (incorrect output/state without crash)\\n\\n### Summary\\n\\n**Feishu plugin registers all tools twice**\\n\\nRunning `openclaw status --verbose` on v2026.3.13 (61d171a) shows every Feishu sub-plugin (feishu_doc, feishu_chat, feishu_wiki, feishu_drive, feishu_bitable) registered twice.\\n\\n**Root cause**\\n\\nThe feishu extension has two overlapping registration paths that both fire:\\n\\n1. `openclaw.plugin.json` declares `\\\"skills\\\": [\\\"./skills\\\"]`, which triggers declarative auto-registration of all tools in the `skills/` directory.\\n2. `index.ts` exports a `register()` function that programmatically calls `registerFeishuDocTools()`, `registerFeishuChatTools()`, etc.\\n\\nBoth paths run during plugin load, resulting in duplicate registration.\\n\\n**Expected behavior**\\n\\nEach tool should be registered exactly once.\\n\\n**Suggested fix**\\n\\nRemove the `\\\"skills\\\"` field from `extensions/feishu/openclaw.plugin.json` and let `register()` in `index.ts` be the sole registration entry point (it also handles `setFeishuRuntime` and `registerChannel`).\\n\\nAlternatively, remove the manual `registerXxxTools()` calls from `register()` and rely on the declarative `skills` loading — but that would require moving the runtime/channel init elsewhere.\\n\\n**Repro**\\n\\n```\\nopenclaw status --verbose\\n```\\n\\n**Environment**\\n\\n- OpenClaw 2026.3.13 (61d171a)\\n- macOS 15.7.4\\n\\n### Steps to reproduce\\n\\n[09:52:24] [~/.openclaw] ❱❱❱ openclaw status --verbose\\n\\n### Expected behavior\\n\\n[09:52:24] [~/.openclaw] ❱❱❱ openclaw status --verbose\\n\\n🦞 OpenClaw 2026.3.13 (61d171a) — I'm not saying your workflow is chaotic... I'm just bringing a linter and a helmet.\\n\\n09:52:28 [plugins] feishu_doc: Registered feishu_doc, feishu_app_scopes\\n09:52:28 [plugins] feishu_chat: Registered feishu_chat tool\\n09:52:28 [plugins] feishu_wiki: Registered feishu_wiki tool\\n09:52:28 [plugins] feishu_drive: Registered feishu_drive tool\\n09:52:28 [plugins] feishu_bitable: Registered bitable tools\\n\\n### Actual behavior\\n\\n[09:52:24] [~/.openclaw] ❱❱❱ openclaw status --verbose\\n\\n🦞 OpenClaw 2026.3.13 (61d171a) — I'm not saying your workflow is chaotic... I'm just bringing a linter and a helmet.\\n\\n09:52:28 [plugins] feishu_doc: Registered feishu_doc, feishu_app_scopes\\n09:52:28 [plugins] feishu_chat: Registered feishu_chat tool\\n09:52:28 [plugins] feishu_wiki: Registered feishu_wiki tool\\n09:52:28 [plugins] feishu_drive: Registered feishu_drive tool\\n09:52:28 [plugins] feishu_bitable: Registered bitable tools\\n\\n09:52:28 [plugins] feishu_doc: Registered feishu_doc, feishu_app_scopes\\n09:52:28 [plugins] feishu_chat: Registered feishu_chat tool\\n09:52:28 [plugins] feishu_wiki: Registered feishu_wiki tool\\n09:52:28 [plugins] feishu_drive: Registered feishu_drive tool\\n09:52:28 [plugins] feishu_bitable: Registered bitable tools\\n\\n### OpenClaw version\\n\\n2026.3.13\\n\\n### Operating system\\n\\nmacOS 15.7.4\\n\\n### Install method\\n\\n_No response_\\n\\n### Model\\n\\nanthropic/claude-opus-4-6\\n\\n### Provider / routing chain\\n\\nanthropic\\n\\n### Additional provider/model setup details\\n\\n_No response_\\n\\n### Logs, screenshots, and evidence\\n\\n```shell\\n\\n```\\n\\n### Impact and severity\\n\\n_No response_\\n\\n### Additional information\\n\\n_No response_\",\"comments\":[{\"id\":\"IC_kwDOQb6kR8701J7_\",\"author\":{\"login\":\"Hollychou924\"},\"authorAssociation\":\"NONE\",\"body\":\"## Analysis: Feishu plugin dual registration — root cause and fix\\n\\nThe reporter's analysis is correct. There are two overlapping registration paths that both fire during plugin load.\\n\\n### Root cause\\n\\nThe plugin has two registration mechanisms that both execute:\\n\\n1. **Declarative path**: `openclaw.plugin.json` declares `\\\"skills\\\": [\\\"./skills\\\"]`, which triggers auto-registration of all tools in the `skills/` directory via the plugin loader\\n2. **Programmatic path**: `index.ts` exports a `register()` function that explicitly calls `registerFeishuDocTools()`, `registerFeishuChatTools()`, etc.\\n\\nBoth run independently during plugin initialization, resulting in every tool registered twice.\\n\\n### Why this matters beyond the log noise\\n\\nDuplicate registration isn't just cosmetic:\\n- If the registry doesn't deduplicate on tool name, the LLM sees two definitions of the same tool → unpredictable behavior\\n- If it does deduplicate (last-write-wins), the second registration may overwrite the first with a different runtime binding, potentially causing silent failures\\n- Double memory allocation for tool definitions\\n\\n### Fix\\n\\nThe cleanest fix is to **remove the `\\\"skills\\\"` field from `openclaw.plugin.json`** and keep the programmatic `register()` as the sole entry point. This is the right call because:\\n- `register()` also handles `setFeishuRuntime()` and `registerChannel()` — you can't remove it\\n- The `skills` declarative path doesn't know about these side effects\\n\\n```diff\\n// extensions/feishu/openclaw.plugin.json\\n{\\n  \\\"name\\\": \\\"feishu\\\",\\n-  \\\"skills\\\": [\\\"./skills\\\"],\\n  \\\"register\\\": \\\"./dist/index.js\\\"\\n}\\n```\\n\\nAlternative: if the `skills` declarative path is required for other reasons, add a registration guard in `register()`:\\n\\n```ts\\n// index.ts\\nlet registered = false;\\nexport function register(runtime: FeishuRuntime) {\\n  if (registered) return;  // Guard against double-registration\\n  registered = true;\\n  setFeishuRuntime(runtime);\\n  registerFeishuDocTools();\\n  registerFeishuChatTools();\\n  // ...\\n}\\n```\\n\\nThe idempotency guard is a good defensive measure regardless, in case other plugin loading paths could trigger double-registration.\",\"createdAt\":\"2026-03-23T02:21:28Z\",\"includesCreatedEdit\":false,\"isMinimized\":false,\"minimizedReason\":\"\",\"reactionGroups\":[],\"url\":\"https://github.com/openclaw/openclaw/issues/52572#issuecomment-4107575039\",\"viewerDidAuthor\":false}],\"number\":52572,\"title\":\"[Bug]: **Feishu plugin registers all tools twice**\",\"url\":\"https://github.com/openclaw/openclaw/issues/52572\"}","cwd":"/root/.openclaw/workspace"},"isError":false,"timestamp":1774331931562}}
