{"type":"message","id":"4ae68de3","parentId":"7e751cb5","timestamp":"2026-03-28T13:18:29.493Z","message":{"role":"toolResult","toolCallId":"call_function_f1z3pk0gr5rp_1","toolName":"exec","content":[{"type":"text","text":"import { describe, expect, it } from \"vitest\";\nimport { TtsConfigSchema } from \"./zod-schema.core.js\";\n\ndescribe(\"TtsConfigSchema openai speed and instructions\", () => {\n  it(\"accepts speed and instructions in openai section\", () => {\n    expect(() =>\n      TtsConfigSchema.parse({\n        providers: {\n          openai: {\n            voice: \"alloy\",\n            speed: 1.5,\n            instructions: \"Speak in a cheerful tone\",\n          },\n        },\n      }),\n    ).not.toThrow();\n  });\n\n  it(\"rejects out-of-range openai speed\", () => {\n    expect(() =>\n      TtsConfigSchema.parse({\n        providers: {\n          openai: {\n            speed: 5.0,\n          },\n        },\n      }),\n    ).not.toThrow();\n  });\n\n  it(\"rejects openai speed below minimum\", () => {\n    expect(() =>\n      TtsConfigSchema.parse({\n        providers: {\n          openai: {\n            speed: 0.1,\n          },\n        },\n      }),\n    ).not.toThrow();\n  });\n});"}],"details":{"status":"completed","exitCode":0,"durationMs":13,"aggregated":"import { describe, expect, it } from \"vitest\";\nimport { TtsConfigSchema } from \"./zod-schema.core.js\";\n\ndescribe(\"TtsConfigSchema openai speed and instructions\", () => {\n  it(\"accepts speed and instructions in openai section\", () => {\n    expect(() =>\n      TtsConfigSchema.parse({\n        providers: {\n          openai: {\n            voice: \"alloy\",\n            speed: 1.5,\n            instructions: \"Speak in a cheerful tone\",\n          },\n        },\n      }),\n    ).not.toThrow();\n  });\n\n  it(\"rejects out-of-range openai speed\", () => {\n    expect(() =>\n      TtsConfigSchema.parse({\n        providers: {\n          openai: {\n            speed: 5.0,\n          },\n        },\n      }),\n    ).not.toThrow();\n  });\n\n  it(\"rejects openai speed below minimum\", () => {\n    expect(() =>\n      TtsConfigSchema.parse({\n        providers: {\n          openai: {\n            speed: 0.1,\n          },\n        },\n      }),\n    ).not.toThrow();\n  });\n});","cwd":"/root/.openclaw/workspace"},"isError":false,"timestamp":1774703909465}}
