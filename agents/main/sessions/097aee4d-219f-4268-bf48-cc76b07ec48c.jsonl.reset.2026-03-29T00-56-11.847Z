    Wait for final response (agent) (default:\n                                       false)\n  --failure-alert                      Enable failure alerts for this job\n  --failure-alert-account-id <id>      Account ID for failure alert channel\n                                       (multi-account setups)\n  --failure-alert-after <n>            Alert after N consecutive job errors\n  --failure-alert-channel <channel>    Failure alert channel (last)\n  --failure-alert-cooldown <duration>  Minimum time between alerts (e.g. 1h,\n                                       30m)\n  --failure-alert-mode <mode>          Failure alert delivery mode (announce or\n                                       webhook)\n  --failure-alert-to <dest>            Failure alert destination\n  -h, --help                           Display help for command\n  --keep-after-run                     Keep one-shot job after it succeeds\n                                       (default: false)\n  --light-context                      Enable lightweight bootstrap context for\n                                       agent jobs\n  --message <text>                     Set agentTurn payload message\n  --model <model>                      Model override for agent jobs\n  --name <name>                        Set name\n  --no-best-effort-deliver             Fail job when delivery fails\n  --no-deliver                         Disable announce delivery\n  --no-failure-alert                   Disable failure alerts for this job\n  --no-light-context                   Disable lightweight bootstrap context for\n                                       agent jobs\n  --session <target>                   Session target (main|isolated)\n  --session-key <key>                  Set session key for job routing\n  --stagger <duration>                 Cron stagger window (e.g. 30s, 5m)\n  --system-event <text>                Set systemEvent payload\n  --thinking <level>                   Thinking level for agent jobs\n  --timeout <ms>                       Timeout in ms (default: \"30000\")\n  --timeout-seconds <n>                Timeout seconds for agent jobs\n  --to <dest>                          Delivery destination (E.164, Telegram\n                                       chatId, or Discord channel/user)\n  --token <token>                      Gateway token (if required)\n  --tz <iana>                          Timezone for cron expressions (IANA)\n  --url <url>                          Gateway WebSocket URL (defaults to\n                                       gateway.remote.url when configured)\n  --wake <mode>                        Wake mode (now|next-heartbeat)"}],"details":{"status":"completed","exitCode":0,"durationMs":2891,"aggregated":"🦞 OpenClaw 2026.3.11 (29dc654) — Built by lobsters, for humans. Don't question the hierarchy.\n\nUsage: openclaw cron edit [options] <id>\n\nEdit a cron job (patch fields)\n\nArguments:\n  id                                   Job id\n\nOptions:\n  --account <id>                       Channel account id for delivery\n                                       (multi-account setups)\n  --agent <id>                         Set agent id\n  --announce                           Announce summary to a chat\n                                       (subagent-style)\n  --at <when>                          Set one-shot time (ISO) or duration like\n                                       20m\n  --best-effort-deliver                Do not fail job if delivery fails\n  --channel <channel>                  Delivery channel (last)\n  --clear-agent                        Unset agent and use default (default:\n                                       false)\n  --clear-session-key                  Unset session key (default: false)\n  --cron <expr>                        Set cron expression\n  --delete-after-run                   Delete one-shot job after it succeeds\n                                       (default: false)\n  --deliver                            Deprecated (use --announce). Announces a\n                                       summary to a chat.\n  --description <text>                 Set description\n  --disable                            Disable job (default: false)\n  --enable                             Enable job (default: false)\n  --every <duration>                   Set interval duration like 10m\n  --exact                              Disable cron staggering (set stagger to\n                                       0)\n  --expect-final                       Wait for final response (agent) (default:\n                                       false)\n  --failure-alert                      Enable failure alerts for this job\n  --failure-alert-account-id <id>      Account ID for failure alert channel\n                                       (multi-account setups)\n  --failure-alert-after <n>            Alert after N consecutive job errors\n  --failure-alert-channel <channel>    Failure alert channel (last)\n  --failure-alert-cooldown <duration>  Minimum time between alerts (e.g. 1h,\n                                       30m)\n  --failure-alert-mode <mode>          Failure alert delivery mode (announce or\n                                       webhook)\n  --failure-alert-to <dest>            Failure alert destination\n  -h, --help                           Display help for command\n  --keep-after-run                     Keep one-shot job after it succeeds\n                                       (default: false)\n  --light-context                      Enable lightweight bootstrap context for\n                                       agent jobs\n  --message <text>                     Set agentTurn payload message\n  --model <model>                      Model override for agent jobs\n  --name <name>                        Set name\n  --no-best-effort-deliver             Fail job when delivery fails\n  --no-deliver                         Disable announce delivery\n  --no-failure-alert                   Disable failure alerts for this job\n  --no-light-context                   Disable lightweight bootstrap context for\n                                       agent jobs\n  --session <target>                   Session target (main|isolated)\n  --session-key <key>                  Set session key for job routing\n  --stagger <duration>                 Cron stagger window (e.g. 30s, 5m)\n  --system-event <text>                Set systemEvent payload\n  --thinking <level>                   Thinking level for agent jobs\n  --timeout <ms>                       Timeout in ms (default: \"30000\")\n  --timeout-seconds <n>                Timeout seconds for agent jobs\n  --to <dest>                          Delivery destination (E.164, Telegram\n                                       chatId, or Discord channel/user)\n  --token <token>                      Gateway token (if required)\n  --tz <iana>                          Timezone for cron expressions (IANA)\n  --url <url>                          Gateway WebSocket URL (defaults to\n                                       gateway.remote.url when configured)\n  --wake <mode>                        Wake mode (now|next-heartbeat)","cwd":"/root/.openclaw/workspace"},"isError":false,"timestamp":1774665985986}}
{"type":"message","id":"d10ca793","parentId":"35be1fad","timestamp":"2026-03-28T02:46:35.515Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"I need to update the cron job to:\n1. Set `--agent xixi` (or the xixi agent id)\n2. Set `--model arkcode/glm-4.7`\n\nThe xixi agent session key is `agent:xixi:feishu:xixi:direct:ou_7e95c6c474ffd4086e3a05454dd29c24`.\n\nFor cron with agent targeting, I should use `--session-key` or `--agent` flag. Let me check - the cron currently has target=isolated. If I want to use xixi, I might need to set the session-key to xixi's session, or use the agent parameter.\n\n\nNow I'm trying to figure out which flag to use - whether `--session-key` with xixi's direct session or `--agent` with the xixi agent ID. The cron is currently set to isolated mode, so I need to understand how agent-to-agent communication works within the cron framework before deciding which approach to take.\n\nLooking at the available options, `--agent` takes an agent ID directly while `--session-key` takes a specific session key. Since xixi's agentId is `xixi`, I'll use that with the `--agent` flag and set the model to `arkcode/glm-4.7`.","thinkingSignature":"ed5607027703c01ab33a728aa972151431e8370a013825ee44ef98e9eae609bb"},{"type":"toolCall","id":"call_function_kulqpdiaq7kh_1","name":"exec","arguments":{"command":"openclaw cron edit 6f8bd6c8-5b5f-4cf7-8e6f-3479fd23fc64 --agent xixi --model arkcode/glm-4.7 --session isolated"}}],"api":"anthropic-messages","provider":"minimax","model":"MiniMax-M2.7","usage":{"input":21919,"output":349,"cacheRead":22915,"cacheWrite":0,"totalTokens":45183,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1774665986003}}
{"type":"message","id":"210cc4b1","parentId":"d10ca793","timestamp":"2026-03-28T02:46:38.416Z","message":{"role":"toolResult","toolCallId":"call_function_kulqpdiaq7kh_1","toolName":"exec","content":[{"type":"text","text":"{\n  \"id\": \"6f8bd6c8-5b5f-4cf7-8e6f-3479fd23fc64\",\n  \"agentId\": \"xixi\",\n  \"name\": \"OpenClaw 社区机会扫描\",\n  \"enabled\": true,\n  \"createdAtMs\": 1774611992772,\n  \"updatedAtMs\": 1774665998301,\n  \"schedule\": {\n    \"kind\": \"every\",\n    \"everyMs\": 3600000,\n    \"anchorMs\": 1774611992772\n  },\n  \"sessionTarget\": \"isolated\",\n  \"wakeMode\": \"now\",\n  \"payload\": {\n    \"kind\": \"agentTurn\",\n    \"message\": \"任务：扫描 OpenClaw 社区新机会（每小时主动执行）\\n\\n你是 OpenClaw 贡献项目的主动侦查员。每 1 小时自动执行，不需要任何人催促。\\n\\n步骤：\\n1. gh api 查最近 90 分钟内更新的 open GitHub issues 和 PRs（过滤已 merge/已 close）\\n2. 重点找：regression、未确认 bug、usability gap、docs gap\\n3. 读每个候选详情，判断是否值得 action\\n4. 在 memory/OPENCLAW-PROJECT.md 的当前优先级表格中确认未重复\\n\\n已覆盖项（勿重复）：\\n#54952 #54964 #55008 #55013 #55153 #55137 #55466 #55458 #55479\\n\\n判断标准：\\n- 能本地复现 + 严重度高 → 直接测试并更新文件\\n- docs gap / usability gap → 更新文件并考虑发 issue/PR\\n- 已是热门/有人处理中 → 跳过\\n\\n交付：\\n- 有值得 action 的新发现 → 更新 memory/OPENCLAW-PROJECT.md\\n- 无新发现 → 回复 NO_REPLY\\n\\n禁止向任何聊天渠道发消息、禁止 git commit。\\n\\nCurrent time: $(date '+\\\\%Y-\\\\%m-\\\\%d \\\\%H:\\\\%M \\\\%Z')\",\n    \"model\": \"arkcode/glm-4.7\"\n  },\n  \"delivery\": {\n    \"mode\": \"none\",\n    \"channel\": \"last\"\n  },\n  \"state\": {\n    \"nextRunAtMs\": 1774665992921,\n    \"lastRunAtMs\": 1774662392921,\n    \"lastRunStatus\": \"ok\",\n    \"lastStatus\": \"ok\",\n    \"lastDurationMs\": 371808,\n    \"lastDelivered\": false,\n    \"lastDeliveryStatus\": \"not-delivered\",\n    \"consecutiveErrors\": 0,\n    \"runningAtMs\": 1774665992928\n  }\n}"}],"details":{"status":"completed","exitCode":0,"durationMs":2882,"aggregated":"{\n  \"id\": \"6f8bd6c8-5b5f-4cf7-8e6f-3479fd23fc64\",\n  \"agentId\": \"xixi\",\n  \"name\": \"OpenClaw 社区机会扫描\",\n  \"enable