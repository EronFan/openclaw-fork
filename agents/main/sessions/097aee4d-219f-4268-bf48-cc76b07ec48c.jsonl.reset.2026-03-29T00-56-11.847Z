{"type":"message","id":"3547e7d5","parentId":"c6a29908","timestamp":"2026-03-28T12:48:35.438Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"This is the `resolveGroupPolicy()` function. The `requireMention` is resolved from group config or global config. Let me look at the full function and the surrounding context to understand where it might be going wrong.","thinkingSignature":"a850ec3af3607c9425ae2fda60fc9301f2dbbfaa3d8dc83db37e84509df8d17d"},{"type":"toolCall","id":"call_function_t4xyxm6xi3b6_1","name":"exec","arguments":{"command":"sed -n '90,130p' /root/openclaw-fork/extensions/feishu/src/policy.ts"}}],"api":"anthropic-messages","provider":"minimax","model":"MiniMax-M2.7","usage":{"input":71881,"output":94,"cacheRead":22625,"cacheWrite":0,"totalTokens":94600,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1774702111088,"responseId":"0617011f9b436bfd8479a3fa7237f64c"}}
{"type":"message","id":"761c4242","parentId":"3547e7d5","timestamp":"2026-03-28T12:48:35.555Z","message":{"role":"toolResult","toolCallId":"call_function_t4xyxm6xi3b6_1","toolName":"exec","content":[{"type":"text","text":"export function isFeishuGroupAllowed(params: {\n  groupPolicy: \"open\" | \"allowlist\" | \"disabled\" | \"allowall\";\n  allowFrom: Array<string | number>;\n  senderId: string;\n  senderIds?: Array<string | null | undefined>;\n  senderName?: string | null;\n}): boolean {\n  return evaluateSenderGroupAccessForPolicy({\n    groupPolicy: params.groupPolicy === \"allowall\" ? \"open\" : params.groupPolicy,\n    groupAllowFrom: params.allowFrom.map((entry) => String(entry)),\n    senderId: params.senderId,\n    isSenderAllowed: () => resolveFeishuAllowlistMatch(params).allowed,\n  }).allowed;\n}\n\nexport function resolveFeishuReplyPolicy(params: {\n  isDirectMessage: boolean;\n  globalConfig?: FeishuConfig;\n  groupConfig?: FeishuGroupConfig;\n}): { requireMention: boolean } {\n  if (params.isDirectMessage) {\n    return { requireMention: false };\n  }\n\n  const requireMention =\n    params.groupConfig?.requireMention ?? params.globalConfig?.requireMention ?? true;\n\n  return { requireMention };\n}"}],"details":{"status":"completed","exitCode":0,"durationMs":78,"aggregated":"export function isFeishuGroupAllowed(params: {\n  groupPolicy: \"open\" | \"allowlist\" | \"disabled\" | \"allowall\";\n  allowFrom: Array<string | number>;\n  senderId: string;\n  senderIds?: Array<string | null | undefined>;\n  senderName?: string | null;\n}): boolean {\n  return evaluateSenderGroupAccessForPolicy({\n    groupPolicy: params.groupPolicy === \"allowall\" ? \"open\" : params.groupPolicy,\n    groupAllowFrom: params.allowFrom.map((entry) => String(entry)),\n    senderId: params.senderId,\n    isSenderAllowed: () => resolveFeishuAllowlistMatch(params).allowed,\n  }).allowed;\n}\n\nexport function resolveFeishuReplyPolicy(params: {\n  isDirectMessage: boolean;\n  globalConfig?: FeishuConfig;\n  groupConfig?: FeishuGroupConfig;\n}): { requireMention: boolean } {\n  if (params.isDirectMessage) {\n    return { requireMention: false };\n  }\n\n  const requireMention =\n    params.groupConfig?.requireMention ?? params.globalConfig?.requireMention ?? true;\n\n  return { requireMention };\n}","cwd":"/root/.openclaw/workspace"},"isError":false,"timestamp":1774702115536}}
