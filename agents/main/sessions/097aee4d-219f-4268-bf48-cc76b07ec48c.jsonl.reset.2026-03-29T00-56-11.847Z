ation\"}\n{\"additions\":50,\"author\":\"eliot-onbox\",\"changedFiles\":2,\"deletions\":16,\"labels\":[\"size: S\"],\"number\":56084,\"reviewDecision\":\"\",\"title\":\"fix(hooks): load bundled hooks when hooks.internal.enabled is undefined\"}\n{\"additions\":110,\"author\":\"socamalo\",\"changedFiles\":15,\"deletions\":8,\"labels\":[\"agents\",\"size: S\"],\"number\":56082,\"reviewDecision\":\"\",\"title\":\"Fix #55802 and #55849: exec obfuscation config and sessionKey in transcript header\"}\n{\"additions\":7,\"author\":\"Ghabs95\",\"changedFiles\":2,\"deletions\":1,\"labels\":[\"size: XS\"],\"number\":56081,\"reviewDecision\":\"\",\"title\":\"feat: include model in response usage footer\"}\n{\"additions\":2,\"author\":\"Jstaud\",\"changedFiles\":1,\"deletions\":2,\"labels\":[\"gateway\",\"size: XS\"],\"number\":56080,\"reviewDecision\":\"\",\"title\":\"Fix/systemd activate resolved unit\"}\n{\"additions\":1,\"author\":\"armanmikoyan\",\"changedFiles\":1,\"deletions\":1,\"labels\":[\"size: XS\"],\"number\":56070,\"reviewDecision\":\"\",\"title\":\"fix(memory-lancedb): add missing radix to parseInt call\"}\n{\"additions\":4,\"author\":\"Abhishek21k\",\"changedFiles\":2,\"deletions\":4,\"labels\":[\"agents\",\"size: XS\"],\"number\":56069,\"reviewDecision\":\"\",\"title\":\"fix(agents): ensure 402 Billing/Quota errors trigger model failover\"}\n{\"additions\":82,\"author\":\"pkuGeo\",\"changedFiles\":4,\"deletions\":4,\"labels\":[\"channel: telegram\",\"size: S\"],\"number\":56067,\"reviewDecision\":\"\",\"title\":\"telegram: cache botInfo across polling cycles to eliminate getMe() init stall\"}\n{\"additions\":6,\"author\":\"armanmikoyan\",\"changedFiles\":6,\"deletions\":6,\"labels\":[\"channel: telegram\",\"gateway\",\"agents\",\"size: XS\"],\"number\":56064,\"reviewDecision\":\"\",\"title\":\"fix: use American English spelling in code comments\"}\n{\"additions\":97,\"author\":\"one27001\",\"changedFiles\":4,\"deletions\":9,\"labels\":[\"channel: telegram\",\"agents\",\"size: S\"],\"number\":56060,\"reviewDecision\":\"\",\"title\":\"feat(telegram): add child thread-binding placement via createForumTopic [AI-assisted]\"}\n{\"additions\":2891,\"author\":\"huntharo\",\"changedFiles\":58,\"deletions\":115,\"labels\":[\"agents\",\"size: XL\"],\"number\":56048,\"reviewDecision\":\"\",\"title\":\"fix(xai): move bundled provider to Responses and add x_search\"}\n{\"additions\":4,\"author\":\"Protocol-zero-0\",\"changedFiles\":2,\"deletions\":2,\"labels\":[\"channel: nextcloud-talk\",\"size: XS\"],\"number\":56043,\"reviewDecision\":\"\",\"title\":\"docs(nextcloud-talk): document required response feature\"}\n{\"additions\":25,\"author\":\"justinjkline\",\"changedFiles\":4,\"deletions\":4,\"labels\":[\"agents\",\"size: XS\"],\"number\":56036,\"reviewDecision\":\"\",\"title\":\"fix: inject context.agentId into toToolDefinitions hook dispatch\"}\n{\"additions\":62,\"author\":\"ninjaa\",\"changedFiles\":3,\"deletions\":2,\"labels\":[\"agents\",\"size: S\"],\"number\":56031,\"reviewDecision\":\"\",\"title\":\"fix(pi-runner): use post-hook assistant for expect-final payloads\"}\n{\"additions\":11,\"author\":\"ninjaa\",\"changedFiles\":3,\"deletions\":6,\"labels\":[\"channel: discord\",\"size: XS\"],\"number\":56030,\"reviewDecision\":\"\",\"title\":\"fix(discord): restore uploadUrlRequest arg to RateLimitError in voice-message\"}\n{\"additions\":64,\"author\":\"bde1\",\"changedFiles\":3,\"deletions\":0,\"labels\":[\"agents\",\"size: S\"],\"number\":56028,\"reviewDecision\":\"\",\"title\":\"fix(sessions): honor spawned tree lineage across agents\"}\n{\"additions\":64,\"author\":\"bde1\",\"changedFiles\":5,\"deletions\":1,\"labels\":[\"size: S\"],\"number\":56026,\"reviewDecision\":\"\",\"title\":\"fix(plugins): fall back to npm on clawhub request failures\"}\n{\"additions\":48,\"author\":\"bde1\",\"changedFiles\":2,\"deletions\":3,\"labels\":[\"channel: voice-call\",\"size: S\"],\"number\":56025,\"reviewDecision\":\"\",\"title\":\"fix(voi