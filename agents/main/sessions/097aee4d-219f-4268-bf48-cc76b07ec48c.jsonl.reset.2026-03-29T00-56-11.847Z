{"type":"message","id":"f733c8ca","parentId":"a32a149e","timestamp":"2026-03-28T07:34:31.030Z","message":{"role":"toolResult","toolCallId":"call_function_ifw8vmfevyu8_1","toolName":"exec","content":[{"type":"text","text":"{\"author\":\"GodsBoy\",\"labels\":[\"size: M\"],\"reviewDecision\":\"\",\"title\":\"fix(plugins): reuse active registry for sub-agent tool resolution\"}"}],"details":{"status":"completed","exitCode":0,"durationMs":522,"aggregated":"{\"author\":\"GodsBoy\",\"labels\":[\"size: M\"],\"reviewDecision\":\"\",\"title\":\"fix(plugins): reuse active registry for sub-agent tool resolution\"}","cwd":"/root/.openclaw/workspace"},"isError":false,"timestamp":1774683271007}}
