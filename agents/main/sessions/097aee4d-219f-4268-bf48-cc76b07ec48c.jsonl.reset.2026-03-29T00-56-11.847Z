{"type":"message","id":"6c8af98e","parentId":"d7239614","timestamp":"2026-03-28T12:49:23.506Z","message":{"role":"toolResult","toolCallId":"call_function_q7824zrldqdl_1","toolName":"exec","content":[{"type":"text","text":"export function resolveFeishuGroupConfig(params: {\n  cfg?: FeishuConfig;\n  groupId?: string | null;\n}): FeishuGroupConfig | undefined {\n  const groups = params.cfg?.groups ?? {};\n  const wildcard = groups[\"*\"];\n  const groupId = params.groupId?.trim();\n  if (!groupId) {\n    return undefined;\n  }\n\n  const direct = groups[groupId];\n  if (direct) {\n    return direct;\n  }\n\n  const lowered = groupId.toLowerCase();\n  const matchKey = Object.keys(groups).find((key) => key.toLowerCase() === lowered);\n  if (matchKey) {\n    return groups[matchKey];\n  }\n  return wildcard;\n}\n\nexport function resolveFeishuGroupToolPolicy(\n  params: ChannelGroupContext,\n): GroupToolPolicyConfig | undefined {\n  const cfg = params.cfg.channels?.feishu as FeishuConfig | undefined;\n  if (!cfg) {\n    return undefined;\n  }\n\n  const groupConfig = resolveFeishuGroupConfig({\n    cfg,\n    groupId: params.groupId,\n  });\n\n  return groupConfig?.tools;\n}"}],"details":{"status":"completed","exitCode":0,"durationMs":12,"aggregated":"export function resolveFeishuGroupConfig(params: {\n  cfg?: FeishuConfig;\n  groupId?: string | null;\n}): FeishuGroupConfig | undefined {\n  const groups = params.cfg?.groups ?? {};\n  const wildcard = groups[\"*\"];\n  const groupId = params.groupId?.trim();\n  if (!groupId) {\n    return undefined;\n  }\n\n  const direct = groups[groupId];\n  if (direct) {\n    return direct;\n  }\n\n  const lowered = groupId.toLowerCase();\n  const matchKey = Object.keys(groups).find((key) => key.toLowerCase() === lowered);\n  if (matchKey) {\n    return groups[matchKey];\n  }\n  return wildcard;\n}\n\nexport function resolveFeishuGroupToolPolicy(\n  params: ChannelGroupContext,\n): GroupToolPolicyConfig | undefined {\n  const cfg = params