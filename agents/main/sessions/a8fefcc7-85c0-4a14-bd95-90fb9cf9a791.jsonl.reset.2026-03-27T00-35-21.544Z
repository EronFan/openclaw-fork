{"type":"message","id":"2e3358b0","parentId":"52d482c1","timestamp":"2026-03-26T12:53:58.626Z","message":{"role":"toolResult","toolCallId":"call_function_6oym7gnyrfah_1","toolName":"exec","content":[{"type":"text","text":"@@ -1572,6 +1572,57 @@ describe(\"wrapStreamFnRepairMalformedToolCallArguments\", () => {\n     expect(partialToolCall.arguments).toEqual({});\n   });\n \n+  it(\"preserves valid tool arguments when a closing delta completes valid JSON\", async () => {\n+    const parsedArgs = { path: \"/tmp/report.txt\" };\n+    const partialToolCall = { type: \"toolCall\", name: \"read\", arguments: parsedArgs };\n+    const streamedToolCall = { type: \"toolCall\", name: \"read\", arguments: parsedArgs };\n+    const endMessageToolCall = { type: \"toolCall\", name: \"read\", arguments: parsedArgs };\n+    const finalToolCall = { type: \"toolCall\", name: \"read\", arguments: parsedArgs };\n+    const partialMessage = { role: \"assistant\", content: [partialToolCall] };\n+    const endMessage = { role: \"assistant\", content: [endMessageToolCall] };\n+    const finalMessage = { role: \"assistant\", content: [finalToolCall] };\n+    const baseFn = vi.fn(() =>\n+      createFakeStream({\n+        events: [\n+          {\n+            type: \"toolcall_delta\",\n+            contentIndex: 0,\n+            delta: '{\"path\":\"/tmp/report.txt\"',\n+            partial: partialMessage,\n+            message: finalMessage,\n+          },\n+          {\n+            type: \"toolcall_delta\",\n+            contentIndex: 0,\n+            delta: \"}\",\n+            partial: partialMessage,\n+            message: finalMessage,\n+          },\n+          {\n+            type: \"toolcall_end\",\n+            contentIndex: 0,\n+            toolCall: streamedToolCall,\n+            partial: partialMessage,\n+            message: endMessage,\n+          },\n+        ],\n+        resultMessage: finalMessage,\n+      }),\n+    );\n+\n+    const stream = await invokeWrappedStream(baseFn);\n+    for await (const _item of stream) {\n+      // drain\n+    }\n+    const result = await stream.result();\n+\n+    expect(partialToolCall.arguments).toEqual(parsedArgs);\n+    expect(streamedToolCall.arguments).toEqual(parsedArgs);\n+    expect(endMessageToolCall.arguments).toEqual(parsedArgs);\n+    expect(finalToolCall.arguments).toEqual(parsedArgs);\n+    expect(result).toBe(finalMessage);\n+  });\n+\n   it(\"does not repair tool arguments when trailing junk exceeds the Kimi-specific allowance\", async () => {\n     const partialToolCall = { type: \"toolCall\", name: \"read\", arguments: {} };\n     const streamedToolCall = { type: \"toolCall\", name: \"read\", arguments: {} };\n@@ -1145,6 +1145,15 @@ type ToolCallArgumentRepair = {\n   trailingSuffix: string;\n };\n \n+function isValidJsonObject(raw: string): boolean {\n+  try {\n+    const parsed = JSON.parse(raw) as unknown;\n+    return parsed !== null && typeof parsed === \"object\" && !Array.isArray(parsed);\n+  } catch {\n+    return false;\n+  }\n+}\n+\n function tryParseMalformedToolCallArguments(raw: string): ToolCallArgumentRepair | undefined {\n   if (!raw.trim()) {\n     return undefined;\n@@ -1298,7 +1307,8 @@ function wrapStreamRepairMalformedToolCallArguments(\n                       `repairing Kimi tool call arguments after ${repair.trailingSuffix.length} trailing chars`,\n                     );\n                   }\n-                } else {\n+                } else if (!isValidJsonObject(nextPartialJson)) {\n+                  // Leave already-parsed arguments intact when the accumulated JSON is valid.\n                   repairedArgsByIndex.delete(event.contentIndex);\n                   clearToolCallArgumentsInMessage(event.partial, event.contentIndex);\n                   clearToolCallArgumentsInMessage(event.message, event.contentIndex);"}],"details":{"status":"completed","exitCode":0,"durationMs":478,"aggregated":"@@ -1572,6 +1572,57 @@ describe(\"wrapStreamFnRepairMalformedToolCallArguments\", () => {\n     expect(partialToolCall.arguments).toEqual({});\n   });\n \n+  it(\"preserves valid tool arguments when a closing delta completes valid JSON\", async () => {\n+    const parsedArgs = { path: \"/tmp/report.txt\" };\n+    const partialToolCall = { type: \"toolCall\", name: \"read\", arguments: parsedArgs };\n+    const streamedToolCall = { type: \"toolCall\", name: \"read\", arguments: parsedArgs };\n+    const endMessageToolCall = { type: \"toolCall\", name: \"read\", arguments: parsedArgs };\n+    const finalToolCall = { type: \"toolCall\", name: \"read\", arguments: parsedArgs };\n+    const partialMessage = { role: \"assistant\", content: [partialToolCall] };\n+    const endMessage = { role: \"assistant\", content: [endMessageToolCall] };\n+    const finalMessage = { role: \"assistant\", content: [finalToolCall] };\n+    const baseFn = vi.fn(() =>\n+      createFakeStream({\n+        events: [\n+          {\n+            type: \"toolcall_delta\",\n+            contentIndex: 0,\n+            delta: '{\"path\":\"/tmp/report.txt\"',\n+            partial: partialMessage,\n+            message: finalMessage,\n+          },\n+          {\n+            type: \"toolcall_delta\",\n+            contentIndex: 0,\n+            delta: \"}\",\n+            partial: partialMessage,\n+            message: finalMessage,\n+          },\n+          {\n+            type: \"toolcall_end\",\n+            contentIndex: 0,\n+            toolCall: streamedToolCall,\n+            partial: partialMessage,\n+            message: endMessage,\n+          },\n+        ],\n+        resultMessage: finalMessage,\n+      }),\n+    );\n+\n+    const stream = await invokeWrappedStream(baseFn);\n+    for await (const _item of stream) {\n+      // drain\n+    }\n+    const result = await stream.result();\n+\n+    expect(partialToolCall.arguments).toEqual(parsedArgs);\n+    expect(streamedToolCall.arguments).toEqual(parsedArgs);\n+    expect(endMessageToolCall.arguments).toEqual(parsedArgs);\n+    expect(finalToolCall.arguments).toEqual(parsedArgs);\n+    expect(result).toBe(finalMessage);\n+  });\n+\n   it(\"does not repair tool arguments when trailing junk exceeds the Kimi-specific allowance\", async () => {\n     const partialToolCall = { type: \"toolCall\", name: \"read\", arguments: {} };\n     const streamedToolCall = { type: \"toolCall\", name: \"read\", arguments: {} };\n@@ -1145,6 +1145,15 @@ type ToolCallArgumentRepair = {\n   trailingSuffix: string;\n };\n \n+function isValidJsonObject(raw: string): boolean {\n+  try {\n+    const parsed = JSON.parse(raw) as unknown;\n+    return parsed !== null && typeof parsed === \"object\" && !Array.isArray(parsed);\n+  } catch {\n+    return false;\n+  }\n+}\n+\n function tryParseMalformedToolCallArguments(raw: string): ToolCallArgumentRepair | undefined {\n   if (!raw.trim()) {\n     return undefined;\n@@ -1298,7 +1307,8 @@ function wrapStreamRepairMalformedToolCallArguments(\n                       `repairing Kimi tool call arguments after ${repair.trailingSuffix.length} trailing chars`,\n                     );\n                   }\n-                } else {\n+                } else if (!isValidJsonObject(nextPartialJson)) {\n+                  // Leave already-parsed arguments intact when the accumulated JSON is valid.\n                   repairedArgsByIndex.delete(event.contentIndex);\n                   clearToolCallArgumentsInMessage(event.partial, event.contentIndex);\n                   clearToolCallArgumentsInMessage(event.message, event.contentIndex);","cwd":"/root/.openclaw/workspace"},"isError":false,"timestamp":1774529638611}}
{"type":"message","id":"d9fa0de4","parentId":"2e3358b0","timestamp":"2026-03-26T12:54:12.171Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Good, I can see the full patch. Now let me post a proper GitHub review. The review should:1. Confirm the fix is correct\n2. Note that the regression test is precise and well-scoped\n3. Note one small clarification about the `isValidJsonObject` description\n\nLet me post the review via gh api.","thinkingSignature":"6e382d3fdb73c6aa26d67eeb47c8ac9bc6a080b4f9f9187217c9306e5451f632"},{"type":"text","text":"\n现在把 review 发到 GitHub：\n"},{"type":"toolCall","id":"call_function_k9vy3qhcvtk7_1","name":"exec","arguments":{"command":"gh api repos/openclaw/openclaw/pulls/55153/reviews \\\n  --method POST \\\n  --field event=COMMENT \\\n  --field body='## Review: Approve ✅\n\n**Fix 逻辑确认**\n\nThe guard `!isValidJsonObject(nextPartialJson)` is correct. When a closing `}` delta completes a valid JSON object (e.g., `{\"path\":\"/tmp/report.txt\"}`), the accumulated text IS already a valid JSON object, so the guard skips the destructive clear path. This preserves the already-parsed arguments — exactly the intended behavior.\n\n**Regression test 评估**\n\nThe test is precise and well-scoped:\n- Delta 1: `{\"path\":\"/tmp/report.txt\"` → invalid JSON (not yet complete)\n- Delta 2: `}` → completes to valid `{\"path\":\"/tmp/report.txt\"}`, triggers the guard\n- All four references (`partialToolCall`, `streamedToolCall`, `endMessageToolCall`, `finalToolCall`) are verified to retain the parsed arguments\n\nCoverage is sufficient for the described bug.\n\n**One minor note**\n\nThe PR description says `isValidJsonObject()` checks \\\"whether the final arguments are valid JSON\\\" — but it actually checks whether the *accumulated text at that point* is already a valid JSON object. This is the correct behavior (as confirmed by the test), but the description could be slightly clearer to avoid future reader confusion. Not a blocker.\n\n**Gap (acceptable)**\n\nNo live Kimi session verification — the author noted this honestly. Acceptable given the isolated unit test scope.\n\n**Conclusion**: The fix is correct and the test provides adequate coverage for this edge case. LGTM with the minor description note above.' \\\n  2>&1","timeout":20}}],"api":"anthropic-messages","provider":"minimax","model":"MiniMax-M2.7","usage":{"input":61702,"output":469,"cacheRead":22191,"cacheWrite":0,"totalTokens":84362,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1774529638625}}
{"type":"message","id":"3b60382f","parentId":"d9fa0de4","timestamp":"2026-03-26T12:54:13.166Z","message":{"role":"toolResult","toolCallId":"call_function_k9vy3qhcvtk7_1","toolName":"exec","content":[{"type":"text","text":"{\"id\":4013906237,\"node_id\":\"PRR_kwDOQb6kR87vP1k9\",\"user\":{\"login\":\"EronFan\",\"id\":50734013,\"node_id\":\"MDQ6VXNlcjUwNzM0MDEz\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/50734013?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/EronFan\",\"html_url\":\"https://github.com/EronFan\",\"followers_url\":\"https://api.github.com/users/EronFan/followers\",\"following_url\":\"https://api.github.com/users/EronFan/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/EronFan/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/EronFan/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/EronFan/subscriptions\",\"organizations_url\":\"https://api.github.com/users/EronFan/orgs\",\"repos_url\":\"https://api.github.com/users/EronFan/repos\",\"events_url\":\"https://api.github.com/users/EronFan/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/EronFan/received_events\",\"type\":\"User\",\"user_view_type\":\"public\",\"site_admin\":false},\"body\":\"## Review: Approve ✅\\n\\n**Fix 逻辑确认**\\n\\nThe guard `!isValidJsonObject(nextPartialJson)` is correct. When a closing `}` delta completes a valid JSON object (e.g., `{\\\"path\\\":\\\"/tmp/report.txt\\\"}`), the accumulated text IS already a valid JSON object, so the guard skips the destructive clear path. This preserves the already-parsed arguments — exactly the intended behavior.\\n\\n**Regression test 评估**\\n\\nThe test is precise and well-scoped:\\n- Delta 1: `{\\\"path\\\":\\\"/tmp/report.txt\\\"` → invalid JSON (not yet complete)\\n- Delta 2: `}` → completes to valid `{\\\"path\\\":\\\"/tmp/report.txt\\\"}`, triggers the guard\\n- All four references (`partialToolCall`, `streamedToolCall`, `endMessageToolCall`, `finalToolCall`) are verified to retain the parsed arguments\\n\\nCoverage is sufficient for the described bug.\\n\\n**One minor note**\\n\\nThe PR description says `isValidJsonObject()` checks \\\\\\\"whether the final arguments are valid JSON\\\\\\\" — but it actually checks whether the *accumulated text at that point* is already a valid JSON object. This is the correct behavior (as confirmed by the test), but the description could be slightly clearer to avoid future reader confusion. Not a blocker.\\n\\n**Gap (acceptable)**\\n\\nNo live Kimi session verification — the author noted this honestly. Acceptable given the isolated unit test scope.\\n\\n**Conclusion**: The fix is correct and the test provides adequate coverage for this edge case. LGTM with the minor description note above.\",\"state\":\"COMMENTED\",\"html_url\":\"https://github.com/openclaw/openclaw/pull/55153#pullrequestreview-4013906237\",\"pull_request_url\":\"https://api.github.com/repos/openclaw/openclaw/pulls/55153\",\"author_association\":\"NONE\",\"_links\":{\"html\":{\"href\":\"https://github.com/openclaw/openclaw/pull/55153#pullrequestreview-4013906237\"},\"pull_request\":{\"href\":\"https://api.github.com/repos/openclaw/openclaw/pulls/55153\"}},\"submitted_at\":\"2026-03-26T12:54:12Z\",\"commit_id\":\"7c7c8a6f0a72db89634430d0c22f2310b97f3a14\"}"}],"details":{"status":"completed","exitCode":0,"durationMs":979,"aggregated":"{\"id\":4013906237,\"node_id\":\"PRR_kwDOQb6kR87vP1k9\",\"user\":{\"login\":\"EronFan\",\"id\":50734013,\"node_id\":\"MDQ6VXNlcjUwNzM0MDEz\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/50734013?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/EronFan\",\"html_url\":\"https://github.com/EronFan\",\"followers_url\":\"https://api.github.com/users/EronFan/followers\",\"following_url\":\"https://api.github.com/users/EronFan/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/EronFan/gists{/gist_id}\",\"starred_ur