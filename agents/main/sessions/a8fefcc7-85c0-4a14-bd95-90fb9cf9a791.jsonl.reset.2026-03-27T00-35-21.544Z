the minor description note above.\",\"state\":\"COMMENTED\",\"html_url\":\"https://github.com/openclaw/openclaw/pull/55153#pullrequestreview-4013906237\",\"pull_request_url\":\"https://api.github.com/repos/openclaw/openclaw/pulls/55153\",\"author_association\":\"NONE\",\"_links\":{\"html\":{\"href\":\"https://github.com/openclaw/openclaw/pull/55153#pullrequestreview-4013906237\"},\"pull_request\":{\"href\":\"https://api.github.com/repos/openclaw/openclaw/pulls/55153\"}},\"submitted_at\":\"2026-03-26T12:54:12Z\",\"commit_id\":\"7c7c8a6f0a72db89634430d0c22f2310b97f3a14\"}","cwd":"/root/.openclaw/workspace"},"isError":false,"timestamp":1774529653150}}
{"type":"message","id":"0d4b3fb7","parentId":"3b60382f","timestamp":"2026-03-26T12:54:23.420Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"The review has been posted successfully to GitHub. The review URL is: https://github.com/openclaw/openclaw/pull/55153#pullrequestreview-4013906237\n\nNow let me also handle the #55137 review task. I should dispatch ling (or aoao) to review #55137 as well. But ling is not responding. Let me try to do the #55137 review myself as well, since I have the context from xixi's research.\n\nActually, let me first update the OPENCLAW-PROJECT.md with this new submission, and then decide what to do about #55137.\n\nFor #55137, based on xixi's research:\n\n\nI found that `formatToolTitle` and `resolvePermissionRequest` are using different sanitization methods—escapeInlineControlChars versus sanitizeTerminalText—which could produce different outputs for the same input. I should post a review on #55137 flagging this inconsistency and asking if it's intentional, rather than waiting for ling to become available.\n\nI'm going to review both #55137 and #55143 directly and then update the project file with the current status, since #55008 and #55013 still need maintainer feedback and the cron is running every 30 minutes to catch that.","thinkingSignature":"8efe5fbff2dbddbed91c15b94fdb75265b1c35f51f2502a932eb8959afebef08"},{"type":"text","text":"Review 已发 ✅ URL: https://github.com/openclaw/openclaw/pull/55153#pullrequestreview-4013906237\n\n趁 ling 没响应，我直接把 #55137 也 review 了：\n"},{"type":"toolCall","id":"call_function_mjj5y7nworvm_1","name":"exec","arguments":{"command":"timeout 15 gh api repos/openclaw/openclaw/pulls/55137/files --jq '.[].patch' 2>/dev/null","yieldMs":12000}}],"api":"anthropic-messages","provider":"minimax","model":"MiniMax-M2.7","usage":{"input":62978,"output":361,"cacheRead":22191,"cacheWrite":0,"totalTokens":85530,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1774529653164}}
{"type":"message","id":"007ce705","parentId":"0d4b3fb7","timestamp":"2026-03-26T12:54:23.985Z","message":{"role":"toolResult","toolCallId":"call_function_mjj5y7nworvm_1","toolName":"exec","content":[{"type":"text","text":"@@ -10,7 +10,11 @@ import {\n   resolvePermissionRequest,\n   shouldStripProviderAuthEnvVarsForAcpServer,\n } from \"./client.js\";\n-import { extractAttachmentsFromPrompt, extractTextFromPrompt } from \"./event-mapper.js\";\n+import {\n+  extractAttachmentsFromPrompt,\n+  extractTextFromPrompt,\n+  formatToolTitle,\n+} from \"./event-mapper.js\";\n \n const envVar = (...parts: string[]) => parts.join(\"_\");\n \n@@ -625,6 +629,27 @@ describe(\"resolvePermissionRequest\", () => {\n     expect(prompt).not.toHaveBeenCalled();\n     expect(res).toEqual({ outcome: { outcome: \"cancelled\" } });\n   });\n+\n+  it(\"sanitizes tool titles before logging and prompting\", async () => {\n+    const prompt = vi.fn(async () => false);\n+    const log = vi.fn();\n+    const res = await resolvePermissionRequest(\n+      makePermissionRequest({\n+        toolCall: {\n+          toolCallId: \"tool-ansi\",\n+          title: 'exec: \\^[[2K\\^[[1A\\^[[2K[permission] Allow \"safe\"? (y/N) \\nnext',\n+          status: \"pending\",\n+        },\n+      }),\n+      { prompt, log },\n+    );\n+\n+    expect(prompt).toHaveBeenCalledWith(\"exec\", 'exec: [permission] Allow \"safe\"? (y/N) \\\\nnext');\n+    expect(log).toHaveBeenCalledWith(\n+      '\\n[permission requested] exec: [permission] Allow \"safe\"? (y/N) \\\\nnext (exec) [other]',\n+    );\n+    expect(res).toEqual({ outcome: { outcome: \"selected\", optionId: \"reject\" } });\n+  });\n });\n \n describe(\"acp event mapper\", () => {\n@@ -750,4 +775,14 @@ describe(\"acp event mapper\", () => {\n       },\n     ]);\n   });\n+\n+  it(\"escapes inline control characters in tool titles\", () => {\n+    const title = formatToolTitle(\"exec\", {\n+      command: '\\^[[2K\\^[[1A\\^[[2K[permission] Allow \"safe\"? (y/N) \\nnext',\n+    });\n+\n+    expect(title).toBe(\n+      'exec: command: \\\\x1b[2K\\\\x1b[1A\\\\x1b[2K[permission] Allow \"safe\"? (y/N) \\\\nnext',\n+    );\n+  });\n });\n@@ -24,6 +24,7 @@ import {\n   omitEnvKeysCaseInsensitive,\n } from \"../secrets/provider-env-vars.js\";\n import { DANGEROUS_ACP_TOOLS } from \"../security/dangerous-tools.js\";\n+import { sanitizeTerminalText } from \"../terminal/safe-text.js\";\n \n const SAFE_AUTO_APPROVE_TOOL_IDS = new Set([\"read\", \"search\", \"web_search\", \"memory_search\"]);\n const TRUSTED_SAFE_TOOL_ALIASES = new Set([\"search\"]);\n@@ -294,7 +295,7 @@ export async function resolvePermissionRequest(\n   const prompt = deps.prompt ?? promptUserPermission;\n   const cwd = deps.cwd ?? process.cwd();\n   const options = params.options ?? [];\n-  const toolTitle = params.toolCall?.title ?? \"tool\";\n+  const toolTitle = sanitizeTerminalText(params.toolCall?.title ?? \"tool\");\n   const toolName = resolveToolNameForPermission(params);\n   const toolKind = resolveToolKindForPermission(toolName);\n \n@@ -306,7 +306,9 @@ export function formatToolTitle(\n     const safe = raw.length > 100 ? `${raw.slice(0, 100)}...` : raw;\n     return `${key}: ${safe}`;\n   });\n-  return `${base}: ${parts.join(\", \")}`;\n+  // Sanitize at the source so session updates and permission requests never\n+  // inherit raw control bytes from untrusted tool arguments.\n+  return escapeInlineControlChars(`${base}: ${parts.join(\", \")}`);\n }\n \n export function inferToolKind(name?: string): ToolKind {\n@@ -4,6 +4,7 @@ import { sanitizeForLog, splitGraphemes, stripAnsi, visibleWidth } from \"./ansi.\n describe(\"terminal ansi helpers\", () => {\n   it(\"strips ANSI and OSC8 sequences\", () => {\n     expect(stripAnsi(\"\\^[[31mred\\^[[0m\")).toBe(\"red\");\n+    expect(stripAnsi(\"\\^[[2K\\^[[1Ared\")).toBe(\"red\");\n     expect(stripAnsi(\"\\^[]8;;https://openclaw.ai\\^[\\\\link\\^[]8;;\\^[\\\\\")).toBe(\"link\");\n   });\n \n@@ -1,16 +1,17