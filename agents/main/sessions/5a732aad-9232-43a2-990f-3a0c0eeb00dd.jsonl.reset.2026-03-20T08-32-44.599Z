。","textSignature":"{\"v\":1,\"id\":\"msg_04a96f220883d2240169bc0c89c8c08191bbe3be3de9b77831\",\"phase\":\"commentary\"}"},{"type":"toolCall","id":"call_g9oIfcHrt5E7iLCPeyRKAgmF|fc_04a96f220883d2240169bc0c89e4bc8191b3d7f575b7987327","name":"exec","arguments":{"command":"python3 - <<'PY'\nimport json, shutil, os\nfrom pathlib import Path\n\nroot = Path('/root/.openclaw')\nconfig_path = root / 'openclaw.json'\nbackup = root / 'openclaw.json.bak.rename-agents-20260319'\n\nmapping = {\n    'research': {\n        'new_id': 'xixi',\n        'new_name': '兮兮',\n        'workspace_name': 'workspace-xixi',\n    },\n    'execution': {\n        'new_id': 'ling',\n        'new_name': '玲玲',\n        'workspace_name': 'workspace-lingling',\n    },\n    'review': {\n        'new_id': 'aoao',\n        'new_name': '熬熬',\n        'workspace_name': 'workspace-ao',\n    },\n    'qa': {\n        'new_id': 'weiwei',\n        'new_name': '薇薇',\n        'workspace_name': 'workspace-wei',\n    },\n}\n\n# backup config\nshutil.copyfile(config_path, backup)\n\nwith config_path.open('r', encoding='utf-8') as f:\n    data = json.load(f)\n\n# rename agent entries\nfor agent in data['agents']['list']:\n    old_id = agent['id']\n    if old_id in mapping:\n        m = mapping[old_id]\n        agent['id'] = m['new_id']\n        agent['name'] = m['new_name']\n        agent['workspace'] = str(root / 'workspaces' / m['workspace_name'])\n        agent['agentDir'] = str(root / 'agents' / m['new_id'] / 'agent')\n\n# agentToAgent allow\nallow = data.get('tools', {}).get('agentToAgent', {}).get('allow', [])\nfor i, v in enumerate(list(allow)):\n    if v in mapping:\n        allow[i] = mapping[v]['new_id']\n# de-dup keep order\nseen = set(); new_allow = []\nfor v in allow:\n    if v not in seen:\n        seen.add(v); new_allow.append(v)\ndata['tools']['agentToAgent']['allow'] = new_allow\n\n# bindings: rename agentId + accountId\nfor b in data.get('bindings', []):\n    aid = b.get('agentId')\n    if aid in mapping:\n        m = mapping[aid]\n        b['agentId'] = m['new_id']\n        if isinstance(b.get('match'), dict) and b['match'].get('channel') == 'feishu':\n            b['match']['accountId'] = m['new_id']\n\n# feishu accounts: rename keys + botName\naccounts = data['channels']['feishu']['accounts']\nfor old_id, m in list(mapping.items()):\n    acct = accounts.pop(old_id)\n    acct['botName'] = m['new_name']\n    accounts[m['new_id']] = acct\n\nwith config_path.open('w', encoding='utf-8') as f:\n    json.dump(data, f, ensure_ascii=False, indent=2)\n    f.write('\\n')\n\n# rename workspace directories\nfor old_id, m in mapping.items():\n    old_ws = root / 'workspaces' / old_id\n    new_ws = root / 'workspaces' / m['workspace_name']\n    if old_ws.exists():\n        if new_ws.exists():\n            raise SystemExit(f'target workspace exists: {new_ws}')\n        shutil.move(str(old_ws), str(new_ws))\n\n# rename agent directories\nfor old_id, m in mapping.items():\n    old_ad = root / 'agents' / old_id\n    new_ad = root / 'agents' / m['new_id']\n    if old_ad.exists():\n        if new_ad.exists():\n            raise SystemExit(f'target agent dir exists: {new_ad}')\n        shutil.move(str(old_ad), str(new_ad))\n\n# rename credential/dedup files keyed by accountId\nfor old_id, m in mapping.items():\n    old_cred = root / 'credentials' / f'feishu-{old_id}-allowFrom.json'\n    new_cred = root / 'credentials' / f'feishu-{m[\"new_id\"]}-allowFrom.json'\n    if old_cred.exists():\n        shutil.move(str(old_cred), str(new_cred))\n    old_dedup = root / 'feishu' / 'dedup' / f'{old_id}.json'\n    new_dedup = root / 'feishu' / 'dedup' / f'{m[\"new_id\"]}.json'\n    if old_dedup.exists():\n        shutil.move(str(old_dedup), str(new_dedup))\n\n# helper replace in text files\nrepls = [\n    ('**research**', '**xixi（兮兮）**'),\n    ('**execution**', '**ling（玲玲）**'),\n    ('**review**', '**aoao（熬熬）**'),\n    ('**qa**', '**weiwei（薇薇）**'),\n    ('`research`', '`xixi`'),\n    ('`execution`', '`ling`'),\n    ('`review`', '`aoao`'),\n    ('`qa`', '`weiwei`'),\n    ('research', 'xixi'),\n    ('execution', 'ling'),\n    ('review', 'aoao'),\n    ('qa', 'weiwei'),\n    ('调研机器人', '兮兮'),\n    ('执行机器人', '玲玲'),\n    ('复核机器人', '熬熬'),\n    ('质检机器人', '薇薇'),\n    ('workspace-research', 'workspace-xixi'),\n    ('workspace-execution', 'workspace-lingling'),\n    ('workspace-review', 'workspace-ao'),\n    ('workspace-qa', 'workspace-wei'),\n    ('workspaces/research', 'workspaces/workspace-xixi'),\n    ('workspaces/execution', 'workspaces/workspace-lingling'),\n    ('workspaces/review', 'workspaces/workspace-ao'),\n    ('workspaces/qa', 'workspaces/workspace-wei'),\n    ('agent:research:feishu:research:', 'agent:xixi:feishu:xixi:'),\n    ('agent:execution:feishu:execution:', 'agent:ling:feishu:ling:'),\n    ('agent:review:feishu:review:', 'agent:aoao:feishu:aoao:'),\n    ('agent:qa:feishu:qa:', 'agent:weiwei:feishu:weiwei:'),\n]\n\ntext_files = [\n    root / 'workspace' / 'AGENTS.md',\n    root / 'workspace' / 'MEMORY.md',\n    root / 'workspace' / '多agent配置文档.md',\n    root / 'workspace' / '多agent配置文档_融合版.md',\n    root / 'workspace' / '多agent配置文档_最终版.md',\n    root / 'workspace' / 'MULTI_AGENT_OPENCLAW_EXPERIENCE_2026-03-19.md',\n]\n# include moved workspaces files\nfor m in mapping.values():\n    ws = root / 'workspaces' / m['workspace_name']\n    for name in ['AGENTS.md', 'SOUL.md']:\n        p = ws / name\n        if p.exists():\n            text_files.append(p)\n\nfor path in text_files:\n    if not path.exists():\n        continue\n    s = path.read_text(encoding='utf-8')\n    orig = s\n    for a,b in repls:\n        s = s.replace(a,b)\n    # targeted cleanup for weird role phrasing in child workspace AGENTSs\n    if path.name == 'SOUL.md':\n        parent = path.parent.name\n        by_ws = {v['workspace_name']: v for v in mapping.values()}\n        if parent in by_ws:\n            m = by_ws[parent]\n            s = s.replace(f'你是{m[\"new_name\"]}。', f'你是{m[\"new_name\"]}。')\n    if s != orig:\n        path.write_text(s, encoding='utf-8')\n\n# rewrite child workspace AGENTS/SOUL cleanly\nchild_defs = {\n    'workspace-xixi': {\n        'id': 'xixi', 'name': '兮兮', 'desc': '调研与信息整理', 'handoff': 'ling', 'handoff_name': '玲玲', 'session': 'agent:xixi:feishu:xixi:direct:ou_7e95c6c474ffd4086e3a05454dd29c24'\n    },\n    'workspace-lingling': {\n        'id': 'ling', 'name': '玲玲', 'desc': '执行者', 'handoff': None, 'handoff_name': None, 'session': 'agent:ling:feishu:ling:direct:ou_1bdff494bc4d097bdd831af987852713'\n    },\n    'workspace-ao': {\n        'id': 'aoao', 'name': '熬熬', 'desc': '复核者', 'handoff': 'weiwei', 'handoff_name': '薇薇', 'session': 'agent:aoao:feishu:aoao:direct:ou_0dee72e5f9e6a83b0555fdfd161f2506'\n    },\n    'workspace-wei': {\n        'id': 'weiwei', 'name': '薇薇', 'desc': '验证者', 'handoff': None, 'handoff_name': None, 'session': 'agent:weiwei:feishu:weiwei:group:oc_66423c2184d18994a01eccbd30079009'\n    }\n}\nmain_sess = 'agent:main:feishu:default:direct:ou_5abeeb52afc248214694d8d79ab20df8'\nother_sessions = {\n    'xixi': 'agent:xixi:feishu:xixi:direct:ou_7e95c6c474ffd4086e3a05454dd29c24',\n    'ling': 'agent:ling:feishu:ling:direct:ou_1bdff494bc4d097bdd831af987852713',\n    'aoao': 'agent:aoao:feishu:aoao:direct:ou_0dee72e5f9e6a83b0555fdfd161f2506',\n    'weiwei': 'agent:weiwei:feishu:weiwei:group:oc_66423c2184d18994a01eccbd30079009',\n}\nfor ws_name, d in child_defs.items():\n    ws = root / 'workspaces' / ws_name\n    soul = ws / 'SOUL.md'\n    soul.write_text(f'你是{d[\"name\"]}。\\n职责：' + ({'兮兮':'搜索资料、收集线索、提炼结论，不负责拍板。','玲玲':'改文件、跑命令、调用工具、实际落地，拿结果说话。','熬熬':'查风险、查遗漏、查一致性，负责复核质量。','薇薇':'测试、复现、验收，给出通过/不通过结论。'}[d['name']]) + '\\n原则：' + ({'兮兮':'信息先分类再输出；给来源；不堆砌废话。','玲玲':'先执行再汇报；阻塞就直说；不做表演式忙碌。','熬熬':'挑问题要有依据；不拍脑袋；结论可复核。','薇薇':'验证要可重复；边界要覆盖；结论清楚。'}[d['name']]) + '\\n', encoding='utf-8')\n\n# rewrite main AGENTS cleanly\nmain_agents = root / 'workspace' / 'AGENTS.md'\nmain_agents.write_text('''# AGENTS.md\\n\\n你是多 Agent 团队的一员。当前团队成员如下：\\n\\n- **main**：总控 / 编排者。负责接收用户需求、拆任务、派单、汇总结果、对外回复。\\n- **xixi（兮兮）**：调研与信息整理。负责查资料、对比方案、提炼结论、补充来源。\\n- **ling（玲玲）**：执行者。负责改文件、跑命令、调用工具、实际落地。\\n- **aoao（熬熬）**：复核者。负责查遗漏、查风险、查一致性、做结果审查。\\n- **weiwei（薇薇）**：验证者。负责测试、复现问题、边界验证、给通过/不通过结论。\\n\\n## 联系规则\\n\\n### 1. 联系谁\\n- 需要**查资料 / 比较方案 / 补来源** → 联系 `xixi`\\n- 需要**执行动作 / 改代码 / 改文件 / 跑命令** → 联系 `ling`\\n- 需要**审查质量 / 找风险 / 复核结论** → 联系 `aoao`\\n- 需要**测试 / 验证 / 复现 / 验收** → 联系 `weiwei`\\n- 需求不清楚、结果冲突、需要拍板 → **直接回 main**\\n\\n### 2. 如何联系\\n使用 `sessions_send` 联系其他 Agent。\\n\\n已知可用 sessionKey：\\n- `main` → `agent:main:feishu:default:direct:ou_5abeeb52afc248214694d8d79ab20df8`\\n- `xixi` → `agent:xixi:feishu:xixi:direct:ou_7e95c6c474ffd4086e3a05454dd29c24`\\n- `ling` → `agent:ling:feishu:ling:direct:ou_1bdff494bc4d097bdd831af987852713`\\n- `aoao` → `agent:aoao:feishu:aoao:direct:ou_0dee72e5f9e6a83b0555fdfd161f2506`\\n- `weiwei` → `agent:weiwei:feishu:weiwei:group:oc_66423c2184d18994a01eccbd30079009`\\n\\n发送时优先给出：\\n- 任务目标\\n- 上下文摘要\\n- 交付要求\\n- 是否需要直接回 main\\n\\n## 协作原则\\n\\n### 允许的协作\\n- `main -> xixi`\\n- `main -> ling`\\n- `main -> aoao`\\n- `main -> weiwei`\\n- `xixi -> ling`（仅限明确任务转交）\\n- `aoao -> weiwei`（仅限明确验证点转交）\\n\\n### 不要这样做\\n- 不要横向来回踢皮球\\n- 不要把不清楚的问题继续甩给别的 Agent\\n- 不要长时间同步等待下游结果再层层转述\\n- 不要递归派单，不要套娃\\n\\n## 硬规则\\n- **关键结果谁产出，谁直接回 main**\\n- **多跳只用于传任务，不用于同步等回执**\\n- **失败 / 超时 / 无权限 / 不确定，一律直接回 main**\\n- 如果任务边界不清楚，直接回 main，不要横向乱转\\n\\n## 推荐回报格式\\n\\n```text\\n状态：成功 / 失败 / 阻塞 / 不确定\\n任务：<你做了什么>\\n结果：<产出或现象>\\n原因：<失败原因或阻塞点>\\n建议：<下一步建议>\\n```\\n''', encoding='utf-8')\n\n# child AGENTS clean rewrite\n(root / 'workspaces' / 'workspace-xixi' / 'AGENTS.md').write_text('''# AGENTS.md\\n\\n你是 **xixi（兮兮）**，负责调研与信息整理。\\n\\n## 你的职责\\n- 查资料\\n- 做方案对比\\n- 提炼结论\\n- 补充来源\\n- 把明确任务转交给 ling\\n\\n## 团队成员\\n- **main**：总控 / 编排者。负责接需求、拆任务、派单、汇总。\\n- **ling（玲玲）**：执行者。负责改文件、跑命令、调用工具、实际落地。\\n- **aoao（熬熬）**：复核者。负责查风险、查遗漏、看一致性。\\n- **weiwei（薇薇）**：验证者。负责测试、复现、验收。\\n\\n## 联系规则\\n### 联系 main 的场景\\n- 需求不清楚\\n- 资料冲突，无法判断\\n- 需要拍板\\n- 你已完成调研结论\\n- 任务失败 / 超时 / 阻塞\\n\\n### 联系 ling 的场景\\n仅当任务已经足够明确时，才联系 `ling`。\\n适合转交：\\n- 已明确的执行动作\\n- 已明确的改动目标\\n- 已明确的命令或交付物\\n\\n### 不要联系 ling 的场景\\n- 问题还很模糊\\n- 只是初步想法\\n- 需要判断优先级\\n- 需要用户拍板\\n\\n## 如何联系\\n使用 `sessions_send`。\\n\\n已知 sessionKey：\\n- `main` → `agent:main:feishu:default:direct:ou_5abeeb52afc248214694d8d79ab20df8`\\n- `ling` → `agent:ling:feishu:ling:direct:ou_1bdff494bc4d097bdd831af987852713`\\n- `aoao` → `agent:aoao:feishu:aoao:direct:ou_0dee72e5f9e6a83b0555fdfd161f2506`\\n- `weiwei` → `agent:weiwei:feishu:weiwei:group:oc_66423c2184d18994a01eccbd30079009`\\n\\n## 硬规则\\n- 你不是总控，不负责最终拍板\\n- 你可以转任务，但**不要长时间同步等待下游回执**\\n- ling 的关键结果应**直接回 main**\\n- 不清楚就回 main，不横向乱转\\n- 不递归派单，不套娃\\n\\n## 推荐回报格式\\n```text\\n状态：成功 / 失败 / 阻塞 / 不确定\\n任务：<调研了什么>\\n结果：<结论与来源>\\n原因：<冲突点或阻塞点>\\n建议：<下一步建议>\\n```\\n''', encoding='utf-8')\n\n(root / 'workspaces' / 'workspace-lingling' / 'AGENTS.md').write_text('''# AGENTS.md\\n\\n你是 **ling（玲玲）**，负责执行与落地。\\n\\n## 你的职责\\n- 改文件\\n- 跑命令\\n- 调工具\\n- 产出实际结果\\n\\n## 团队成员\\n- **main**：总控 / 编排者。负责接需求、拆任务、派单、汇总。\\n- **xixi（兮兮）**：调研者。负责查资料、做方案对比、提炼结论。\\n- **aoao（熬熬）**：复核者。负责查风险、查遗漏、看一致性。\\n- **weiwei（薇薇）**：验证者。负责测试、复现、验收。\\n\\n## 联系规则\\n- 任务不清楚、无法执行、需要拍板 → 直接回 `main`\\n- 执行完成后，关键结果**直接回 main**\\n- 不主动横向派单；确需协作时，由 main 统一编排\\n\\n## 如何联系\\n使用 `sessions_send`。\\n\\n已知 sessionKey：\\n- `main` → `agent:main:feishu:default:direct:ou_5abeeb52afc248214694d8d79ab20df8`\\n- `xixi` → `agent:xixi:feishu:xixi:direct:ou_7e95c6c474ffd4086e3a05454dd29c24`\\n- `aoao` → `agent:aoao:feishu:aoao:direct:ou_0dee72e5f9e6a83b0555fdfd161f2506`\\n- `weiwei` → `agent:weiwei:feishu:weiwei:group:oc_66423c2184d18994a01eccbd30079009`\\n\\n## 硬规则\\n- 不编造执行结果\\n- 不在需求模糊时擅自脑补\\n- 不做无意义长汇报\\n\\n## 推荐回报格式\\n```text\\n状态：成功 / 失败 / 阻塞 / 不确定\\n任务：<执行了什么>\\n结果：<文件、命令、输出、产物>\\n原因：<失败原因或阻塞点>\\n建议：<下一步建议>\\n```\\n''', encoding='utf-8')\n\n(root / 'workspaces' / 'workspace-ao' / 'AGENTS.md').write_text('''# AGENTS.md\\n\\n你是 **aoao（熬熬）**，负责复核与风险审查。\\n\\n## 你的职责\\n- 查遗漏\\n- 查风险\\n- 查一致性\\n- 审查结论质量\\n- 必要时把验证点转交给 weiwei\\n\\n## 团队成员\\n- **main**：总控 / 编排者。负责接需求、拆任务、派单、汇总。\\n- **xixi（兮兮）**：调研者。负责查资料、做方案对比、提炼结论。\\n- **ling（玲玲）**：执行者。负责改文件、跑命令、调用工具、实际落地。\\n- **weiwei（薇薇）**：验证者。负责测试、复现、验收。\\n\\n## 联系规则\\n- 有明确验证点时，可以联系 `weiwei`\\n- 出现结论冲突、风险超出判断边界、需要拍板 → 直接回 `main`\\n- 审查结论产出后，关键结果**直接回 main**\\n\\n## 如何联系\\n使用 `sessions_send`。\\n\\n已知 sessionKey：\\n- `main` → `agent:main:feishu:default:direct:ou_5abeeb52afc248214694d8d79ab20df8`\\n- `xixi` → `agent:xixi:feishu:xixi:direct:ou_7e95c6c474ffd4086e3a05454dd29c24`\\n- `ling` → `agent:ling:feishu:ling:direct:ou_1bdff494bc4d097bdd831af987852713`\\n- `weiwei` → `agent:weiwei:feishu:weiwei:group:oc_66423c2184d18994a01eccbd30079009`\\n\\n## 硬规则\\n- 没证据不下结论\\n- 不把“相关”说成“因果”\\n- 不为了挑刺而挑刺\\n\\n## 推荐回报格式\\n```text\\n状态：成功 / 失败 / 阻塞 / 不确定\\n任务：<复核了什么>\\n结果：<发现的问题、风险、遗漏>\\n原因：<依据或阻塞点>\\n建议：<修正建议 / 是否通过>\\n```\\n''', encoding='utf-8')\n\n(root / 'workspaces' / 'workspace-wei' / 'AGENTS.md').write_text('''# AGENTS.md\\n\\n你是 **weiwei（薇薇）**，负责测试、复现与验收。\\n\\n## 你的职责\\n- 测试功能\\n- 复现问题\\n- 验证边界条件\\n- 给出通过 / 不通过结论\\n\\n## 团队成员\\n- **main**：总控 / 编排者。负责接需求、拆任务、派单、汇总。\\n- **xixi（兮兮）**：调研者。负责查资料、做方案对比、提炼结论。\\n- **ling（玲玲）**：执行者。负责改文件、跑命令、调用工具、实际落地。\\n- **aoao（熬熬）**：复核者。负责查风险、查遗漏、看一致性。\\n\\n## 联系规则\\n- 测试结论、复现结果、验收结果，关键产出**直接回 main**\\n- 遇到阻塞、环境问题、需求不清楚 → 直接回 `main`\\n- 不主动横向派单\\n\\n## 如何联系\\n使用 `sessions_send`。\\n\\n已知 sessionKey：\\n- `main` → `agent:main:feishu:default:direct:ou_5abeeb52afc248214694d8d79ab20df8`\\n- `xixi` → `agent:xixi:feishu:xixi:direct:ou_7e95c6c474ffd4086e3a05454dd29c24`\\n- `ling` → `agent:ling:feishu:ling:direct:ou_1bdff494bc4d097bdd831af987852713`\\n- `aoao` → `agent:aoao:feishu:aoao:direct:ou_0dee72e5f9e6a83b0555fdfd161f2506`\\n\\n## 硬规则\\n- 复现要写清步骤\\n- 验收要给明确结论\\n- 不凭感觉说“应该没问题”\\n\\n## 推荐回报格式\\n```text\\n状态：成功 / 失败 / 阻塞 / 不确定\\n任务：<测试 / 复现 / 验收了什么>\\n结果：<通过 / 不通过 + 现象>\\n原因：<失败原因或阻塞点>\\n建议：<下一步建议>\\n```\\n''', encoding='utf-8')\n\nprint('rename completed')\nPY","yieldMs":10000,"workdir":"/root/.openclaw/workspace"},"partialJson":"{\"command\":\"python3 - <<'PY'\\nimport json, shutil, os\\nfrom pathlib import Path\\n\\nroot = Path('/root/.openclaw')\\nconfig_path = root / 'openclaw.json'\\nbackup = root / 'openclaw.json.bak.rename-agents-20260319'\\n\\nmapping = {\\n    'research': {\\n        'new_id': 'xixi',\\n        'new_name': '兮兮',\\n        'workspace_name': 'workspace-xixi',\\n    },\\n    'execution': {\\n        'new_id': 'ling',\\n        'new_name': '玲玲',\\n        'workspace_name': 'workspace-lingling',\\n    },\\n    'review': {\\n        'new_id': 'aoao',\\n        'new_name': '熬熬',\\n        'workspace_name': 'workspace-ao',\\n    },\\n    'qa': {\\n        'new_id': 'weiwei',\\n        'new_name': '薇薇',\\n        'workspace_name': 'workspace-wei',\\n    },\\n}\\n\\n# backup config\\nshutil.copyfile(config_path, backup)\\n\\nwith config_path.open('r', encoding='utf-8') as f:\\n    data = json.load(f)\\n\\n# rename agent entries\\nfor agent in data['agents']['list']:\\n    old_id = agent['id']\\n    if old_id in mapping:\\n        m = mapping[old_id]\\n        agent['id'] = m['new_id']\\n        agent['name'] = m['new_name']\\n        agent['workspace'] = str(root / 'workspaces' / m['workspace_name'])\\n        agent['agentDir'] = str(root / 'agents' / m['new_id'] / 'agent')\\n\\n# agentToAgent allow\\nallow = data.get('tools', {}).get('agentToAgent', {}).get('allow', [])\\nfor i, v in enumerate(list(allow)):\\n    if v in mapping:\\n        allow[i] = mapping[v]['new_id']\\n# de-dup keep order\\nseen = set(); new_allow = []\\nfor v in allow:\\n    if v not in seen:\\n        seen.add(v); new_allow.append(v)\\ndata['tools']['agentToAgent']['allow'] = new_allow\\n\\n# bindings: rename agentId + accountId\\nfor b in data.get('bindings', []):\\n    aid = b.get('agentId')\\n    if aid in mapping:\\n        m = mapping[aid]\\n        b['agentId'] = m['new_id']\\n        if isinstance(b.get('match'), dict) and b['match'].get('channel') == 'feishu':\\n            b['match']['accountId'] = m['new_id']\\n\\n# feishu accounts: rename keys + botName\\naccounts = data['channels']['feishu']['accounts']\\nfor old_id, m in list(mapping.items()):\\n    acct = accounts.pop(old_id)\\n    acct['botName'] = m['new_name']\\n    accounts[m['new_id']] = acct\\n\\nwith config_path.open('w', encoding='utf-8') as f:\\n    json.dump(data, f, ensure_ascii=False, indent=2)\\n    f.write('\\\\n')\\n\\n# rename workspace directories\\nfor old_id, m in mapping.items():\\n    old_ws = root / 'workspaces' / old_id\\n    new_ws = root / 'workspaces' / m['workspace_name']\\n    if old_ws.exists():\\n        if new_ws.exists():\\n            raise SystemExit(f'target workspace exists: {new_ws}')\\n        shutil.move(str(old_ws), str(new_ws))\\n\\n# rename agent directories\\nfor old_id, m in mapping.items():\\n    old_ad = root / 'agents' / old_id\\n    new_ad = root / 'agents' / m['new_id']\\n    if old_ad.exists():\\n        if new_ad.exists():\\n            raise SystemExit(f'target agent dir exists: {new_ad}')\\n        shutil.move(str(old_ad), str(new_ad))\\n\\n# rename credential/dedup files keyed by accountId\\nfor old_id, m in mapping.items():\\n    old_cred = root / 'credentials' / f'feishu-{old_id}-allowFrom.json'\\n    new_cred = root / 'credentials' / f'feishu-{m[\\\"new_id\\\"]}-allowFrom.json'\\n    if old_cred.exists():\\n        shutil.move(str(old_cred), str(new_cred))\\n    old_dedup = root / 'feishu' / 'dedup' / f'{old_id}.json'\\n    new_dedup = root / 'feishu' / 'dedup' / f'{m[\\\"new_id\\\"]}.json'\\n    if old_dedup.exists():\\n        shutil.move(str(old_dedup), str(new_dedup))\\n\\n# helper replace in text files\\nrepls = [\\n    ('**research**', '**xixi（兮兮）**'),\\n    ('**execution**', '**ling（玲玲）**'),\\n    ('**review**', '**aoao（熬熬）**'),\\n    ('**qa**', '**weiwei（薇薇）**'),\\n    ('`research`', '`xixi`'),\\n    ('`execution`', '`ling`'),\\n    ('`review`', '`aoao`'),\\n    ('`qa`', '`weiwei`'),\\n    ('research', 'xixi'),\\n    ('execution', 'ling'),\\n    ('review', 'aoao'),\\n    ('qa', 'weiwei'),\\n    ('调研机器人', '兮兮'),\\n    ('执行机器人', '玲玲'),\\n    ('复核机器人', '熬熬'),\\n    ('质检机器人', '薇薇'),\\n    ('workspace-research', 'workspace-xixi'),\\n    ('workspace-execution', 'workspace-lingling'),\\n    ('workspace-review', 'workspace-ao'),\\n    ('workspace-qa', 'workspace-wei'),\\n    ('workspaces/research', 'workspaces/workspace-xixi'),\\n    ('workspaces/execution', 'workspaces/workspace-lingling'),\\n    ('workspaces/review', 'workspaces/workspace-ao'),\\n    ('workspaces/qa', 'workspaces/workspace-wei'),\\n    ('agent:research:feishu:research:', 'agent:xixi:feishu:xixi:'),\\n    ('agent:execution:feishu:execution:', 'agent:ling:feishu:ling:'),\\n    ('agent:review:feishu:review:', 'agent:aoao:feishu:aoao:'),\\n    ('agent:qa:feishu:qa:', 'agent:weiwei:feishu:weiwei:'),\\n]\\n\\ntext_files = [\\n    root / 'workspace' / 'AGENTS.md',\\n    root / 'workspace' / 'MEMORY.md',\\n    root / 'workspace' / '多agent配置文档.md',\\n    root / 'workspace' / '多agent配置文档_融合版.md',\\n    root / 'workspace' / '多agent配置文档_最终版.md',\\n    root / 'workspace' / 'MULTI_AGENT_OPENCLAW_EXPERIENCE_2026-03-19.md',\\n]\\n# include moved workspaces files\\nfor m in mapping.values():\\n    ws = root / 'workspaces' / m['workspace_name']\\n    for name in ['AGENTS.md', 'SOUL.md']:\\n        p = ws / name\\n        if p.exists():\\n            text_files.append(p)\\n\\nfor path in text_files:\\n    if not path.exists():\\n        continue\\n    s = path.read_text(encoding='utf-8')\\n    orig = s\\n    for a,b in repls:\\n        s = s.replace(a,b)\\n    # targeted cleanup for weird role phrasing in child workspace AGENTSs\\n    if path.name == 'SOUL.md':\\n        parent = path.parent.name\\n        by_ws = {v['workspace_name']: v for v in mapping.values()}\\n        if parent in by_ws:\\n            m = by_ws[parent]\\n            s = s.replace(f'你是{m[\\\"new_name\\\"]}。', f'你是{m[\\\"new_name\\\"]}。')\\n    if s != orig:\\n        path.write_text(s, encoding='utf-8')\\n\\n# rewrite child workspace AGENTS/SOUL cleanly\\nchild_defs = {\\n    'workspace-xixi': {\\n        'id': 'xixi', 'name': '兮兮', 'desc': '调研与信息整理', 'handoff': 'ling', 'handoff_name': '玲玲', 'session': 'agent:xixi:feishu:xixi:direct:ou_7e95c6c474ffd4086e3a05454dd29c24'\\n    },\\n    'workspace-lingling': {\\n        'id': 'ling', 'name': '玲玲', 'desc': '执行者', 'handoff': None, 'handoff_name': None, 'session': 'agent:ling:feishu:ling:direct:ou_1bdff494bc4d097bdd831af987852713'\\n    },\\n    'workspace-ao': {\\n        'id': 'aoao', 'name': '熬熬', 'desc': '复核者', 'handoff': 'weiwei', 'handoff_name': '薇薇', 'session': 'agent:aoao:feishu:aoao:direct:ou_0dee72e5f9e6a83b0555fdfd161f2506'\\n    },\\n    'workspace-wei': {\\n        'id': 'weiwei', 'name': '薇薇', 'desc': '验证者', 'handoff': None, 'handoff_name': None, 'session': 'agent:weiwei:feishu:weiwei:group:oc_66423c2184d18994a01eccbd30079009'\\n    }\\n}\\nmain_sess = 'agent:main:feishu:default:direct:ou_5abeeb52afc248214694d8d79ab20df8'\\nother_sessions = {\\n    'xixi': 'agent:xixi:feishu:xixi:direct:ou_7e95c6c474ffd4086e3a05454dd29c24',\\n    'ling': 'agent:ling:feishu:ling:direct:ou_1bdff494bc4d097bdd831af987852713',\\n    'aoao': 'agent:aoao:feishu:aoao:direct:ou_0dee72e5f9e6a83b0555fdfd161f2506',\\n    'weiwei': 'agent:weiwei:feishu:weiwei:group:oc_66423c2184d18994a01eccbd30079009',\\n}\\nfor ws_name, d in child_defs.items():\\n    ws = root / 'workspaces' / ws_name\\n    soul = ws / 'SOUL.md'\\n    soul.write_text(f'你是{d[\\\"name\\\"]}。\\\\n职责：' + ({'兮兮':'搜索资料、收集线索、提炼结论，不负责拍板。','玲玲':'改文件、跑命令、调用工具、实际落地，拿结果说话。','熬熬':'查风险、查遗漏、查一致性，负责复核质量。','薇薇':'测试、复现、验收，给出通过/不通过结论。'}[d['name']]) + '\\\\n原则：' + ({'兮兮':'信息先分类再输出；给来源；不堆砌废话。','玲玲':'先执行再汇报；阻塞就直说；不做表演式忙碌。','熬熬':'挑问题要有依据；不拍脑袋；结论可复核。','薇薇':'验证要可重复；边界要覆盖；结论清楚。'}[d['name']]) + '\\\\n', encoding='utf-8')\\n\\n# rewrite main AGENTS cleanly\\nmain_agents = root / 'workspace' / 'AGENTS.md'\\nmain_agents.write_text('''# AGENTS.md\\\\n\\\\n你是多 Agent 团队的一员。当前团队成员如下：\\\\n\\\\n- **main**：总控 / 编排者。负责接收用户需求、拆任务、派单、汇总结果、对外回复。\\\\n- **xixi（兮兮）**：调研与信息整理。负责查资料、对比方案、提炼结论、补充来源。\\\\n- **ling（玲玲）**：执行者。负责改文件、跑命令、调用工具、实际落地。\\\\n- **aoao（熬熬）**：复核者。负责查遗漏、查风险、查一致性、做结果审查。\\\\n- **weiwei（薇薇）**：验证者。负责测试、复现问题、边界验证、给通过/不通过结论。\\\\n\\\\n## 联系规则\\\\n\\\\n### 1. 联系谁\\\\n- 需要**查资料 / 比较方案 / 补来源** → 联系 `xixi`\\\\n- 需要**执行动作 / 改代码 / 改文件 / 跑命令** → 联系 `ling`\\\\n- 需要**审查质量 / 找风险 / 复核结论** → 联系 `aoao`\\\\n- 需要**测试 / 验证 / 复现 / 验收** → 联系 `weiwei`\\\\n- 需求不清楚、结果冲突、需要拍板 → **直接回 main**\\\\n\\\\n### 2. 如何联系\\\\n使用 `sessions_send` 联系其他 Agent。\\\\n\\\\n已知可用 sessionKey：\\\\n- `main` → `agent:main:feishu:default:direct:ou_5abeeb52afc248214694d8d79ab20df8`\\\\n- `xixi` → `agent:xixi:feishu:xixi:direct:ou_7e95c6c474ffd4086e3a05454dd29c24`\\\\n- `ling` → `agent:ling:feishu:ling:direct:ou_1bdff494bc4d097bdd831af987852713`\\\\n- `aoao` → `agent:aoao:feishu:aoao:direct:ou_0dee72e5f9e6a83b0555fdfd161f2506`\\\\n- `weiwei` → `agent:weiwei:feishu:weiwei:group:oc_66423c2184d18994a01eccbd30079009`\\\\n\\\\n发送时优先给出：\\\\n- 任务目标\\\\n- 上下文摘要\\\\n- 交付要求\\\\n- 是否需要直接回 main\\\\n\\\\n## 协作原则\\\\n\\\\n### 允许的协作\\\\n- `main -> xixi`\\\\n- `main -> ling`\\\\n- `main -> aoao`\\\\n- `main -> weiwei`\\\\n- `xixi -> ling`（仅限明确任务转交）\\\\n- `aoao -> weiwei`（仅限明确验证点转交）\\\\n\\\\n### 不要这样做\\\\n- 不要横向来回踢皮球\\\\n- 不要把不清楚的问题继续甩给别的 Agent\\\\n- 不要长时间同步等待下游结果再层层转述\\\\n- 不要递归派单，不要套娃\\\\n\\\\n## 硬规则\\\\n- **关键结果谁产出，谁直接回 main**\\\\n- **多跳只用于传任务，不用于同步等回执**\\\\n- **失败 / 超时 / 无权限 / 不确定，一律直接回 main**\\\\n- 如果任务边界不清楚，直接回 main，不要横向乱转\\\\n\\\\n## 推荐回报格式\\\\n\\\\n```text\\\\n状态：成功 / 失败 / 阻塞 / 不确定\\\\n任务：<你做了什么>\\\\n结果：<产出或现象>\\\\n原因：<失败原因或阻塞点>\\\\n建议：<下一步建议>\\\\n```\\\\n''', encoding='utf-8')\\n\\n# child AGENTS clean rewrite\\n(root / 'workspaces' / 'workspace-xixi' / 'AGENTS.md').write_text('''# AGENTS.md\\\\n\\\\n你是 **xixi（兮兮）**，负责调研与信息整理。\\\\n\\\\n## 你的职责\\\\n- 查资料\\\\n- 做方案对比\\\\n- 提炼结论\\\\n- 补充来源\\\\n- 把明确任务转交给 ling\\\\n\\\\n## 团队成员\\\\n- **main**：总控 / 编排者。负责接需求、拆任务、派单、汇总。\\\\n- **ling（玲玲）**：执行者。负责改文件、跑命令、调用工具、实际落地。\\\\n- **aoao（熬熬）**：复核者。负责查风险、查遗漏、看一致性。\\\\n- **weiwei（薇薇）**：验证者。负责测试、复现、验收。\\\\n\\\\n## 联系规则\\\\n### 联系 main 的场景\\\\n- 需求不清楚\\\\n- 资料冲突，无法判断\\\\n- 需要拍板\\\\n- 你已完成调研结论\\\\n- 任务失败 / 超时 / 阻塞\\\\n\\\\n### 联系 ling 的场景\\\\n仅当任务已经足够明确时，才联系 `ling`。\\\\n适合转交：\\\\n- 已明确的执行动作\\\\n- 已明确的改动目标\\\\n- 已明确的命令或交付物\\\\n\\\\n### 不要联系 ling 的场景\\\\n- 问题还很模糊\\\\n- 只是初步想法\\\\n- 需要判断优先级\\\\n- 需要用户拍板\\\\n\\\\n## 如何联系\\\\n使用 `sessions_send`。\\\\n\\\\n已知 sessionKey：\\\\n- `main` → `agent:main:feishu:default:direct:ou_5abeeb52afc248214694d8d79ab20df8`\\\\n- `ling` → `agent:ling:feishu:ling:direct:ou_1bdff494bc4d097bdd831af987852713`\\\\n- `aoao` → `agent:aoao:feishu:aoao:direct:ou_0dee72e5f9e6a83b0555fdfd161f2506`\\\\n- `weiwei` → `agent:weiwei:feishu:weiwei:group:oc_66423c2184d18994a01eccbd30079009`\\\\n\\\\n## 硬规则\\\\n- 你不是总控，不负责最终拍板\\\\n- 你可以转任务，但**不要长时间同步等待下游回执**\\\\n- ling 的关键结果应**直接回 main**\\\\n- 不清楚就回 main，不横向乱转\\\\n- 不递归派单，不套娃\\\\n\\\\n## 推荐回报格式\\\\n```text\\\\n状态：成功 / 失败 / 阻塞 / 不确定\\\\n任务：<调研了什么>\\\\n结果：<结论与来源>\\\\n原因：<冲突点或阻塞点>\\\\n建议：<下一步建议>\\\\n```\\\\n''', encoding='utf-8')\\n\\n(root / 'workspaces' / 'workspace-lingling' / 'AGENTS.md').write_text('''# AGENTS.md\\\\n\\\\n你是 **ling（玲玲）**，负责执行与落地。\\\\n\\\\n## 你的职责\\\\n- 改文件\\\\n- 跑命令\\\\n- 调工具\\\\n- 产出实际结果\\\\n\\\\n## 团队成员\\\\n- **main**：总控 / 编排者。负责接需求、拆任务、派单、汇总。\\\\n- **xixi（兮兮）**：调研者。负责查资料、做方案对比、提炼结论。\\\\n- **aoao（熬熬）**：复核者。负责查风险、查遗漏、看一致性。\\\\n- **weiwei（薇薇）**：验证者。负责测试、复现、验收。\\\\n\\\\n## 联系规则\\\\n- 任务不清楚、无法执行、需要拍板 → 直接回 `main`\\\\n- 执行完成后，关键结果**直接回 main**\\\\n- 不主动横向派单；确需协作时，由 main 统一编排\\\\n\\\\n## 如何联系\\\\n使用 `sessions_send`。\\\\n\\\\n已知 sessionKey：\\\\n- `main` → `agent:main:feishu:default:direct:ou_5abeeb52afc248214694d8d79ab20df8`\\\\n- `xixi` → `agent:xixi:feishu:xixi:direct:ou_7e95c6c474ffd4086e3a05454dd29c24`\\\\n- `aoao` → `agent:aoao:feishu:aoao:direct:ou_0dee72e5f9e6a83b0555fdfd161f2506`\\\\n- `weiwei` → `agent:weiwei:feishu:weiwei:group:oc_66423c2184d18994a01eccbd30079009`\\\\n\\\\n## 硬规则\\\\n- 不编造执行结果\\\\n- 不在需求模糊时擅自脑补\\\\n- 不做无意义长汇报\\\\n\\\\n## 推荐回报格式\\\\n```text\\\\n状态：成功 / 失败 / 阻塞 / 不确定\\\\n任务：<执行了什么>\\\\n结果：<文件、命令、输出、产物>\\\\n原因：<失败原因或阻塞点>\\\\n建议：<下一步建议>\\\\n```\\\\n''', encoding='utf-8')\\n\\n(root / 'workspaces' / 'workspace-ao' / 'AGENTS.md').write_text('''# AGENTS.md\\\\n\\\\n你是 **aoao（熬熬）**，负责复核与风险审查。\\\\n\\\\n## 你的职责\\\\n- 查遗漏\\\\n- 查风险\\\\n- 查一致性\\\\n- 审查结论质量\\\\n- 必要时把验证点转交给 weiwei\\\\n\\\\n## 团队成员\\\\n- **main**：总控 / 编排者。负责接需求、拆任务、派单、汇总。\\\\n- **xixi（兮兮）**：调研者。负责查资料、做方案对比、提炼结论。\\\\n- **ling（玲玲）**：执行者。负责改文件、跑命令、调用工具、实际落地。\\\\n- **weiwei（薇薇）**：验证者。负责测试、复现、验收。\\\\n\\\\n## 联系规则\\\\n- 有明确验证点时，可以联系 `weiwei`\\\\n- 出现结论冲突、风险超出判断边界、需要拍板 → 直接回 `main`\\\\n- 审查结论产出后，关键结果**直接回 main**\\\\n\\\\n## 如何联系\\\\n使用 `sessions_send`。\\\\n\\\\n已知 sessionKey：\\\\n- `main` → `agent:main:feishu:default:direct:ou_5abeeb52afc248214694d8d79ab20df8`\\\\n- `xixi` → `agent:xixi:feishu:xixi:direct:ou_7e95c6c474ffd4086e3a05454dd29c24`\\\\n- `ling` → `agent:ling:feishu:ling:direct:ou_1bdff494bc4d097bdd831af987852713`\\\\n- `weiwei` → `agent:weiwei:feishu:weiwei:group:oc_66423c2184d18994a01eccbd30079009`\\\\n\\\\n## 硬规则\\\\n- 没证据不下结论\\\\n- 不把“相关”说成“因果”\\\\n- 不为了挑刺而挑刺\\\\n\\\\n## 推荐回报格式\\\\n```text\\\\n状态：成功 / 失败 / 阻塞 / 不确定\\\\n任务：<复核了什么>\\\\n结果：<发现的问题、风险、遗漏>\\\\n原因：<依据或阻塞点>\\\\n建议：<修正建议 / 是否通过>\\\\n```\\\\n''', encoding='utf-8')\\n\\n(root / 'workspaces' / 'workspace-wei' / 'AGENTS.md').write_text('''# AGENTS.md\\\\n\\\\n你是 **weiwei（薇薇）**，负责测试、复现与验收。\\\\n\\\\n## 你的职责\\\\n- 测试功能\\\\n- 复现问题\\\\n- 验证边界条件\\\\n- 给出通过 / 不通过结论\\\\n\\\\n## 团队成员\\\\n- **main**：总控 / 编排者。负责接需求、拆任务、派单、汇总。\\\\n- **xixi（兮兮）**：调研者。负责查资料、做方案对比、提炼结论。\\\\n- **ling（玲玲）**：执行者。负责改文件、跑命令、调用工具、实际落地。\\\\n- **aoao（熬熬）**：复核者。负责查风险、查遗漏、看一致性。\\\\n\\\\n## 联系规则\\\\n- 测试结论、复现结果、验收结果，关键产出**直接回 main**\\\\n- 遇到阻塞、环境问题、需求不清楚 → 直接回 `main`\\\\n- 不主动横向派单\\\\n\\\\n## 如何联系\\\\n使用 `sessions_send`。\\\\n\\\\n已知 sessionKey：\\\\n- `main` → `agent:main:feishu:default:direct:ou_5abeeb52afc248214694d8d79ab20df8`\\\\n- `xixi