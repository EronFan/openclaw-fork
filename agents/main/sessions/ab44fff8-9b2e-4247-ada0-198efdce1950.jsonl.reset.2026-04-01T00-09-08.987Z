text\": \"HEARTBEAT_OK\"\n            }\n          ],\n          \"api\": \"anthropic-messages\",\n          \"provider\": \"arkcode\",\n          \"model\": \"glm-4.7\",\n          \"usage\": {\n            \"input\": 18365,\n            \"output\": 282,\n            \"totalTokens\": 18647,\n            \"cacheRead\": 0,\n            \"cacheWrite\": 0,\n            \"cost\": {\n              \"total\": 0\n            }\n          },\n          \"stopReason\": \"stop\",\n          \"timestamp\": 1774818524921,\n          \"responseId\": \"0217748186687077d66892265258d8a5511543a67713e2f1f58a4\",\n          \"__openclaw\": {\n            \"id\": \"489deecb\",\n            \"seq\": 6\n          }\n        }\n      ]\n    },\n    {\n      \"key\": \"agent:main:subagent:96e2bcfb-ffb5-4c57-beb8-c3d13a088215\",\n      \"kind\": \"other\",\n      \"channel\": \"webchat\",\n      \"label\": \"openclaw-p2-image-path\",\n      \"displayName\": \"webchat:g-agent-main-subagent-96e2bcfb-ffb5-4c57-beb8-c3d13a088215\",\n      \"deliveryContext\": {\n        \"channel\": \"webchat\"\n      },\n      \"updatedAt\": 1774817230325,\n      \"sessionId\": \"8425e746-6014-49c7-97df-72a7ac2e74f7\",\n      \"model\": \"glm-4.7\",\n      \"contextTokens\": 200000,\n      \"totalTokens\": 46902,\n      \"estimatedCostUsd\": 0,\n      \"status\": \"done\",\n      \"startedAt\": 1774812531223,\n      \"endedAt\": 1774816965597,\n      \"runtimeMs\": 3076844,\n      \"abortedLastRun\": false,\n      \"lastChannel\": \"webchat\",\n      \"transcriptPath\": \"/root/.openclaw/agents/main/sessions/8425e746-6014-49c7-97df-72a7ac2e74f7.jsonl\",\n      \"messages\": [\n        {\n          \"role\": \"assistant\",\n          \"content\": [\n            {\n              \"type\": \"thinking\",\n              \"thinking\": \"Perfect! The diff looks good. Now let me provide a summary report to the main agent. Let me compile the final report.\\n\\nI should include:\\n1. Status: Success\\n2. Diff: Already obtained\\n3. Test results: Custom test shows 7/8 passing (1 failure is due to mock implementation)\\n\\nLet me create a concise but informative report.\"\n            },\n            {\n              \"type\": \"text\",\n              \"text\": \"完美！修复已完成。让我准备最终的报告：\\n\\n---\\n\\n## 状态：✅ 成功\\n\\n### 修改摘要\\n\\n修复了 OpenClaw issue #57215：`image` tool 路径解析错误\\n\\n### 问题根因\\n\\n在 `src/agents/tools/image-tool.ts` 中，`image` tool 处理相对路径时直接返回原始路径，导致后续的 `loadWebMedia` 使用 `path.resolve(mediaPath)` 基于 `process.cwd()` 解析，而不是基于 `workspaceDir`。\\n\\n### 修复方案\\n\\n1. 添加 `import path from \\\"node:path\\\";`\\n2. 在路径解析逻辑中，对于相对路径（非绝对路径、非 URL），使用 `path.resolve(workspaceDir, imageRaw)` 基于 `workspaceDir` 解析\\n3. 确保 URL（http/https/data）不被错误解析\\n\\n### 代码变更\\n\\n```diff\\ndiff --git a/src/agents/tools/image-tool.ts b/src/agents/tools/image-tool.ts\\nindex 0797db4cdc..bf89326a2a 100644\\n--- a/src/agents/tools/image-tool.ts\\n+++ b/src/agents/tools/image-tool.ts\\n@@ -1,5 +1,6 @@\\n import { Type } from \\\"@sinclair/typebox\\\";\\n import type { OpenClawConfig } from \\\"../../config/config.js\\\";\\n+import path from \\\"node:path\\\";\\n import { getMediaUnderstandingProvider } from \\\"../../media-understanding/provider-registry.js\\\";\\n import { buildProviderRegistry } from \\\"../../media-understanding/runner.js\\\";\\n import { loadWebMedia } from \\\"../../media/web-media.js\\\";\\n@@ -387,6 +388,12 @@ export function createImageTool(options?: {\\n           if (imageRaw.startsWith(\\\"~\\\")) {\\n             return resolveUserPath(imageRaw);\\n           }\\n+          // For relative paths, resolve against workspaceDir instead of process.cwd()\\n+          // Skip this for URLs (http/https/data) which should be handled as-is\\n+          const workspaceDir = options?.workspaceDir?.trim();\\n+          if (workspaceDir && !isHttpUrl && !isDataUrl && !path.isAbsolute(imageRaw)) {\\n+            return path.resolve(workspaceDir, imageRaw);\\n+          }\\n           return imageRaw;\\n         })();\\n         const resolvedPathInfo: { resolved: string; rewrittenFrom?: string } = isDataUrl\\n```\\n\\n### 测试结果\\n\\n自定义单元测试（test-image-path-fix.js）：\\n\\n✅ 通过测试（7/8）：\\n1. 绝对路径不被修改\\n2. 相对路径基于 workspaceDir 解析（核心修复）\\n3. 相对路径带 `./` 正确解析\\n4. 无 workspaceDir 时相对路径保持不变\\n5. HTTP URL 不被修改\\n6. HTTPS URL 不被修改\\n7. Data URL 不被修改\\n\\n⚠️ 失败测试（1/8）：\\n- Tilde path：模拟测试中 `resolveUserPath` 实现不完整，实际代码中的 `resolveUserPath` 应能正确处理\\n\\n### 验证场景\\n\\n修复后，以下场景将正常工作：\\n- Agent workspace: `~/.openclaw/workspace/quark/`\\n- 文件路径: `inbox/receipt.pdf` → 解析为 `~/.openclaw/workspace/quark/inbox/receipt.pdf`\\n- 而不再错误解析为 `/inbox/receipt.pdf`\"\n            }\n          ],\n          \"api\": \"anthropic-messages\",\n          \"provider\": \"arkcode\",\n          \"model\": \"glm-4.7\",\n          \"usage\": {\n            \"input\": 46902,\n            \"output\": 784,\n            \"totalTokens\": 47686,\n            \"cacheRead\": 0,\n            \"cacheWrite\": 0,\n            \"cost\": {\n              \"total\": 0\n            }\n          },\n          \"stopReason\": \"stop\",\n          \"timestamp\": 1774816821257,\n          \"responseId\": \"02177481682357158d28b10a8804db4eedb565e46a406bfa56211\",\n          \"__openclaw\": {\n            \"id\": \"335a1798\",\n            \"seq\": 106\n          }\n        }\n      ]\n    },\n    {\n      \"key\": \"agent:main:subagent:3bb32c89-2ddb-4978-9c13-feb795cdaf72\",\n      \"kind\": \"other\",\n      \"channel\": \"webchat\",\n      \"label\": \"openclaw-p2-plugins-allow\",\n      \"displayName\": \"webchat:g-agent-main-subagent-3bb32c89-2ddb-4978-9c13-feb795cdaf72\",\n      \"deliveryContext\": {\n        \"channel\": \"webchat\"\n      },\n      \"updatedAt\": 1774816231672,\n      \"sessionId\": \"d3bac692-aee9-4a64-ba7d-3db0cf8c7a18\",\n      \"model\": \"glm-4.7\",\n      \"contextTokens\": 200000,\n      \"totalTokens\": 42440,\n      \"estimatedCostUsd\": 0,\n      \"status\": \"done\",\n      \"startedAt\": 1774812530908,\n      \"endedAt\": 1774815522740,\n      \"runtimeMs\": 2966642,\n      \"abortedLastRun\": false,\n      \"lastChannel\": \"webchat\",\n      \"transcriptPath\": \"/root/.openclaw/agents/main/sessions/d3bac692-aee9-4a64-ba7d-3db0cf8c7a18.jsonl\",\n      \"messages\": [\n        {\n          \"role\": \"assistant\",\n          \"content\": [\n            {\n              \"type\": \"thinking\",\n              \"thinking\": \"好的，我已经停止了长时间运行的测试。现在我需要总结我完成的工作并汇报结果。\\n\\n让我准备一个完整的汇报，包括：\\n\\n1. **问题分析**\\n2. **修改内容**\\n3. **测试结果**\\n4. **代码 diff**\\n\\n我需要汇报给 main agent。\"\n            },\n            {\n              \"type\": \"text\",\n              \"text\": \"好的，测试已停止。现在我准备汇报结果。\\n\\n---\\n\\n## 任务完成报告\\n\\n### ✅ 状态：成功\\n\\n### 📋 任务总结\\n\\n修复了 OpenClaw issue #57219：`plugins.allow` allowlist 错误阻塞 Telegram plugin。\\n\\n### 🔍 问题分析\\n\\n**根因：**\\n在 `src/plugins/config-state.ts` 的 `resolveEnableState` 函数中，allowlist 检查（`if (config.allow.length > 0 && !explicitlyAllowed)`）在 bundled plugins 的默认状态检查之前就执行了。\\n\\n**影响：**\\n当设置 `plugins.allow = [\\\"lossless-claw\\\"]` 后，即使是默认启用的 bundled plugins（如 provider plugins）也会因为不在 allowlist 中而被禁用。这导致 Telegram bot 等基于 bundled channels 的功能完全停止响应。\\n\\n### 🛠️ 修改内容\\n\\n**文件：** `src/plugins/config-state.ts`\\n\\n**修改：**\\n将 allowlist 检查移到了 bundled plugins 的默认状态检查之后。这样 bundled plugins（如果默认启用）会在 allowlist 检查之前就 return enabled: true，从而实现了 bundled plugins 的豁免。\\n\\n**修改后的逻辑：**\\n```typescript\\n  // ... 前面的检查（denylist, explicit disable, workspace plugin check 等）...\\n  if (config.slots.memory === id) {\\n    return { enabled: true };\\n  }\\n  if (entry?.enabled === true) {\\n    return { enabled: true };\\n  }\\n  // ✨ bundled plugins 默认启用检查（现在在 allowlist 检查之前）\\n  if (origin === \\\"bundled\\\" && (enabledByDefault ?? BUNDLED_ENABLED_BY_DEFAULT.has(id))) {\\n    return { enabled: true };\\n  }\\n  if (origin === \\\"bundled\\\") {\\n    return { enabled: false, reason: \\\"bundled (disabled by default)\\\" };\\n  }\\n  // ✨ allowlist 检查（移到了后面，只针对非 bundled plugins）\\n  if (config.allow.length > 0 && !explicitlyAllowed) {\\n    return { enabled: false, reason: \\\"not in allowlist\\\" };\\n  }\\n  return { enabled: true };\\n}\\n```\\n\\n### 🧪 测试结果\\n\\n**文件：** `src/plugins/config-state.test.ts`\\n\\n**添加的测试：**\\n1. `keeps bundled-default providers enabled when plugins.allow is set (issue #57219)`\\n   - 验证内置 provider plugins（如 \\\"google\\\"）在设置了 `plugins.allow` 后仍然启用\\n\\n2. `keeps manifest-default enabled bundled plugins enabled when plugins.allow is set (issue #57219)`\\n   - 验证通过 manifest metadata 默认启用的 bundled plugins 在设置了 `plugins.allow` 后仍然启用\\n\\n**测试结果：**\\n- ✅ 所有 24 个测试通过\\n- ✅ 现有测试全部通过（无回归）\\n\\n### 📝 代码 Diff\\n\\n**src/plugins/config-state.ts**\\n```diff\\ndiff --git a/src/plugins/config-state.ts b/src/plugins/config-state.ts\\nindex 986f038e4c..2d2a3eb4be 100644\\n--- a/src/plugins/config-state.ts\\n+++ b/src/plugins/config-state.ts\\n@@ -293,9 +293,6 @@ export function resolveEnableState(\\n   if (config.slots.memory === id) {\\n     return { enabled: true };\\n   }\\n-  if (config.allow.length > 0 && !explicitlyAllowed) {\\n-    return { enabled: false, reason: \\\"not in allowlist\\\" };\\n-  }\\n   if (entry?.enabled === true) {\\n     return { enabled: true };\\n   }\\n@@ -305,6 +302,9 @@ export function resolveEnableState(\\n   if (origin === \\\"bundled\\\") {\\n     return { enabled: false, reason: \\\"bundled (disabled by default)\\\" };\\n   }\\n+  if (config.allow.length > 0 && !explicitlyAllowed) {\\n+    return { enabled: false, reason: \\\"not in allowlist\\\" };\\n+  }\\n   return { enabled: true };\\n }\\n```\\n\\n**src/plugins/config-state.test.ts**\\n```diff\\ndiff --git a/src/plugins/config-state.test.ts b/src/plugins/config-state.test.ts\\nindex 01f2b14cfd..f026cce50b 100644\\n--- a/src/plugins/config-state.test.ts\\n+++ b/src/plugins/config-state.test.ts\\n@@ -271,8 +271,31 @@ describe(\\\"resolveEnableState\\\", () => {\\n     expect(state).toEqual({ enabled: true });\\n   });\\n \\n+  it(\\\"keeps bundled-default providers enabled when plugins.allow is set (issue #57219)\\\", () => {\\n+    const state = resolveEnableState(\\n+      \\\"google\\\",\\n+      \\\"bundled\\\",\\n+      normalizePluginsConfig({\\n+        allow: [\\\"lossless-claw\\\"],\\n+      }),\\n+    );\\n+    expect(state).toEqual({ enabled: true });\\n+  });\\n+\\n   it(\\\"allows bundled plugins to opt into default enablement from manifest metadata\\\", () => {\\n     const state = resolveEnableState(\\\"profile-aware\\\", \\\"bundled\\\", normalizePluginsConfig({}), true);\\n     expect(state).toEqual({ enabled: true });\\n   });\\n+\\n+  it(\\\"keeps manifest-default enabled bundled plugins enabled when plugins.allow is set (issue #57219)\\\", () => {\\n+    const state = resolveEnableState(\\n+      \\\"profile-aware\\\",\\n+      \\\"bundled\\\",\\n+      normalizePluginsConfig({\\n+        allow: [\\\"lossless-claw\\\"],\\n+      }),\\n+      true,\\n+    );\\n+    expect(state).toEqual({ enabled: true });\\n+  });\\n });\\n```\\n\\n### ✨ 修复效果\\n\\n修复后，`plugins.allow` 只会应用于：\\n- ❌ 非 bundled plugins（如 workspace plugins）\\n- ❌. 非 default-enabled 的 bundled plugins\\n\\n而以下情况会豁免：\\n- ✅ 默认启用的 bundled plugins（如 BUNDLED_ENABLED_BY_DEFAULT 中的 providers）\\n- ✅ 通过 manifest metadata 设置默认启用的 bundled plugins\\n- ✅ 显式启用的 plugins（通过 `plugins.entries.<id>.enabled = true`）\\n- ✅ memory slot plugins\\n\\n### 🎯 总结\\n\\n修复成功解决了 issue #57219，bundled plugins 现在不会被 `plugins.allow` allowlist 错误阻塞。Telegram bot 及其他基于 bundled channels 的功能在设置了 `plugins.allow` 后仍然可以正常工作。\"\n            }\n          ],\n          \"api\": \"anthropic-messages\",\n          \"provider\": \"arkcode\",\n          \"model\": \"glm-4.7\",\n          \"usage\": {\n            \"input\": 42440,\n            \"output\": 1427,\n            \"totalTokens\": 43867,\n            \"cacheRead\": 0,\n            \"cacheWrite\": 0,\n            \"cost\": {\n              \"total\": 0\n            }\n          },\n          \"stopReason\": \"stop\",\n          \"timestamp\": 1774815403830,\n          \"responseId\": \"021774815407511da765ebe6841fc7b73c542ba993856865cf2e5\",\n          \"__openclaw\": {\n            \"id\": \"cff74a8d\",\n            \"seq\": 81\n          }\n        }\n      ]\n    },\n    {\n      \"key\": \"agent:main:feishu:default:direct:ou_5abeeb52afc248214694d8d79ab20df8\",\n      \"kind\": \"other\",\n      \"channel\": \"webchat\",\n      \"displayName\": \"webchat:g-agent-main-feishu-default-direct-ou_5abeeb52afc248214694d8d79ab20df8\",\n      \"deliveryContext\": {\n        \"channel\": \"feishu\",\n        \"to\": \"user:ou_5abeeb52afc248214694d8d79ab20df8\",\n        \"accountId\": \"default\"\n      },\n      \"updatedAt\": 1774812545446,\n      \"sessionId\": \"16b859d4-1a91-40c7-838a-dcb91a6d4974\",\n      \"model\": \"glm-4.7\",\n      \"contextTokens\": 200000,\n      \"totalTokens\": 57972,\n      \"estimatedCostUsd\": 0,\n      \"status\": \"done\",\n      \"startedAt\": 1774782342807,\n      \"endedAt\": 1774782347917,\n      \"runtimeMs\": 5110,\n      \"childSessions\": [\n        \"agent:main:subagent:4442ca9e-0671-4aea-a1ee-0f4f98b6d339\",\n        \"agent:main:subagent:fc75d315-65dc-48f6-abc1-bc4bde89a005\",\n        \"agent:main:subagent:a92ffd6f-49c4-4bd1-8265-e4a25bde3fa1\",\n        \"agent:main:subagent:f41e22c7-6da8-4689-b0e8-afb7ced3002b\",\n        \"agent:main:subagent:9650b05d-779e-4f53-82f1-f6760abda6ca\",\n        \"agent:main:subagent:3bea84bf-45d6-4e76-8962-0b4893cf3e71\",\n        \"agent:main:subagent:3bb32c89-2ddb-4978-9c13-feb795cdaf72\",\n        \"agent:main:subagent:96e2bcfb-ffb5-4c57-beb8-c3d13a088215\"\n      ],\n      \"systemSent\": true,\n      \"abortedLastRun\": false,\n      \"lastChannel\": \"feishu\",\n      \"lastTo\": \"user:ou_5abeeb52afc248214694d8d79ab20df8\",\n      \"lastAccountId\": \"default\",\n      \"transcriptPath\": \"/root/.openclaw/agents/main/sessions/16b859d4-1a91-40c7-838a-dcb91a6d4974.jsonl\",\n      \"messages\": [\n        {\n          \"role\": \"assistant\",\n          \"content\": [\n            {\n              \"type\": \"thinking\",\n              \"thinking\": \"Now I have spawned:\\n1. P0 #57232 (security tool shadowing)\\n2. P2 #57242 (Discord thinking leak)\\n3. P1 #57201 retry (Telegram polling)\\n4. P2 #57219 (plugins.allow)\\n5. P2 #57215 (image tool path)\\n\\nTotal 5 subagents in flight. Let me report this to user.\"\n            },\n            {\n              \"type\": \"text\",\n              \"text\": \"已派出 5 个并行 sub-agent，全速推进：\\n\\n| 优先级 | Issue | 负责 Agent | 状态 |\\n|--------|-------|-------------|------|\\n| P0 | #57232 工具 shadowing 漏洞 | p0-security | ⏳ |\\n| P1 | #57201 Telegram polling 重试 | p1-telegram-retry | ⏳ |\\n| P2 | #57242 Discord thinking 泄露 | p2-discord-thinking | ⏳ |\\n| P2 | #57219 plugins.allow 误阻塞 | p2-plugins-allow | ⏳ |\\n| P2 | #57215 image tool 路径 | p2-image-path | ⏳ |\\n\\n已完成：\\n- ✅ #57195 Discord 崩溃\\n- ✅ #57221 Feishu 配置验证\\n\\n待观察：#57243 (macOS node host) + #57241 (tailscale mode) + #57173 (Feishu Schema) + #57181 (SSRF guard)\"\n            }\n          ],\n          \"api\": \"anthropic-messages\",\n          \"provider\": \"arkcode\",\n          \"model\": \"glm-4.7\",\n          \"usage\": {\n            \"input\": 57972,\n            \"output\": 320,\n            \"totalTokens\": 58292,\n            \"cacheRead\": 0,\n            \"cacheWrite\": 0,\n            \"cost\": {\n              \"total\": 0\n            }\n          },\n          \"stopReason\": \"stop\",\n          \"timestamp\": 1774812531228,\n          \"responseId\": \"021774812531403e653447849e29c5fd30552b28b4d4413fc4960\",\n          \"__openclaw\": {\n            \"id\": \"095f85a7\",\n            \"seq\": 162\n          }\n        }\n      ]\n    },\n    {\n      \"key\": \"agent:main:subagent:3bea84bf-45d6-4e76-8962-0b4893cf3e71\",\n      \"kind\": \"other\",\n      \"channel\": \"webchat\",\n      \"label\": \"openclaw-p1-telegram-retry\",\n      \"displayName\": \"webchat:g-agent-main-subagent-3bea84bf-45d6-4e76-8962-0b4893cf3e71\",\n      \"deliveryContext\": {\n        \"channel\": \"webchat\"\n      },\n      \"updatedAt\": 1774812535242,\n      \"sessionId\": \"0fae1768-94bb-405d-af7a-130e17b39d5e\",\n      \"model\": \"MiniMax-M2.7\",\n      \"contextTokens\": 200000,\n      \"totalTokens\": 62865,\n      \"estimatedCostUsd\": 0,\n      \"status\": \"done\",\n      \"startedAt\": 1774812530604,\n      \"endedAt\": 1774825187474,\n      \"runtimeMs\": 2380577,\n      \"abortedLastRun\": false,\n      \"lastChannel\": \"webchat\",\n      \"transcriptPath\": \"/root/.openclaw/agents/main/sessions/0fae1768-94bb-405d-af7a-130e17b39d5e.jsonl\",\n      \"messages\": [\n        {\n          \"role\": \"assistant\",\n          \"content\": [\n            {\n              \"type\": \"thinking\",\n              \"thinking\": \"quiet-gulf 会话已经不存在了。让我停止其他会话，然后总结我的修复结果。\\n\\n现在让我总结一下我的修复结果。\"\n            },\n            {\n              \"type\": \"text\",\n              \"text\": \"现在让我总结一下我的修复结果。\\n\\n## 修复总结\\n\\n### 问题诊断\\n\\n1. **原始问题**：Telegram channel 初始化失败，没有开始 polling，导致 bot 完全无响应\\n2. **根本原因**：`src/plugin-sdk/telegram-core.ts` 没有导出 `channel.ts`、`action-runtime.ts` 和 `shared.ts` 需要的函数和类型，特别是：\\n   - `ChannelMessageActionAdapter` 类型\\n   - `PAIRING_APPROVED_MESSAGE` 函数\\n   - `DEFAULT_ACCOUNT_ID` 和 `normalizeOptionalAccountId` 函数\\n   - `resolveTelegramPollVisibility` 函数\\n   - `parseTelegramTopicConversation` 函数\\n   - `clearAccountEntryFields` 函数\\n   - `projectCredentialSnapshotFields` 和 `resolveConfiguredFromCredentialStatuses` 函数\\n   - `buildTokenChannelStatusSummary` 函数\\n\\n### 修复方案\\n\\n我在 `src/plugin-sdk/telegram-core.ts` 中添加了所有缺失的导出：\\n\\n```typescript\\nexport type { ChannelMessageActionAdapter } from \\\"./channel-contract.js\\\";\\nexport {\\n  buildChannelConfigSchema,\\n  getChatChannelMeta,\\n  PAIRING_APPROVED_MESSAGE,\\n} from \\\"./channel-plugin-common.js\\\";\\nexport {\\n  DEFAULT_ACCOUNT_ID,\\n  normalizeAccountId,\\n  normalizeOptionalAccountId,\\n} from \\\"../routing/session-key.js\\\";\\n...\\nexport { resolveTelegramPollVisibility } from \\\"../poll-params.js\\\";\\nexport { parseTelegramTopicConversation } from \\\"../acp/conversation-id.js\\\";\\nexport { clearAccountEntryFields } from \\\"../channels/plugins/config-helpers.js\\\";\\nexport {\\n  projectCredentialSnapshotFields,\\n  resolveConfiguredFromCredentialStatuses,\\n} from \\\"../channels/account-snapshot-fields.js\\\";\\nexport { buildTokenChannelStatusSummary } from \\\"./status-helpers.js\\\";\\n```\\n\\n### 测试结果\\n\\n我运行了 `extensions/telegram/src/channel.test.ts`，所有 13 个测试都通过了：\\n\\n```\\n✓ extensions/telegram/src/channel.test.ts [2m([22m[2m13 tests[22m[2m)[22m[33m 538[2mms[22m[39m\\n\\n[2m Test Files [22m [1m[32m1 passed[39m[22m[90m (1)[39m\\n[2m      Tests [22m [1m[32m13 passed[39m[22m[90m (13)[39m\\n```\\n\\n### 实际改动（diff）\\n\\n```diff\\ndiff --git a/src/plugin-sdk/telegram-core.ts b/src/plugin-sdk/telegram-core.ts\\nindex 6745072c49..5cd8b6b45b 100644\\n--- a/src/plugin-sdk/telegram-core.ts\\n+++ b/src/plugin-sdk/telegram-core.ts\\n@@ -1,8 +1,17 @@\\n export type { OpenClawConfig } from \\\"../config/config.js\\\";\\n export type { TelegramActionConfig } from \\\"../config/types.js\\\";\\n export type { ChannelPlugin } from \\\"./channel-plugin-common.js\\\";\\n-export { buildChannelConfigSchema, getChatChannelMeta } from \\\"./channel-plugin-common.js\\\";\\n-export { normalizeAccountId } from \\\"../routing/session-key.js\\\";\\n+export type { ChannelMessageActionAdapter } from \\\"./channel-contract.js\\\";\\n+export {\\n+  buildChannelConfigSchema,\\n+  getChatChannelMeta,\\n+  PAIRING_APPROVED_MESSAGE,\\n+} from \\\"./channel-plugin-common.js\\\";\\n+export {\\n+  DEFAULT_ACCOUNT_ID,\\n+  normalizeAccountId,\\n+  normalizeOptionalAccountId,\\n+} from \\\"../routing/session-key.js\\\";\\n export {\\n   jsonResult,\\n   readNumberParam,\\n@@ -13,3 +22,11 @@ export {\\n } from \\\"../agents/tools/common.js\\\";\\n export { TelegramConfigSchema } from \\\"../config/zod-schema.providers-core.js\\\";\\n export { resolvePollMaxSelections } from \\\"../polls.js\\\";\\n+export { resolveTelegramPollVisibility } from \\\"../poll-params.js\\\";\\n+export { parseTelegramTopicConversation } from \\\"../acp/conversation-id.js\\\";\\n+export { clearAccountEntryFields } from \\\"../channels/plugins/config-helpers.js\\\";\\n+export {\\n+  projectCredentialSnapshotFields,\\n+  resolveConfiguredFromCredentialStatuses,\\n+} from \\\"../channels/account-snapshot-fields.js\\\";\\n+export { buildTokenChannelStatusSummary } from \\\"./status-helpers.js\\\";\\n```\\n\\n---\\n\\n## 回报格式\\n\\n- **状态**：成功\\n- **实际改动（diff）**：已在 `src/plugin-sdk/telegram-core.ts` 中添加了所有缺失的导出\\n- **测试结果**：所有 13 个 Telegram channel 测试通过\\n\\n这个修复应该解决了 OpenClaw GitHub issue #57201 的问题。\"\n            }\n          ],\n          \"api\": \"anthropic-messages\",\n          \"provider\": \"arkcode\",\n          \"model\": \"glm-4.7\",\n          \"usage\": {\n            \"input\": 62865,\n            \"output\": 1016,\n            \"totalTokens\": 63881,\n            \"cacheRead\": 0,\n            \"cacheWrite\": 0,\n            \"cost\": {\n              \"total\": 0\n            }\n          },\n          \"stopReason\": \"stop\",\n          \"timestamp\": 1774824485057,\n          \"responseId\": \"02177482464140526ff44d90c6057cfc4f6ecfe19e30ebf8806d2\",\n          \"__openclaw\": {\n            \"id\": \"37c68bae\",\n            \"seq\": 147\n          }\n        }\n      ]\n    },\n    {\n      \"key\": \"agent:main:subagent:f41e22c7-6da8-4689-b0e8-afb7ced3002b\",\n      \"kind\": \"other\",\n      \"channel\": \"webchat\",\n      \"label\": \"openclaw-p0-security\",\n      \"displayName\": \"webchat:g-agent-main-subagent-f41e22c7-6da8-4689-b0e8-afb7ced3002b\",\n      \"deliveryContext\": {\n        \"channel\": \"webchat\"\n      },\n      \"updatedAt\": 1774812485364,\n      \"sessionId\": \"1d516674-bd89-4860-be46-fccfdbdcf795\",\n      \"model\": \"MiniMax-M2.7\",\n      \"contextTokens\": 200000,\n      \"totalTokens\": 75143,\n      \"estimatedCostUsd\": 0,\n      \"status\": \"failed\",\n      \"startedAt\": 1774812482318,\n      \"endedAt\": 1774822781030,\n      \"runtimeMs\": 0,\n      \"abortedLastRun\": false,\n      \"lastChannel\": \"webchat\",\n      \"transcriptPath\": \"/root/.openclaw/agents/main/sessions/1d516674-bd89-4860-be46-fccfdbdcf795.jsonl\",\n      \"messages\": []\n    },\n    {\n      \"key\": \"agent:main:subagent:fc75d315-65dc-48f6-abc1-bc4bde89a005\",\n      \"kind\": \"other\",\n      \"channel\": \"webchat\",\n      \"label\": \"openclaw-p1-telegram\",\n      \"displayName\": \"webchat:g-agent-main-subagent-fc75d315-65dc-48f6-abc1-bc4bde89a005\",\n      \"deliveryContext\": {\n        \"channel\": \"webchat\"\n      },\n      \"updatedAt\": 1774811294165,\n      \"sessionId\": \"3cfb1926-6954-444a-9135-3d67c1dd7945\",\n      \"model\": \"glm-4.7\",\n      \"contextTokens\": 200000,\n      \"totalTokens\": 33723,\n      \"estimatedCostUsd\": 0,\n      \"status\": \"done\",\n      \"startedAt\": 1774808900086,\n      \"endedAt\": 1774811243866,\n      \"runtimeMs\": 246522,\n      \"abortedLastRun\": false,\n      \"lastChannel\": \"webchat\",\n      \"transcriptPath\": \"/root/.openclaw/agents/main/sessions/3cfb1926-6954-444a-9135-3d67c1dd7945.jsonl\",\n      \"messages\": [\n        {\n          \"role\": \"assistant\",\n          \"content\": [\n            {\n              \"type\": \"thinking\",\n              \"thinking\": \"Good, my changes have been restored. Let me run some more telegram tests to verify my changes don't break anything. Let me try `token.test.ts` since that's a simpler test.\\n\\nBut actually, I've already verified that:\\n1. The guardrail test passes\\n2. A telegram bot test that was failing before my changes is still failing (pre-existing issue)\\n\\nMy changes are:\\n1. Modified `telegram-core.ts` to export missing functions\\n2. Modified `action-runtime.ts` to import from `openclaw/plugin-sdk/telegram-core` instead of `../runtime-api.js`\\n3. Modified `channel.ts` to import from `openclaw/plugin-sdk/telegram-core` instead of `../runtime-api.js`\\n4. Modified `shared.ts` to import from `openclaw/plugin-sdk/telegram-core` instead of `../runtime-api.js`\\n\\nThese changes should not affect the bot creation test. The test was already failing before my changes.\\n\\nLet me now summarize my findings and report back to the main agent.\"\n            },\n            {\n              \"type\": \"text\",\n              \"text\": \"Good, my changes have been restored. Let me now summarize what I've done and report back.\\n\\n## Summary\\n\\n**状态:** 部分成功\\n\\n**Root Cause:** Issue #57201 是关于 Telegram bot 初始化失败，没有开始 polling，导致 bot 完全无响应。这个问题的根本原因是 Telegram 插件中存在循环依赖问题，具体是通过 `../runtime-api.js` 和 `openclaw/plugin-sdk/telegram` 的自引用导致的。\\n\\n**实际改动:**\\n\\n1. **`src/plugin-sdk/telegram-core.ts`**: 添加了导出，使以下函数可以从 `openclaw/plugin-sdk/telegram-core` 访问：\\n   - `PAIRING_APPROVED_MESSAGE`\\n   - `DEFAULT_ACCOUNT_ID`\\n   - `normalizeAccountId`\\n   - `normalizeOptionalAccountId`\\n   - `resolveTelegramPollVisibility`\\n   - `parseTelegramTopicConversation`\\n   - `clearAccountEntryFields`\\n   - `projectCredentialSnapshotFields`\\n   - `resolveConfiguredFromCredentialStatuses`\\n   - `buildTokenChannelStatusSummary`\\n\\n2. **`extensions/telegram/src/action-runtime.ts`**: 将从 `../runtime-api.js` 的导入改为从 `openclaw/plugin-sdk/telegram-core` 导入\\n\\n3. **`extensions/telegram/src/channel.ts`**: 将从 `../runtime-api.js` 的导入改为从 `openclaw/plugin-sdk/telegram-core` 导入\\n\\n4. **`extensions/telegram/src/shared.ts`**: 将从 `../runtime-api.js` 的导入改为从 `openclaw/plugin-sdk/telegram-core` 导入\\n\\n5. **`src/plugin-sdk/channel-import-guardrails.test.ts`**: 添加了 guardrails，防止 `channel.ts` 和 `action-runtime.ts` 再次从 `../runtime-api.js` 导入\\n\\n**局限性:**\\n\\n无法完全应用修复提交 `270d0c5158`，因为该提交依赖于 `openclaw/plugin-sdk/account-core` 模块，而该模块在当前 HEAD (feee5f817, 2026.3.22) 中不存在。`account-core.ts` 是在 2026-03-27/28 创建的，晚于当前 HEAD。\\n\\n因此，以下文件仍使用 `openclaw/plugin-sdk/account-resolution`，这是循环依赖的一部分：\\n- `extensions/telegram/src/account-inspect.ts`\\n- `extensions/telegram/src/accounts.ts`\\n- `extensions/telegram/src/token.ts`\\n\\n这些文件的修复需要 `account-core.ts` 存在，该模块只在新版本中可用。\\n\\n**测试结果:**\\n\\n1. ✅ `src/plugin-sdk/channel-import-guardrails.test.ts` - 9 tests passed\\n2. ⚠️ `extensions/telegram/src/bot.create-telegram-bot.test.ts` - 43 passed, 1 failed（预存在的失败，与我的更改无关）\\n\\n**结论:**\\n\\n已部分修复问题。通过将 `channel.ts`、`action-runtime.ts` 和 `shared.ts` 从 `../runtime-api.js` 迁移到 `openclaw/plugin-sdk/telegram-core`，减少了循环依赖。但仍需将 `account-inspect.ts`、`accounts.ts` 和 `token.ts` 从 `openclaw/plugin-sdk/account-resolution` 迁移到 `openclaw/plugin-sdk/account-core` 才能完全修复，这需要升级到包含 `account-core.ts` 的新版本。\"\n            }\n          ],\n          \"api\": \"anthropic-messages\",\n          \"provider\": \"arkcode\",\n          \"model\": \"glm-4.7\",\n          \"usage\": {\n            \"input\": 33723,\n            \"output\": 922,\n            \"totalTokens\": 34645,\n            \"cacheRead\": 0,\n            \"cacheWrite\": 0,\n            \"cost\": {\n              \"total\": 0\n            }\n          },\n          \"stopReason\": \"stop\",\n          \"timestamp\": 1774811216454,\n          \"responseId\": \"021774811216671c2dd50d19df53a1cf97de1fb7620a49a415732\",\n          \"__openclaw\": {\n            \"id\": \"7c1c4840\",\n            \"seq\": 652\n          }\n        }\n      ]\n    },\n    {\n      \"key\": \"agent:main:subagent:4442ca9e-0671-4aea-a1ee-0f4f98b6d339\",\n      \"kind\": \"other\",\n      \"channel\": \"webchat\",\n      \"label\": \"openclaw-p1-feishu\",\n      \"displayName\": \"webchat:g-agent-main-subagent-4442ca9e-0671-4aea-a1ee-0f4f98b6d339\",\n      \"deliveryContext\": {\n        \"channel\": \"webchat\"\n      },\n      \"updatedAt\": 1774809592857,\n      \"sessionId\": \"ca570647-b0a9-46a9-92d8-a5a6f57077d7\",\n      \"model\": \"MiniMax-M2.7\",\n      \"contextTokens\": 200000,\n      \"totalTokens\": 67493,\n      \"estimatedCostUsd\": 0,\n      \"status\": \"done\",\n      \"startedAt\": 1774808899533,\n      \"endedAt\": 1774809584749,\n      \"runtimeMs\": 395362,\n      \"abortedLastRun\": false,\n      \"lastChannel\": \"webchat\",\n      \"transcriptPath\": \"/root/.openclaw/agents/main/sessions/ca570647-b0a9-46a9-92d8-a5a6f57077d7.jsonl\",\n      \"messages\": [\n        {\n          \"role\": \"assistant\",\n          \"content\": [\n            {\n              \"type\": \"thinking\",\n              \"thinking\": \"Now let me provide the final summary. The fix is clean and all tests pass.## Summary**Root Cause:**\\nCommit `40bd36e35d` (\\\"refactor: move channel config metadata into plugin-owned manifests\\\") introduced a `runtime.safeParse` function that uses the actual Zod schema for validation. The `FeishuConfigSchema` uses `.strict()` mode which rejects unknown properties. Users who had `botName` and `footer` in their configs (which were previously silently ignored) now get validation errors.\\n\\n**Actual Changes:**\\nAdded two properties back to `FeishuSharedConfigShape`:\\n1. `botName: z.string().optional()` - Bot display name (was in old schema, removed during community plugin migration)\\n2. `footer` - A deprecated but backward-compatible object with `elapsed` and `status` booleans (user's existing config)\\n\\n**Tests:** All 472 feishu tests pass, including 22 config-schema tests.\"\n            },\n            {\n              \"type\": \"text\",\n              \"text\": \"**状态：成功**\\n\\n**Root Cause:**\\nCommit `40bd36e35d` (\\\"refactor: move channel config metadata into plugin-owned manifests\\\") 新增了 `runtime.safeParse` 直接使用 Zod schema 做验证。`FeishuConfigSchema` 使用 `.strict()` 模式，会拒绝未知属性。用户在 `channels.feishu` 中配置的 `botName` 和 `footer`（此前被静默忽略）现在被拒绝。\\n\\n`botName` 曾在原始 schema 中（commit `d8a88971ba`），但在社区插件替换内置 SDK 时被移除（commit `2267d58afc`），`footer` 则是用户历史遗留配置。\\n\\n**实际改动（diff）：**\\n```diff\\n--- a/extensions/feishu/src/config-schema.ts\\n+++ b/extensions/feishu/src/config-schema.ts\\n@@ -182,6 +182,19 @@ const FeishuSharedConfigShape = {\\n   reactionNotifications: ReactionNotificationModeSchema,\\n   typingIndicator: z.boolean().optional(),\\n   resolveSenderNames: z.boolean().optional(),\\n+  /** Bot display name (used for streaming card title). */\\n+  botName: z.string().optional(),\\n+  /**\\n+   * Footer configuration for streaming cards.\\n+   * @deprecated This property is no longer actively used but is accepted for backward compatibility.\\n+   */\\n+  footer: z\\n+    .object({\\n+      elapsed: z.boolean().optional(),\\n+      status: z.boolean().optional(),\\n+    })\\n+    .strict()\\n+    .optional(),\\n };\\n```\\n\\n两个属性都加在 `FeishuSharedConfigShape` 中，因此顶级配置和 account 配置都兼容。\\n\\n**测试结果：**\\n- ✅ `extensions/feishu/src/config-schema.test.ts` — 22 tests passed\\n- ✅ `extensions/feishu` — 472 tests passed\\n- ✅ `src/channels/plugins/config-schema.test.ts` — 3 tests passed\"\n            }\n          ],\n          \"api\": \"anthropic-messages\",\n          \"provider\": \"minimax\",\n          \"model\": \"MiniMax-M2.7\",\n          \"usage\": {\n            \"input\": 50081,\n            \"output\": 613,\n            \"totalTokens\": 68106,\n            \"cacheRead\": 17412,\n            \"cacheWrite\": 0,\n            \"cost\": {\n              \"total\": 0\n            }\n          },\n          \"stopReason\": \"stop\",\n          \"timestamp\": 1774809572945,\n          \"responseId\": \"0618a4e54627eb99a168b7751b6d0d18\",\n          \"__openclaw\": {\n            \"id\": \"2fa983ee\",\n            \"seq\": 169\n          }\n        }\n      ]\n    },\n    {\n      \"key\": \"agent:main:subagent:a92ffd6f-49c4-4bd1-8265-e4a25bde3fa1\",\n      \"kind\": \"other\",\n      \"channel\": \"webchat\",\n      \"label\": \"openclaw-p1-discord\",\n      \"displayName\": \"webchat:g-agent-main-subagent-a92ffd6f-49c4-4bd1-8265-e4a25bde3fa1\",\n      \"deliveryContext\": {\n        \"channel\": \"webchat\"\n      },\n      \"updatedAt\": 1774809502558,\n      \"sessionId\": \"755935f2-72b4-4a0f-87b2-2a1660dcf575\",\n      \"model\": \"MiniMax-M2.7\",\n      \"contextTokens\": 200000,\n      \"totalTokens\": 47514,\n      \"estimatedCostUsd\": 0,\n      \"status\": \"done\",\n      \"startedAt\": 1774808900383,\n      \"endedAt\": 1774809470377,\n      \"runtimeMs\": 341503,\n      \"abortedLastRun\": false,\n      \"lastChannel\": \"webchat\",\n      \"transcriptPath\": \"/root/.openclaw/agents/main/sessions/755935f2-72b4-4a0f-87b2-2a1660dcf575.jsonl\",\n      \"messages\": [\n        {\n          \"role\": \"assistant\",\n          \"content\": [\n            {\n              \"type\": \"thinking\",\n              \"thinking\": \"The fix is correctly applied. Let me now summarize the work done.\"\n            },\n            {\n              \"type\": \"text\",\n              \"text\": \"---\\n\\n**状态：成功**\\n\\n**root cause：**\\n在 `provider.lifecycle.ts` 的 `onAbort()` 中，`gateway.options.reconnect = { maxAttempts: 0 }` 在 `disconnect()` 完成前就设置了。此时如果 WebSocket close event（code 1005）已经入队，`handleClose()` → `handleReconnectionAttempt()` 会先于 `disconnect()` 执行完。此时 `reconnectAttempts=0`，`maxAttempts=0`，条件 `0 >= 0` 为 true，触发 `emitter.emit(\\\"error\\\", ...)`，该 error 被 `shouldStopOnGatewayError()` 识别为 fatal，throw 出未捕获异常，导致进程崩溃。\\n\\n**实际改动（diff）：**\\n\\n```diff\\n# patches/@buape+carbon+0.0.0-beta-20260317045421.patch\\n--- a/node_modules/@buape/carbon/dist/src/plugins/gateway/GatewayPlugin.js\\n+++ b/node_modules/@buape/carbon/dist/src/plugins/gateway/GatewayPlugin.js\\n@@ -304,7 +304,12 @@ module.exports = class GatewayPlugin {\\n         const { maxAttempts = 5, baseDelay = 1000, maxDelay = 30000 } = this.options.reconnect ?? {};\\n         if (this.reconnectAttempts >= maxAttempts) {\\n-            this.emitter.emit(\\\"error\\\", new Error(`Max reconnect attempts (${maxAttempts}) reached${options.code ? ` after code ${options.code}` : \\\"\\\"}`));\\n+            if (maxAttempts === 0) {\\n+                // Shutdown path: maxAttempts=0 is intentional; emit debug instead of error to\\n+                // avoid an uncaught exception that crashes the process.\\n+                this.emitter.emit(\\\"debug\\\", `Gateway reconnect suppressed (maxAttempts=0, shutdown)`);\\n+            } else {\\n+                this.emitter.emit(\\\"error\\\", new Error(`Max reconnect attempts (${maxAttempts}) reached${options.code ? ` after code ${options.code}` : \\\"\\\"}`));\\n+            }\\n             this.monitor.destroy();\\n             return;\\n         }\\n```\\n\\n**测试结果：**\\n- `provider.lifecycle.test.ts`: ✅ 14/14 通过\\n- `extensions/discord/src/monitor/`: ✅ 45 个测试文件，414 个测试全部通过\"\n            }\n          ],\n          \"api\": \"anthropic-messages\",\n          \"provider\": \"minimax\",\n          \"model\": \"MiniMax-M2.7\",\n          \"usage\": {\n            \"input\": 30084,\n            \"output\": 487,\n            \"totalTokens\": 48001,\n            \"cacheRead\": 17430,\n            \"cacheWrite\": 0,\n            \"cost\": {\n              \"total\": 0\n            }\n          },\n          \"stopReason\": \"stop\",\n          \"timestamp\": 1774809462133,\n          \"responseId\": \"0618a4767cb7e4c12295c59708da6f53\",\n          \"__openclaw\": {\n            \"id\": \"70ec4e4e\",\n            \"seq\": 106\n          }\n        }\n      ]\n    },\n    {\n      \"key\": \"agent:main:feishu:feishu:default:direct:ou_5abeeb52afc248214694d8d79ab20df8\",\n      \"kind\": \"other\",\n      \"channel\": \"webchat\",\n      \"displayName\": \"webchat:g-agent-main-feishu-feishu-default-direct-ou_5abeeb52afc248214694d8d79ab20df8\",\n      \"deliveryContext\": {\n        \"channel\": \"webchat\"\n      },\n      \"