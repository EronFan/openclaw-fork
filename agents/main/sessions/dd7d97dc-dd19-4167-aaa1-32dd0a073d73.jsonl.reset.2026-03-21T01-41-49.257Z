{"type":"message","id":"ec0ef667","parentId":"a6ea64ea","timestamp":"2026-03-20T12:37:54.346Z","message":{"role":"toolResult","toolCallId":"019d0b4090ace57922c2f715d12e7614","toolName":"read","content":[{"type":"text","text":"import { request } from 'https';\n\ninterface GenerationOptions {\n  topic: string;\n  referenceImage?: string;\n  apiKey?: string;\n}\n\ninterface ChatMessage {\n  role: 'user' | 'assistant';\n  content: Array<{\n    type: 'text' | 'image_url';\n    text?: string;\n    image_url?: {\n      url: string;\n    };\n  }>;\n}\n\ninterface APIResponse {\n  id: string;\n  model: string;\n  object: string;\n  created: number;\n  choices: Array<{\n    index: number;\n    message: {\n      role: string;\n      content: string;\n    };\n    finish_reason: string;\n  }>;\n  usage: {\n    prompt_tokens: number;\n    completion_tokens: number;\n    total_tokens: number;\n  };\n}\n\n// 系统提示词\nconst SYSTEM_PROMPT = `请生成一张小红书风格的图文内容图片。\n【合规特别注意的】注意不要带有任何小红书的logo，不要有右下角的用户id以及logo\n【合规特别注意的】用户给到的参考图片里如果有水印和logo（尤其是注意右下角，左上角），请一定要去掉\n\n页面内容：{page_content}\n\n页面类型：{page_type}\n\n如果当前页面类型不是封面页的话，你要参考最后一张图片作为封面的样式\n\n后续生成风格要严格参考封面的风格，要保持风格统一。\n\n设计要求：\n\n1. 整体风格\n- 小红书爆款图文风格\n- 清新、精致、有设计感\n- 适合年轻人审美\n- 配色和谐，视觉吸引力强\n\n\n[244 more lines in file. Use offset=61 to continue.]"}],"isError":false,"timestamp":1774010274336}}
{"type":"message","id":"ddc40776","parentId":"ec0ef667","timestamp":"2026-03-20T12:38:35.827Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"This is quite complex. I'll create a simpler Python version that:\n1. Supports canghe.ai (original API)\n2. Supports doubao-seedream models via Ark API\n\nLet me create a new handler.py script that can choose between the two.\n\n","thinkingSignature":"reasoning_content"},{"type":"text","text":"\n\n\n我现在重写这个技能的脚本，加一个新的 Python 版本，支持用户选择用哪个模型。\n"},{"type":"toolCall","id":"019d0b40c8eb0075392ed3565ae7015f","name":"write","arguments":{"content":"#!/usr/bin/env python3\n\"\"\"\n小红书封面生成器 - 支持多种生图模型\n\"\"\"\nimport argparse\nimport os\nimport time\nimport subprocess\nfrom pathlib import Path\n\n# Ark API 配置\nARK_BASE_URL = \"https://ark.cn-beijing.volces.com/api/v3\"\nARK_API_KEY = \"fa7741c9-d143-47c9-a86a-f0811800e8b8\"\n\n# CANGHE API 配置\nCANGHE_BASE_URL = \"https://api.canghe.ai/v1\"\n\n# 可用模型列表\nMODELS = {\n    # Doubao Seedream 系列\n    \"doubao-seedream-5-0\": \"doubao-seedream-5-0-260128\",\n    \"doubao-seedream-4-5\": \"doubao-seedream-4-5-251128\",\n    \"doubao-seedream-4-0\": \"doubao-seedream-4-0-250828\",\n    # 仓颉 API\n    \"canghe-default\": None,  # 使用默认模型\n}\n\n\ndef generate_with_ark(prompt: str, model: str, output_path: str, size: str = \"1920x2560\"):\n    \"\"\"使用 Ark API 生成图片\"\"\"\n    import requests\n    \n    url = f\"{ARK_BASE_URL}/images/generations\"\n    headers = {\n        \"Authorization\": f\"Bearer {ARK_API_KEY}\",\n        \"Content-Type\": \"application/json\"\n    }\n    payload = {\n        \"model\": MODELS.get(model, model),  # 支持直接传模型ID\n        \"prompt\": prompt,\n        \"size\": size,\n        \"n\": 1\n    }\n    \n    print(f\"🤖 使用 Ark 模型: {model}\")\n    resp = requests.post(url, headers=headers, json=payload, timeout=180)\n    \n    if resp.status_code != 200:\n        print(f\"❌ Ark API 错误: {resp.status_code} - {resp.text}\")\n        return False\n    \n    d = resp.json()\n    if 'data' in d and d['data']:\n        img_url = d['data'][0].get('url', '')\n        if img_url:\n            subprocess.run(['curl', '-s', '-o', output_path, img_url])\n            print(f\"✅ 图片已保存: {output_path}\")\n            return True\n    \n    print(f\"❌ 无图片返回: {d}\")\n    return False\n\n\ndef generate_with_canghe(prompt: str, api_key: str, output_path: str):\n    \"\"\"使用仓颉 API 生成图片\"\"\"\n    import requests\n    \n    url = f\"{CANGHE_BASE_URL}/chat/completions\"\n    headers = {\n        \"Authorization\": f\"Bearer {api_key}\",\n        \"Content-Type\": \"application/json\"\n    }\n    \n    system_prompt = f\"\"\"请生成一张小红书风格的图文内容图片。\n【合规特别注意的】注意不要带有任何小红书的logo，不要有右下角的用户id以及logo\n【合规特别注意的】用户给到的参考图片里如果有水印和logo（尤其是注意右下角，左上角），请一定要去掉\n设计要求：\n1. 整体风格 - 小红书爆款图文风格，精致有设计感，适合年轻人审美\n2. 配色和谐，视觉吸引力强\n3. 3:4 竖版比例，高清适合手机查看\n4. 文字清晰可读\"\"\"\n\n    payload = {\n        \"model\": \"canghe-default\",\n        \"messages\": [\n            {\"role\": \"system\", \"content\": system_prompt},\n            {\"role\": \"user\", \"content\": prompt}\n        ],\n        \"max_tokens\": 2000\n    }\n    \n    print(f\"🤖 使用仓颉 API 模型\")\n    resp = requests.post(url, headers=headers, json=payload, timeout=180)\n    \n    if resp.status_code != 200:\n        print(f\"❌ 仓颉 API 错误: {resp.status_code} - {resp.text}\")\n        return False\n    \n    # 仓颉返回的是 markdown 里的图片 URL\n    d = resp.json()\n    content = d.get('choices', [{}])[0].get('message', {}).get('content', '')\n    \n    # 解析图片 URL (markdown 格式)\n    import re\n    match = re.search(r'!\\[.*?\\]\\((.*?)\\)', content)\n    if match:\n        img_url = match.group(1)\n        subprocess.run(['curl', '-s', '-o', output_path, img_url])\n        print(f\"✅ 图片已保存: {output_path}\")\n        return True\n    \n    print(f\"❌ 无图片返回: {content[:200]}\")\n    return False\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"小红书封面生成器\")\n    parser.add_argument(\"prompt\", help=\"封面主题/内容描述\")\n    parser.add_argument(\"--model\", \"-m\", \n                        choices=[\"doubao-seedream-5-0\", \"doubao-seedream-4-5\", \n                                 \"doubao-seedream-4-0\", \"canghe\"],\n                        default=\"doubao-seedream-5-0\",\n                        help=\"生图模型 (默认: doubao-seedream-5-0)\")\n    parser.add_argument(\"--api-key\", \"-k\", \n                        help=\"仓颉 API Key (仅 canghe 模型需要)\")\n    parser.add_argument(\"--output\", \"-o\",\n                        default=\"/root/.openclaw/workspace/xiaohongshu-cover-{}.png\",\n                        help=\"输出路径模板\")\n    parser.add_argument(\"--size\", \"-s\",\n                        default=\"1920x2560\",\n                        help=\"图片尺寸 (默认: 1920x2560)\")\n    \n    args = parser.parse_args()\n    \n    # 生成输出路径\n    output_path = args.output.format(int(time.time() * 1000))\n    \n    print(f\"📝 主题: {args.prompt}\")\n    print(f\"🎨 模型: {args.model}\")\n    print(f\"📐 尺寸: {args.size}\")\n    print()\n    \n    if args.model.startswith(\"doubao\"):\n        success = generate_with_ark(args.prompt, args.model, output_path, args.size)\n    elif args.model == \"canghe\":\n        if not args.api_key:\n            # 尝试从环境变量读取\n            args.api_key = os.environ.get(\"CANGHE_API_KEY\", \"\")\n        if not args.api_key:\n            print(\"❌ 需要 --api-key 或设置 CANGHE_API_KEY 环境变量\")\n            return\n        success = generate_with_canghe(args.prompt, args.api_key, output_path)\n    else:\n        print(f\"❌ 未知模型: {args.model}\")\n        return\n    \n    if success:\n        print(f\"✨ 完成!\")\n    else:\n        print(f\"❌ 生成失败\")\n        exit(1)\n\n\nif __name__ == \"__main__\":\n    main()","file_path":"/root/.openclaw/workspace/skills/xiaohongshu-cover-generator/scripts/handler.py"}}],"api":"openai-completions","provider":"siliconflow","model":"Pro/MiniMaxAI/MiniMax-M2.5","usage":{"input":120172,"output":1630,"cacheRead":20096,"cacheWrite":0,"totalTokens":141898,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1774010274344}}
