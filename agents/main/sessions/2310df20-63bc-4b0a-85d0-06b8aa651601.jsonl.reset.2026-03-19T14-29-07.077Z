\\n    \\\"git_url\\\": \\\"https://api.github.com/repos/wanikua/danghuangshang/git/blobs/672923c7c613decdbbe9eb84999877d168ac203b\\\",\\n    \\\"download_url\\\": \\\"https://raw.githubusercontent.com/wanikua/danghuangshang/main/.gitignore\\\",\\n    \\\"type\\\": \\\"file\\\",\\n    \\\"_links\\\": {\\n      \\\"self\\\": \\\"https://api.github.com/repos/wanikua/danghuangshang/contents/.gitignore?ref=main\\\",\\n      \\\"git\\\": \\\"https://api.github.com/repos/wanikua/danghuangshang/git/blobs/672923c7c613decdbbe9eb84999877d168ac203b\\\",\\n      \\\"html\\\": \\\"https://github.com/wanikua/danghuangshang/blob/main/.gitignore\\\"\\n    }\\n  },\\n  {\\n    \\\"name\\\": \\\"BUG-REPORT.md\\\",\\n    \\\"path\\\": \\\"BUG-REPORT.md\\\",\\n    \\\"sha\\\": \\\"be50cc3383fc2acf4f546d53ed1eb05468344ba3\\\",\\n    \\\"size\\\": 23025,\\n    \\\"url\\\": \\\"https://api.github.com/repos/wanikua/danghuangshang/contents/BUG-REPORT.md?ref=main\\\",\\n    \\\"html_url\\\": \\\"https://github.com/wanikua/danghuangshang/blob/main/BUG-REPORT.md\\\",\\n    \\\"git_url\\\": \\\"https://api.github.com/repos/wanikua/danghuangshang/git/blobs/be50cc3383fc2acf4f546d53ed1eb05468344ba3\\\",\\n    \\\"download_url\\\": \\\"https://raw.githubusercontent.com/wanikua/danghuangshang/main/BUG-REPORT.md\\\",\\n    \\\"type\\\": \\\"file\\\",\\n    \\\"_links\\\": {\\n      \\\"self\\\": \\\"https://api.github.com/repos/wanikua/danghuangshang/contents/BUG-REPORT.md?ref=main\\\",\\n      \\\"git\\\": \\\"https://api.github.com/repos/wanikua/danghuangshang/git/blobs/be50cc3383fc2acf4f546d53ed1eb05468344ba3\\\",\\n      \\\"html\\\": \\\"https://github.com/wanikua/danghuangshang/blob/main/BUG-REPORT.md\\\"\\n    }\\n  },\\n  {\\n    \\\"name\\\": \\\"CHANGELOG.md\\\",\\n    \\\"path\\\": \\\"CHANGELOG.md\\\",\\n    \\\"sha\\\": \\\"a786c5c7eb5837a9a54b89942ee07477b946d5a1\\\",\\n    \\\"size\\\": 4328,\\n    \\\"url\\\": \\\"https://api.github.com/repos/wanikua/danghuangshang/contents/CHANGELOG.