xt())\ntools = data.setdefault('tools', {})\ntools['agentToAgent'] = {\n    'enabled': True,\n    'allow': ['main', 'research', 'execution', 'review', 'qa'],\n    'maxRecursion': 3,\n}\np.write_text(json.dumps(data, ensure_ascii=False, indent=2) + '\\n')\nprint('updated', p)\nPY\npython3 -m json.tool \"$CONFIG\" >/dev/null\nprintf 'backup=%s\\n' \"$BACKUP\"\nopenclaw gateway restart\nsleep 3\nopenclaw status | sed -n '1,120p'\n","workdir":"/root/.openclaw/workspace","yieldMs":10000,"timeout":120,"elevated":true,"security":"full","ask":"on-miss"},"partialJson":"{\"command\":\"set -euo pipefail\\nCONFIG=/root/.openclaw/openclaw.json\\nBACKUP=/root/.openclaw/openclaw.json.bak.$(date +%Y%m%d-%H%M%S)\\ncp \\\"$CONFIG\\\" \\\"$BACKUP\\\"\\npython3 - <<'PY'\\nimport json\\nfrom pathlib import Path\\np = Path('/root/.openclaw/openclaw.json')\\ndata = json.loads(p.read_text())\\ntools = data.setdefault('tools', {})\\ntools['agentToAgent'] = {\\n    'enabled': True,\\n    'allow': ['main', 'research', 'execution', 'review', 'qa'],\\n    'maxRecursion': 3,\\n}\\np.write_text(json.dumps(data, ensure_ascii=False, indent=2) + '\\\\n')\\nprint('updated', p)\\nPY\\npython3 -m json.tool \\\"$CONFIG\\\" >/dev/null\\nprintf 'backup=%s\\\\n' \\\"$BACKUP\\\"\\nopenclaw gateway restart\\nsleep 3\\nopenclaw status | sed -n '1,120p'\\n\",\"workdir\":\"/root/.openclaw/workspace\",\"yieldMs\":10000,\"timeout\":120,\"elevated\":true,\"security\":\"full\",\"ask\":\"on-miss\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":806,"output":361,"cacheRead":26112,"cacheWrite":0,"totalTokens":27279,"cost":{"input":0.0020150000000000003,"output":0.0054150000000000005,"cacheRead":0.006528,"cacheWrite":0,"total":0.013958000000000002}},"stopReason":"toolUse","timestamp":1773908326477}}
