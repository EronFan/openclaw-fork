e what the file contains before proceeding with any specific skills or conversions!\"}]}"},{"type":"text","text":"我直接把你发来的 html 转成一份干净的 md。","textSignature":"{\"v\":1,\"id\":\"msg_0099dfe7541593d80169ba97ec6f8c81918668a86cb5dec424\",\"phase\":\"commentary\"}"},{"type":"toolCall","id":"call_W8nQN8e1yDAarVxRdFXKQ5fm|fc_0099dfe7541593d80169ba97ecd438819197cd1aa0f833a68b","name":"read","arguments":{"file_path":"/root/.openclaw/media/inbound/OpenClaw_自我提升计划---b57aa8bc-482e-4e14-a347-54984ae44ba9"},"partialJson":"{\"file_path\":\"/root/.openclaw/media/inbound/OpenClaw_自我提升计划---b57aa8bc-482e-4e14-a347-54984ae44ba9\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":24860,"output":107,"cacheRead":1536,"cacheWrite":0,"totalTokens":26503,"cost":{"input":0.062150000000000004,"output":0.001605,"cacheRead":0.000384,"cacheWrite":0,"total":0.064139}},"stopReason":"toolUse","timestamp":1773836254798}}
{"type":"message","id":"61d6edad","parentId":"aedda269","timestamp":"2026-03-18T12:17:51.984Z","message":{"role":"toolResult","toolCallId":"call_W8nQN8e1yDAarVxRdFXKQ5fm|fc_0099dfe7541593d80169ba97ecd438819197cd1aa0f833a68b","toolName":"read","content":[{"type":"text","text":"<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\">\n<html>\n<head>\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\">\n  <meta http-equiv=\"Content-Style-Type\" content=\"text/css\">\n  <title></title>\n  <meta name=\"Generator\" content=\"Cocoa HTML Writer\">\n  <meta name=\"CocoaVersion\" content=\"2575.3\">\n  <style type=\"text/css\">\n    p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Times; -webkit-text-stroke: #000000}\n    p.p2 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Times; -webkit-text-stroke: #000000; min-height: 14.0px}\n    li.li1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Times; -webkit-text-stroke: #000000}\n    li.li3 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Times}\n    span.s1 {font-kerning: none}\n    span.s2 {-webkit-text-stroke: 0px #000000}\n    span.s3 {font-kerning: none; -webkit-text-stroke: 0px #000000}\n    ol.ol1 {list-style-type: decimal}\n    ul.ul1 {list-style-type: disc}\n  </style>\n</head>\n<body>\n<p class=\"p1\"><span class=\"s1\"><b>OpenClaw 自我提升计划：Bug Hunting &amp; Submission Program</b></span></p>\n<p class=\"p1\"><span class=\"s1\"><b>一、目标</b></span></p>\n<p class=\"p1\"><span class=\"s1\">为 OpenClaw 建立一套可持续的缺陷发现与反馈机制，目标不是“随便提几个 bug”，而是形成一条长期有效的质量提升流水线：</span></p>\n<ol class=\"ol1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">主动发现 bug</span></li>\n</ol>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">本地安装 / 升级 / 配置 / 多渠道接入</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">工具调用</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">浏览器 / 节点 / sessions / subagents</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">文档与实际行为不一致</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">边界条件、权限、异常恢复</span></li>\n</ul>\n<ol class=\"ol1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">验证社区反馈</span></li>\n</ol>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">搜索公开讨论、GitHub issues、文档反馈、群聊吐槽点</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">复测是否仍存在</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">判断是不是重复问题、设计缺陷、文档缺陷、易用性缺陷</span></li>\n</ul>\n<ol class=\"ol1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">标准化输出</span></li>\n</ol>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">高质量 issue</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">最小复现步骤</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">环境信息</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">日志片段</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">根因猜测</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">修复建议</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">必要时 PR</span></li>\n</ul>\n<ol class=\"ol1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">沉淀测试资产</span></li>\n</ol>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">场景清单</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">回归测试清单</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">常见故障数据库</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">高风险模块地图</span></li>\n</ul>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>二、团队规模建议</b></span></p>\n<p class=\"p1\"><span class=\"s1\"><b>推荐配置：5 人</b></span></p>\n<p class=\"p1\"><span class=\"s1\">这是我认为最稳的配置。</span></p>\n<p class=\"p1\"><span class=\"s1\">少于 3 人，容易变成“想到哪测到哪”；</span></p>\n<p class=\"p1\"><span class=\"s1\">超过 7 人，沟通成本开始大于收益。</span></p>\n<p class=\"p1\"><span class=\"s1\">1）总监 / 负责人（你指定我扮演）</span></p>\n<p class=\"p1\"><span class=\"s1\">职责：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">制定策略和节奏</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">定义优先级</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">判断 issue 是否值得提交</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">把控输出质量</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">决定是否升级为 PR / 文档修复 / 测试补充</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">2）侦察员（Research Scout）</span></p>\n<p class=\"p1\"><span class=\"s1\">职责：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">搜集外部 bug 线索</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">查 GitHub issue、讨论区、文档、社区反馈</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">整理“高频吐槽点”</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">建立候选问题池</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">3）复现工程师（Reproduction Engineer）</span></p>\n<p class=\"p1\"><span class=\"s1\">职责：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">复现问题</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">控制变量</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">记录最小步骤</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">明确“必现 / 概率复现 / 环境相关 / 用户误用”</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">4）系统诊断工程师（Diagnostics Engineer）</span></p>\n<p class=\"p1\"><span class=\"s1\">职责：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">看日志</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">跑状态命令</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">对照源码 / docs / runtime 行为</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">缩小问题范围</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">提出 root cause 假设</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">5）交付工程师（Issue &amp; PR Engineer）</span></p>\n<p class=\"p1\"><span class=\"s1\">职责：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">输出标准化 issue</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">补最小示例</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">必要时准备 PR / 文档修复</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">跟踪 maintainer 反馈</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">做回归记录</span></li>\n</ul>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>三、如果要更强：7 人增强版</b></span></p>\n<p class=\"p1\"><span class=\"s1\">如果你真要组一个项目群，建议最多上到 7 人，再多就吵。</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">在 5 人基础上加两位：</span></p>\n<p class=\"p1\"><span class=\"s1\">6）混沌测试员（Chaos Tester）</span></p>\n<p class=\"p1\"><span class=\"s1\">专门搞：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">异常输入</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">配置缺失</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">网络抖动</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">权限不足</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li3\"><span class=\"s3\">超时</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">长 session</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">多 agent 并发</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">长上下文 / 大文件 / 多工具连续调用</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">7）文档一致性审计员（Docs QA）</span></p>\n<p class=\"p1\"><span class=\"s1\">专门查：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">官网步骤能不能走通</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">docs 和 CLI 实际行为是否一致</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">参数名、默认值、版本要求是否一致</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">“用户以为能用，实际不能用”的文档坑</span></li>\n</ul>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>四、为什么这样分工</b></span></p>\n<p class=\"p1\"><span class=\"s1\">OpenClaw 这种项目的 bug 来源，不只是代码错误，至少有 6 类：</span></p>\n<ol class=\"ol1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">安装/环境类</span></li>\n</ol>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">Node 版本差异</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">权限问题</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">插件未装全</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">路径 / env / 配置兼容性</span></li>\n</ul>\n<ol class=\"ol1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">交互类</span></li>\n</ol>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">channel 行为差异</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">reply tag</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">message tool 的边界行为</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">多 session / thread 上下文混乱</span></li>\n</ul>\n<ol class=\"ol1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">工具类</span></li>\n</ol>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">browser / exec / sessions / memory / message / docs 工具行为不一致</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">输出格式和预期不匹配</span></li>\n</ul>\n<ol class=\"ol1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">文档类</span></li>\n</ol>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">官网可读但不可执行</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">示例过时</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">隐含前提没写清楚</span></li>\n</ul>\n<ol class=\"ol1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">回归类</span></li>\n</ol>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">新版本修了 A，又坏了 B</span></li>\n</ul>\n<ol class=\"ol1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">产品设计缺陷</span></li>\n</ol>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">不是 crash，但非常容易误用</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">用户体验导致高频错误</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">所以必须拆角色，不然最后所有人都在“随手测”，没有产出密度。</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>五、实施方案</b></span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>Phase 0：定义任务边界（半天）</b></span></p>\n<p class=\"p1\"><span class=\"s1\">产出</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">Bug 分类标准</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">严重级别标准</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">提交标准</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">团队协作规则</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">Bug 分类</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">P0：核心功能不可用 / 数据风险 / 严重安全问题</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">P1：主流程失败，用户显著受阻</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">P2：次流程失败，有 workaround</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">P3：文档、提示、边缘行为、体验缺陷</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">问题类型标签</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">install</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">onboarding</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">gateway</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">channel</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">tools</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">browser</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">memory</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">sessions</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">docs</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">regression</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li3\"><span class=\"s3\">ux</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">security</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">performance</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">提交标准</span></p>\n<p class=\"p1\"><span class=\"s1\">只有满足下面条件之一才提交 GitHub：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">能稳定复现</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">影响明显</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">文档与实际行为明确不一致</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">社区已有多人反馈但缺高质量复现</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">即使不稳定，但影响严重且证据充分</span></li>\n</ul>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>Phase 1：建立 Bug 候选池（1-2 天）</b></span></p>\n<p class=\"p1\"><span class=\"s1\">来源 1：主动探索</span></p>\n<p class=\"p1\"><span class=\"s1\">围绕 OpenClaw 的关键主流程逐项走查：</span></p>\n<p class=\"p1\"><span class=\"s1\">A. 安装与启动链路</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">安装依赖</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">openclaw 基础命令</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">gateway start / stop / restart / status</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">首次配置</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">版本升级</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">缺少依赖时的报错质量</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">B. Onboarding 链路</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">新用户从 0 到可用</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">API key 配置</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">模型配置</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">渠道接入</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">Web 控制台</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">C. 核心 agent 链路</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">direct chat</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">group chat</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">reply tags</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">sessions</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">subagents</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">acp harness</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">多轮上下文</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">D. 核心工具链路</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">exec</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">process</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">browser</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">web_fetch</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">memory_search / memory_get</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">feishu / message / canvas / nodes</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">E. 文档链路</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">docs 步骤逐条执行</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">示例命令实际是否可跑</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">参数与默认行为是否一致</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">来源 2：社区反馈</span></p>\n<p class=\"p1\"><span class=\"s1\">重点找这些线索：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">GitHub issues</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">GitHub discussions</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">提交记录中的 “fix”, “broken”, “regression”</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">文档页面反馈</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">社区群提到的问题</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">用户安装踩坑文章</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">来源 3：逆向思考</span></p>\n<p class=\"p1\"><span class=\"s1\">专门测这些高风险场景：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">命令存在但依赖没装</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">API key 缺失</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">权限不足</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">并发 tool call</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">长日志截断</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">session thread 错乱</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">browser relay 未 attach</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">文件超大 / 输出超长</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">多 channel 混用</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">中文 / emoji / 特殊字符</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">非预期关闭 / 中断恢复</span></li>\n</ul>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>Phase 2：复现与证据化（持续进行）</b></span></p>\n<p class=\"p1\"><span class=\"s1\">每个候选 bug 必须形成标准记录卡。</span></p>\n<p class=\"p1\"><span class=\"s1\"><b>Bug 卡模板</b></span></p>\n<p class=\"p1\"><span class=\"s1\"># 标题</span></p>\n<p class=\"p1\"><span class=\"s1\">一句话描述问题</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 环境</span></p>\n<p class=\"p1\"><span class=\"s1\">- OpenClaw version:</span></p>\n<p class=\"p1\"><span class=\"s1\">- OS:</span></p>\n<p class=\"p1\"><span class=\"s1\">- Node:</span></p>\n<p class=\"p1\"><span class=\"s1\">- Channel/Tool:</span></p>\n<p class=\"p1\"><span class=\"s1\">- Model:</span></p>\n<p class=\"p1\"><span class=\"s1\">- 是否首次安装/升级后:</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 预期行为</span></p>\n<p class=\"p1\"><span class=\"s1\">应该发生什么</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 实际行为</span></p>\n<p class=\"p1\"><span class=\"s1\">实际发生什么</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 最小复现步骤</span></p>\n<p class=\"p1\"><span class=\"s1\">1.</span></p>\n<p class=\"p1\"><span class=\"s1\">2.</span></p>\n<p class=\"p1\"><span class=\"s1\">3.</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 复现频率</span></p>\n<p class=\"p1\"><span class=\"s1\">- 必现 / 高概率 / 偶发</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 日志/报错</span></p>\n<p class=\"p1\"><span class=\"s1\">贴关键片段</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 影响范围</span></p>\n<p class=\"p1\"><span class=\"s1\">谁会受影响，影响多大</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 初步判断</span></p>\n<p class=\"p1\"><span class=\"s1\">- docs 问题 / 逻辑问题 / 兼容性问题 / UX 问题 / 回归问题</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 建议</span></p>\n<p class=\"p1\"><span class=\"s1\">给 maintainer 的修复方向建议</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>Phase 3：分流处理（Issue / PR / Docs Fix）</b></span></p>\n<p class=\"p1\"><span class=\"s1\">不是所有问题都该直接开 bug issue。</span></p>\n<p class=\"p1\"><span class=\"s1\">A. 提 GitHub Issue</span></p>\n<p class=\"p1\"><span class=\"s1\">适合：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">真实缺陷</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">行为不符合文档</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">错误提示极差导致用户无法继续</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">回归问题</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">兼容性问题</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">B. 直接提 PR</span></p>\n<p class=\"p1\"><span class=\"s1\">适合：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">文档修复</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">报错提示优化</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">默认值/校验优化</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">小范围逻辑修正</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">单元测试补充</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">C. 内部留档暂不提</span></p>\n<p class=\"p1\"><span class=\"s1\">适合：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">证据不足</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">只是使用姿势问题</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">社区已有同类 issue 且无新增信息</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">设计取舍，不属于 bug</span></li>\n</ul>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>Phase 4：回归机制（每周）</b></span></p>\n<p class=\"p1\"><span class=\"s1\">每周回归：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">已提交 issue 是否确认</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">已修复问题是否回归通过</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">新版本是否引入新问题</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">文档是否同步更新</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">最终形成：</span></p>\n<ol class=\"ol1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">高风险模块列表</span></li>\n</ol>\n<ol class=\"ol1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">每周 smoke test 清单</span></li>\n</ol>\n<ol class=\"ol1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">已知问题库</span></li>\n</ol>\n<ol class=\"ol1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">回归基线</span></li>\n</ol>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>六、团队成员定义（可直接建群用）</b></span></p>\n<p class=\"p1\"><span class=\"s1\">下面我直接给你每个成员的人设、职责、技能需求、SOUL.md 草稿。</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>1）总监：Project Director</b></span></p>\n<p class=\"p1\"><span class=\"s1\">定位</span></p>\n<p class=\"p1\"><span class=\"s1\">对结果负责，不亲自陷在重复测试里，重点是判断方向、优先级、质量门槛。</span></p>\n<p class=\"p1\"><span class=\"s1\">SOUL.md</span></p>\n<p class=\"p1\"><span class=\"s1\"># SOUL.md</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">你是 OpenClaw Bug Program 的总监。</span></p>\n<p class=\"p1\"><span class=\"s1\">你的职责不是亲自做完所有事，而是确保整个项目高质量推进。</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 核心原则</span></p>\n<p class=\"p1\"><span class=\"s1\">- 结果导向，不做表演式忙碌</span></p>\n<p class=\"p1\"><span class=\"s1\">- 优先级高于工作量</span></p>\n<p class=\"p1\"><span class=\"s1\">- 不提交证据不足的问题</span></p>\n<p class=\"p1\"><span class=\"s1\">- 不允许低质量 issue 污染项目</span></p>\n<p class=\"p1\"><span class=\"s1\">- 每个结论都要能被复核</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 风格</span></p>\n<p class=\"p1\"><span class=\"s1\">- 直接、果断、少废话</span></p>\n<p class=\"p1\"><span class=\"s1\">- 先判断值不值得做，再安排谁做</span></p>\n<p class=\"p1\"><span class=\"s1\">- 遇到争议，回到证据</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 你的输出必须包含</span></p>\n<p class=\"p1\"><span class=\"s1\">- 优先级</span></p>\n<p class=\"p1\"><span class=\"s1\">- 负责人</span></p>\n<p class=\"p1\"><span class=\"s1\">- 截止时间</span></p>\n<p class=\"p1\"><span class=\"s1\">- 验收标准</span></p>\n<p class=\"p1\"><span class=\"s1\">- 风险点</span></p>\n<p class=\"p1\"><span class=\"s1\">任务</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">任务拆解</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">每日分配</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">issue 质量审核</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">周报输出</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">需要的 skills</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">github</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">summarize</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">healthcheck（排查运行环境问题时）</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">Agent Browser（测试 Web UI 时）</span></li>\n</ul>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>2）侦察员：Research Scout</b></span></p>\n<p class=\"p1\"><span class=\"s1\">定位</span></p>\n<p class=\"p1\"><span class=\"s1\">全网找线索，不负责最后定性，但要尽量找到“高价值、多人踩坑”的问题。</span></p>\n<p class=\"p1\"><span class=\"s1\">SOUL.md</span></p>\n<p class=\"p1\"><span class=\"s1\"># SOUL.md</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">你是问题侦察员。</span></p>\n<p class=\"p1\"><span class=\"s1\">你的职责是搜集 OpenClaw 相关的缺陷线索，而不是凭感觉下结论。</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 核心原则</span></p>\n<p class=\"p1\"><span class=\"s1\">- 搜集证据，不制造噪音</span></p>\n<p class=\"p1\"><span class=\"s1\">- 线索要分类，不要堆链接</span></p>\n<p class=\"p1\"><span class=\"s1\">- 高价值线索优先：高频、近期、影响主流程</span></p>\n<p class=\"p1\"><span class=\"s1\">- 已知重复问题要标记，不重复造轮子</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 风格</span></p>\n<p class=\"p1\"><span class=\"s1\">- 像调查记者，不像营销号</span></p>\n<p class=\"p1\"><span class=\"s1\">- 简洁、敏锐、会归纳</span></p>\n<p class=\"p1\"><span class=\"s1\">- 发现问题时先问：这是孤例，还是系统性问题？</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 你的输出必须包含</span></p>\n<p class=\"p1\"><span class=\"s1\">- 来源</span></p>\n<p class=\"p1\"><span class=\"s1\">- 时间</span></p>\n<p class=\"p1\"><span class=\"s1\">- 症状</span></p>\n<p class=\"p1\"><span class=\"s1\">- 影响对象</span></p>\n<p class=\"p1\"><span class=\"s1\">- 是否疑似重复</span></p>\n<p class=\"p1\"><span class=\"s1\">- 建议优先级</span></p>\n<p class=\"p1\"><span class=\"s1\">任务</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">搜 GitHub</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">搜社区讨论</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">搜文档反馈</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">建立 bug 候选池</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">需要的 skills</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">github</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">summarize</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">multi-search-engine / tavily（二选一，做网络检索增强）</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">skill-vetter（如果后续想装额外测试 skill）</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">如果后面要装搜索类 skill，先按你给的 store policy：</span></p>\n<p class=\"p1\"><span class=\"s1\">先 skillhub，找不到再 clawhub。安装前做来源、版本、风险摘要。</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>3）复现工程师：Reproduction Engineer</b></span></p>\n<p class=\"p1\"><span class=\"s1\">定位</span></p>\n<p class=\"p1\"><span class=\"s1\">把“有人说有 bug”变成“这里真的有 bug，而且这 5 步能复现”。</span></p>\n<p class=\"p1\"><span class=\"s1\">SOUL.md</span></p>\n<p class=\"p1\"><span class=\"s1\"># SOUL.md</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">你是复现工程师。</span></p>\n<p class=\"p1\"><span class=\"s1\">你不负责空谈，你负责把问题钉死。</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 核心原则</span></p>\n<p class=\"p1\"><span class=\"s1\">- 最小复现优先</span></p>\n<p class=\"p1\"><span class=\"s1\">- 控制变量</span></p>\n<p class=\"p1\"><span class=\"s1\">- 一次只改一个条件</span></p>\n<p class=\"p1\"><span class=\"s1\">- 不能稳定复现，就不要说“确定存在”</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 风格</span></p>\n<p class=\"p1\"><span class=\"s1\">- 冷静、机械、严谨</span></p>\n<p class=\"p1\"><span class=\"s1\">- 不脑补，不跳步</span></p>\n<p class=\"p1\"><span class=\"s1\">- 每个问题都要写成别人能重复成功的步骤</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 你的输出必须包含</span></p>\n<p class=\"p1\"><span class=\"s1\">- 环境</span></p>\n<p class=\"p1\"><span class=\"s1\">- 前置条件</span></p>\n<p class=\"p1\"><span class=\"s1\">- 复现步骤</span></p>\n<p class=\"p1\"><span class=\"s1\">- 实际结果</span></p>\n<p class=\"p1\"><span class=\"s1\">- 预期结果</span></p>\n<p class=\"p1\"><span class=\"s1\">- 复现频率</span></p>\n<p class=\"p1\"><span class=\"s1\">任务</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">安装测试</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">升级测试</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">场景复测</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">多平台 / 多配置交叉验证</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">需要的 skills</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">github</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">tmux（如果需要远控交互式 CLI）</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">Agent Browser（Web 控制台复现）</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">healthcheck（环境差异排查）</span></li>\n</ul>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>4）系统诊断工程师：Diagnostics Engineer</b></span></p>\n<p class=\"p1\"><span class=\"s1\">定位</span></p>\n<p class=\"p1\"><span class=\"s1\">像法医，负责日志、调用链、配置、源码定位。</span></p>\n<p class=\"p1\"><span class=\"s1\">SOUL.md</span></p>\n<p class=\"p1\"><span class=\"s1\"># SOUL.md</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">你是系统诊断工程师。</span></p>\n<p class=\"p1\"><span class=\"s1\">你的职责是缩小问题范围，给出高可信的根因判断。</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 核心原则</span></p>\n<p class=\"p1\"><span class=\"s1\">- 看日志，不猜</span></p>\n<p class=\"p1\"><span class=\"s1\">- 先确认问题在哪一层：环境、配置、CLI、网关、工具、渠道、模型、文档</span></p>\n<p class=\"p1\"><span class=\"s1\">- 判断根因时要标明证据强弱</span></p>\n<p class=\"p1\"><span class=\"s1\">- 不把“相关性”说成“因果性”</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 风格</span></p>\n<p class=\"p1\"><span class=\"s1\">- 技术法医</span></p>\n<p class=\"p1\"><span class=\"s1\">- 只说有依据的话</span></p>\n<p class=\"p1\"><span class=\"s1\">- 结论要可追溯</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 你的输出必须包含</span></p>\n<p class=\"p1\"><span class=\"s1\">- 观察到的现象</span></p>\n<p class=\"p1\"><span class=\"s1\">- 关键日志</span></p>\n<p class=\"p1\"><span class=\"s1\">- 涉及模块</span></p>\n<p class=\"p1\"><span class=\"s1\">- 可能根因（按置信度排序）</span></p>\n<p class=\"p1\"><span class=\"s1\">- 建议下一步验证动作</span></p>\n<p class=\"p1\"><span class=\"s1\">任务</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">日志提取</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">错误路径分析</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">文档 vs 行为核对</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">风险评估</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">需要的 skills</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">github</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">healthcheck</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">Agent Browser</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">summarize（用于快速读长文档 / 变更说明）</span></li>\n</ul>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>5）交付工程师：Issue &amp; PR Engineer</b></span></p>\n<p class=\"p1\"><span class=\"s1\">定位</span></p>\n<p class=\"p1\"><span class=\"s1\">把前面所有人的信息压缩成 maintainer 愿意看、能快速处理的高质量提交。</span></p>\n<p class=\"p1\"><span class=\"s1\">SOUL.md</span></p>\n<p class=\"p1\"><span class=\"s1\"># SOUL.md</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">你是交付工程师。</span></p>\n<p class=\"p1\"><span class=\"s1\">你的职责是把问题包装成高质量 issue 或可合并 PR。</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 核心原则</span></p>\n<p class=\"p1\"><span class=\"s1\">- 维护者时间宝贵</span></p>\n<p class=\"p1\"><span class=\"s1\">- 标题要准确</span></p>\n<p class=\"p1\"><span class=\"s1\">- 复现要短</span></p>\n<p class=\"p1\"><span class=\"s1\">- 证据要够</span></p>\n<p class=\"p1\"><span class=\"s1\">- 建议要具体</span></p>\n<p class=\"p1\"><span class=\"s1\">- 不情绪化，不指责</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 风格</span></p>\n<p class=\"p1\"><span class=\"s1\">- 专业、克制、清晰</span></p>\n<p class=\"p1\"><span class=\"s1\">- 写给维护者，不是写给围观群众</span></p>\n<p class=\"p1\"><span class=\"s1\">- 每一个 issue 都要像“可执行任务单”</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 你的输出必须包含</span></p>\n<p class=\"p1\"><span class=\"s1\">- 标题</span></p>\n<p class=\"p1\"><span class=\"s1\">- 背景</span></p>\n<p class=\"p1\"><span class=\"s1\">- 最小复现</span></p>\n<p class=\"p1\"><span class=\"s1\">- 环境</span></p>\n<p class=\"p1\"><span class=\"s1\">- 影响</span></p>\n<p class=\"p1\"><span class=\"s1\">- 附件/日志</span></p>\n<p class=\"p1\"><span class=\"s1\">- 建议修复方向</span></p>\n<p class=\"p1\"><span class=\"s1\">任务</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">写 issue</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">写 PR 描述</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">跟进 maintainer 反馈</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">记录状态变化</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">需要的 skills</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">github</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">summarize</span></li>\n</ul>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>七、建议的最小技能栈</b></span></p>\n<p class=\"p1\"><span class=\"s1\">如果这个项目群真的要跑起来，我建议先配这些技能：</span></p>\n<p class=\"p1\"><span class=\"s1\"><b>必备</b></span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">github查 issues、PR、runs、API</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">summarize快速总结文档、issue 讨论、长日志、变更说明</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">Agent Browser测 Web 控制台、docs 页面交互</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\"><b>可选增强</b></span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">healthcheck用于判断环境问题、权限问题、系统配置问题</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">tmux如果要同时操控多终端做交互式复现，很有用</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">multi-search-engine 或 tavily用于外网搜 bug 线索</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\"><b>不建议一上来就装一堆</b></span></p>\n<p class=\"p1\"><span class=\"s1\">先把流程跑通，再扩 skill。</span></p>\n<p class=\"p1\"><span class=\"s1\">否则容易变成“在搭平台，不在找 bug”。</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>八、实际执行节奏</b></span></p>\n<p class=\"p1\"><span class=\"s1\"><b>第 1 周：搭建与摸底</b></span></p>\n<p class=\"p1\"><span class=\"s1\">目标：拿到第一批高质量问题</span></p>\n<p class=\"p1\"><span class=\"s1\">Day 1</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">建项目群</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">定义角色</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">建 bug 表</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">列测试矩阵</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">梳理 OpenClaw 关键主流程</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">Day 2-3</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">安装 / onboarding / docs / 核心命令走查</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">搜社区 bug 线索</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">形成 bug 候选池 20-30 条</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\">Day 4-5</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">重点复现前 10 条</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">过滤掉误报 / 重复 / 设计问题</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">输出首批 issue 3-8 条</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\"><b>第 2 周：深挖与回归</b></span></p>\n<p class=\"p1\"><span class=\"s1\">目标：从“找明显问题”转向“找结构性问题”</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">多平台 / 多配置测试</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">并发、长 session、边界输入</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">新版本回归</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">争取输出 1-3 个 PR</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\"><b>第 3 周以后：常态化</b></span></p>\n<p class=\"p1\"><span class=\"s1\">目标：形成可复制机制</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">每周固定一次 smoke test</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">每周一轮 issue triage</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">每月一次 docs 一致性审计</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">每次版本更新做回归</span></li>\n</ul>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>九、建议的测试矩阵</b></span></p>\n<p class=\"p1\"><span class=\"s1\">这个是关键，没矩阵就容易瞎测。</span></p>\n<p class=\"p1\"><span class=\"s1\"><b>环境维度</b></span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">Node 22 LTS</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">Node 24</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">Linux</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">macOS（如果你后面用自己机器参与）</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\"><b>形态维度</b></span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">首次安装</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">已安装升级</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">配置完整</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">配置缺失</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">权限不足</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\"><b>功能维度</b></span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">gateway</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">sessions</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">subagents</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">browser</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">exec/process</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">memory</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">message</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">docs walkthrough</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\"><b>渠道维度</b></span></p>\n<p class=\"p1\"><span class=\"s1\">优先测你真实会用的渠道：</span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">Feishu</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">Telegram / Discord（如果后续接入）</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">direct chat</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">group chat</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\"><b>异常维度</b></span></p>\n<ul class=\"ul1\">\n  <li class=\"li3\"><span class=\"s3\">超时</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li3\"><span class=\"s3\">中断</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li3\"><span class=\"s3\">并发</span></li>\n</ul>\n\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">空输入</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">大输入</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">特殊字符</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">多语言</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">无权限</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">未连接 relay</span></li>\n</ul>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>十、GitHub Issue 提交标准</b></span></p>\n<p class=\"p1\"><span class=\"s1\">为了避免丢人，我建议团队统一采用以下标准：</span></p>\n<p class=\"p1\"><span class=\"s1\"><b>可以提的 issue</b></span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">主流程 broken</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">报错误导用户</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">文档明显无法执行</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">回归问题</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">工具输出不符合接口契约</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">多人可复现 / 证据充分</span></li>\n</ul>\n<p class=\"p1\"><span class=\"s1\"><b>不该提的 issue</b></span></p>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">没复现成功只凭猜测</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">本地环境污染导致的问题，未排除环境因素</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">文档没认真看就报错</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">已有 issue 但你没补充新信息</span></li>\n</ul>\n<ul class=\"ul1\">\n  <li class=\"li1\"><span class=\"s2\"></span><span class=\"s1\">本质上是 feature request，却伪装成 bug</span></li>\n</ul>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\"><b>十一、项目群工作流建议</b></span></p>\n<p class=\"p1\"><span class=\"s1\">如果你建群，我建议群内只跑 4 种消息：</span></p>\n<p class=\"p1\"><span class=\"s1\"><b>1）线索上报</b></span></p>\n<p class=\"p1\"><span class=\"s1\">[线索]</span></p>\n<p class=\"p1\"><span class=\"s1\">来源：</span></p>\n<p class=\"p1\"><span class=\"s1\">症状：</span></p>\n<p class=\"p1\"><span class=\"s1\">疑似模块：</span></p>\n<p class=\"p1\"><span class=\"s1\">初步优先级：</span></p>\n<p class=\"p1\"><span class=\"s1\"><b>2）复现完成</b></span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">[复现完成]</span></p>\n<p class=\"p1\"><span class=\"s1\">问题：</span></p>\n<p class=\"p1\"><span class=\"s1\">环境：</span></p>\n<p class=\"p1\"><span class=\"s1\">步骤：</span></p>\n<p class=\"p1\"><span class=\"s1\">结果：</span></p>\n<p class=\"p1\"><span class=\"s1\">频率：</span></p>\n<p class=\"p1\"><span class=\"s1\">结论：</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">## 3）诊断报告</span></p>\n<p class=\"p1\"><span class=\"s1\">```md</span></p>\n<p class=\"p1\"><span class=\"s1\">[诊断]</span></p>\n<p class=\"p1\"><span class=\"s1\">问题：</span></p>\n<p class=\"p1\"><span class=\"s1\">涉及模块：</span></p>\n<p class=\"p1\"><span class=\"s1\">关键日志：</span></p>\n<p class=\"p1\"><span class=\"s1\">根因判断：</span></p>\n<p class=\"p1\"><span class=\"s1\">建议动作：</span></p>\n<p class=\"p1\"><span class=\"s1\"><b>4）交付确认</b></span></p>\n<p class=\"p1\"><span class=\"s1\">[交付]</span></p>\n<p class=\"p1\"><span class=\"s1\">GitHub Issue / PR：</span></p>\n<p class=\"p1\"><span class=\"s1\">标题：</span></p>\n<p class=\"p1\"><span class=\"s1\">链接：</span></p>\n<p class=\"p1\"><span class=\"s1\">状态：</span></p>\n<p class=\"p1\"><span class=\"s1\">后续跟进人：</span></p>\n<p class=\"p2\"><span class=\"s1\"></span><br></p>\n<p class=\"p1\"><span class=\"s1\">避免群里刷“收到”“我看看”“感觉像是这个”。</span></p>\n</body>\n</html>\n"}],"isError":false,"timestamp":1773836271978}}
