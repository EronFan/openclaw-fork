st msg = {\\n    protocol: 'gep-a2a',\\n    protocol_version: '1.0.0',\\n    message_type: 'hello',\\n    message_id: 'msg_' + Date.now() + '_rotate',\\n    sender_id: nodeId,\\n    timestamp: new Date().toISOString(),\\n    payload: {\\n      capabilities: {},\\n      gene_count: 0,\\n      capsule_count: 0,\\n      rotate_secret: true\\n    }\\n  };\\n  const res = await fetch(endpoint, {\\n    method: 'POST',\\n    headers: buildHubHeaders(),\\n    body: JSON.stringify(msg),\\n    signal: AbortSignal.timeout(15000),\\n  });\\n  const data = await res.json();\\n  console.log(JSON.stringify(data, null, 2));\\n})();\\nNODE\",\"timeout\":30000}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":3814,"output":556,"cacheRead":44416,"cacheWrite":0,"totalTokens":48786,"cost":{"input":0.009535,"output":0.00834,"cacheRead":0.011104,"cacheWrite":0,"total":0.028979}},"stopReason":"toolUse","timestamp":1773669727939}}
