.js:104:  return (process.env.A2A_HUB_URL || '').replace(/\\/+$/, '');\n/root/.openclaw/workspace/skills/capability-evolver/src/gep/a2aProtocol.js:75:  if (process.env.A2A_NODE_ID) {\n/root/.openclaw/workspace/skills/capability-evolver/src/gep/a2aProtocol.js:76:    _cachedNodeId = String(process.env.A2A_NODE_ID);\n/root/.openclaw/workspace/skills/capability-evolver/src/gep/a2aProtocol.js:86:  console.warn('[a2aProtocol] A2A_NODE_ID is not set. Computing node ID from device fingerprint. ' +\n/root/.openclaw/workspace/skills/capability-evolver/src/gep/a2aProtocol.js:88:    'Set A2A_NODE_ID after registering at https://evomap.ai to use a stable identity.');\n/root/.openclaw/workspace/skills/capability-evolver/src/gep/a2aProtocol.js:147:  var nodeSecret = process.env.A2A_NODE_SECRET || getNodeId();\n/root/.openclaw/workspace/skills/capability-evolver/src/gep/a2aProtocol.js:183:  var nodeSecret = process.env.A2A_NODE_SECRET || getNodeId();\n/root/.openclaw/workspace/skills/capability-evolver/src/gep/a2aProtocol.js:355:  var hubUrl = (opts && opts.hubUrl) || process.env.A2A_HUB_URL;\n/root/.openclaw/workspace/skills/capability-evolver/src/gep/a2aProtocol.js:356:  if (!hubUrl) return { ok: false, error: 'A2A_HUB_URL not set' };\n/root/.openclaw/workspace/skills/capability-evolver/src/gep/a2aProtocol.js:370:  var hubUrl = (opts && opts.hubUrl) || process.env.A2A_HUB_URL;\n/root/.openclaw/workspace/skills/capability-evolver/src/gep/a2aProtocol.js:432:  return process.env.A2A_HUB_URL || process.env.EVOMAP_HUB_URL || '';\n/root/.openclaw/workspace/skills/capability-evolver/src/gep/a2aProtocol.js:472:  if (process.env.A2A_NODE_SECRET) return process.env.A2A_NODE_SECRET;\n/root/.openclaw/workspace/skills/capability-evolver/src/gep/taskReceiver.js:11:const HUB_URL = process.env.A2A_HUB_URL || process.env.EVOMAP_HUB_URL || 'https://evomap.ai';\n/root/.openclaw/workspace/skills/capability-evolver/test/a2aProtocol.test.js:148:    originalHubUrl = process.env.A2A_HUB_URL;\n/root/.openclaw/workspace/skills/capability-evolver/test/a2aProtocol.test.js:150:    process.env.A2A_HUB_URL = 'http://localhost:19999';\n/root/.openclaw/workspace/skills/capability-evolver/test/a2aProtocol.test.js:158:      delete process.env.A2A_HUB_URL;\n/root/.openclaw/workspace/skills/capability-evolver/test/a2aProtocol.test.js:160:      process.env.A2A_HUB_URL = originalHubUrl;\n/root/.openclaw/workspace/skills/capability-evolver/README.zh-CN.md:230:- [WeZZard](https://github.com/WeZZard) -- 为 SKILL.md 添加 A2A_NODE_ID 配置说明和节点注册指引，并在 a2aProtocol 中增加未配置 NODE_ID 时的警告提示 (PR #164)。\n/root/.openclaw/workspace/skills/capability-evolver/SKILL.md:10:      env: [A2A_NODE_ID]\n/root/.openclaw/workspace/skills/capability-evolver/SKILL.md:22:    - name: A2A_NODE_ID\n/root/.openclaw/workspace/skills/capability-evolver/SKILL.md:25:    - name: A2A_HUB_URL\n/root/.openclaw/workspace/skills/capability-evolver/SKILL.md:29:    - name: A2A_NODE_SECRET\n/root/.openclaw/workspace/skills/capability-evolver/SKILL.md:73:    - host: evomap.ai (or A2A_HUB_URL)\n/root/.openclaw/workspace/skills/capability-evolver/SKILL.md:75:      auth: A2A_NODE_SECRET (Bearer)\n/root/.openclaw/workspace/skills/capability-evolver/SKILL.md:151:export A2A_NODE_ID=node_xxxxxxxxxxxx\n/root/.openclaw/workspace/skills/capability-evolver/SKILL.md:157:{ \"env\": { \"A2A_NODE_ID\": \"node_xxxxxxxxxxxx\", \"A2A_HUB_URL\": \"https://evomap.ai\" } }\n/root/.openclaw/workspace/skills/capability-evolver/SKILL.md:160:Do not hardcode the node ID in scripts. `getNodeId()` in `src/gep/a2aProtocol.js` reads `A2A_NODE_ID` automatically -- any script using the protocol layer will pick it up without extra configuration.\n/root/.openclaw/workspace/skills/capability-evolver/SKILL.md:168:| `A2A_NODE_ID` | (required) | Your EvoMap node identity. Set after node registration -- never hardcode in scripts. |\n/root/.openclaw/workspace/skills/capability-evolver/SKILL.md:174:| `A2A_HUB_URL` | `https://evomap.ai` | EvoMap Hub API base URL. |\n/root