"python3 - <<'PY'\nimport json, glob, shutil, time, os\nfrom pathlib import Path\n\ndef clean(obj):\n    changed = False\n    # remove provider block\n    providers = obj.get('providers')\n    if isinstance(providers, dict) and 'siliconflow' in providers:\n        providers.pop('siliconflow', None)\n        changed = True\n    # clean default/fallback/model maps recursively where relevant\n    agents = obj.get('agents')\n    if isinstance(agents, dict):\n        defaults = agents.get('defaults')\n        if isinstance(defaults, dict):\n            model = defaults.get('model')\n            if isinstance(model, dict):\n                fallbacks = model.get('fallbacks')\n                if isinstance(fallbacks, list):\n                    nf = [x for x in fallbacks if not (isinstance(x, str) and x.startswith('siliconflow/'))]\n                    if nf != fallbacks:\n                        model['fallbacks'] = nf\n                        changed = True\n                primary = model.get('primary')\n                if isinstance(primary, str) and primary.startswith('siliconflow/'):\n                    model['primary'] = 'openai-codex/gpt-5.4'\n                    changed = True\n            models = defaults.get('models')\n            if isinstance(models, dict):\n                keys = [k for k in models if isinstance(k, str) and k.startswith('siliconflow/')]\n                for k in keys:\n                    models.pop(k, None)\n                    changed = True\n    return changed\n\npaths = ['/root/.openclaw/openclaw.json'] + glob.glob('/root/.openclaw/agents/*/agent/models.json')\nnow = time.strftime('%Y%m%d-%H%M%S')\nchanged_paths = []\nfor p in paths:\n    path = Path(p)\n    if not path.exists():\n        continue\n    text = path.read_text(encoding='utf-8')\n    data = json.loads(text)\n    changed = clean(data)\n    # generic cleanup for top-level provider-only files\n    if isinstance(data.get('providers'), dict) and 'siliconflow' in data['providers']:\n        data['providers'].pop('siliconflow', None)\n        changed = True\n    if changed:\n        backup = str(path) + f'.pre-remove-siliconflow-{now}.bak'\n        shutil.copy2(path, backup)\n        path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + '\\n', encoding='utf-8')\n        changed_paths.append((str(path), backup))\nprint(json.dumps(changed_paths, ensure_ascii=False, indent=2))\nPY","workdir":"/root/.openclaw/workspace","yieldMs":10000,"timeout":30},"partialJson":"{\"command\":\"python3 - <<'PY'\\nimport json, glob, shutil, time, os\\nfrom pathlib import Path\\n\\ndef clean(obj):\\n    changed = False\\n    # remove provider block\\n    providers = obj.get('providers')\\n    if isinstance(providers, dict) and 'siliconflow' in providers:\\n        providers.pop('siliconflow', None)\\n        changed = True\\n    # clean default/fallback/model maps recursively where relevant\\n    agents = obj.get('agents')\\n    if isinstance(agents, dict):\\n        defaults = agents.get('defaults')\\n        if isinstance(defaults, dict):\\n            model = defaults.get('model')\\n            if isinstance(model, dict):\\n                fallbacks = model.get('fallbacks')\\n                if isinstance(fallbacks, list):\\n                    nf = [x for x in fallbacks if not (isinstance(x, str) and x.startswith('siliconflow/'))]\\n                    if nf != fallbacks:\\n                        model['fallbacks'] = nf\\n                        changed = True\\n                primary = model.get('primary')\\n                if isinstance(primary, str) and primary.startswith('siliconflow/'):\\n                    model['primary'] = 'openai-codex/gpt-5.4'\\n                    changed = True\\n            models = defaults.get('models')\\n            if isinstance(models, dict):\\n                keys = [k for k in models if isinstance(k, str) and k.startswith('siliconflow/')]\\n                for k in keys:\\n                    models.pop(k, None)\\n                    changed = True\\n    return changed\\n\\npaths = ['/root/.openclaw/openclaw.json'] + glob.glob('/root/.openclaw/agents/*/agent/models.json')\\nnow = time.strftime('%Y%m%d-%H%M%S')\\nchanged_paths = []\\nfor p in paths:\\n    path = Path(p)\\n    if not path.exists():\\n        continue\\n    text = path.read_text(encoding='utf-8')\\n    data = json.loads(text)\\n    changed = clean(data)\\n    # generic cleanup for top-level provider-only files\\n    if isinstance(data.get('providers'), dict) and 'siliconflow' in data['providers']:\\n        data['providers'].pop('siliconflow', None)\\n        changed = True\\n    if changed:\\n        backup = str(path) + f'.pre-remove-siliconflow-{now}.bak'\\n        shutil.copy2(path, backup)\\n        path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + '\\\\n', encoding='utf-8')\\n        changed_paths.append((str(path), backup))\\nprint(json.dumps(changed_paths, ensure_ascii=False, indent=2))\\nPY\",\"workdir\":\"/root/.openclaw/workspace\",\"yieldMs\":10000,\"timeout\":30}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":3252,"output":773,"cacheRead":139904,"cacheWrite":0,"totalTokens":143929,"cost":{"input":0.00813,"output":0.011595000000000001,"cacheRead":0.034976,"cacheWrite":0,"total":0.054701}},"stopReason":"toolUse","timestamp":1774177835695}}
