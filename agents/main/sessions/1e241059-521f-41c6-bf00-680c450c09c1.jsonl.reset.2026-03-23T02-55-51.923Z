ot/.openclaw/workspace\",\n      \"compaction\": {\n        \"mode\": \"safeguard\"\n      },\n      \"heartbeat\": {\n        \"model\": \"arkcode/deepseek-v3.2\"\n      },\n      \"maxConcurrent\": 4,\n      \"subagents\": {\n        \"maxConcurrent\": 8\n      }\n    },\n    \"list\": [\n      {\n        \"id\": \"main\",\n        \"default\": true,\n        \"name\": \"主机器人\",\n        \"workspace\": \"/root/.openclaw/workspace\",\n        \"agentDir\": \"/root/.openclaw/agents/main/agent\"\n      },\n      {\n        \"id\": \"xixi\",\n        \"name\": \"兮兮\",\n        \"workspace\": \"/root/.openclaw/workspaces/workspace-xixi\",\n        \"agentDir\": \"/root/.openclaw/agents/xixi/agent\"\n      },\n      {\n        \"id\": \"ling\",\n        \"name\": \"玲玲\",\n        \"workspace\": \"/root/.openclaw/workspaces/workspace-lingling\",\n        \"agentDir\": \"/root/.openclaw/agents/ling/agent\"\n      },\n      {\n        \"id\": \"aoao\",\n        \"name\": \"熬熬\",\n        \"workspace\": \"/root/.openclaw/workspaces/workspace-ao\",\n        \"agentDir\": \"/root/.openclaw/agents/aoao/agent\"\n      },\n      {\n        \"id\": \"weiwei\",\n        \"name\": \"薇薇\",\n        \"workspace\": \"/root/.openclaw/workspaces/workspace-wei\",\n        \"agentDir\": \"/root/.openclaw/agents/weiwei/agent\"\n      }\n    ]\n  },\n  \"tools\": {\n    \"profile\": \"full\",\n    \"sessions\": {\n      \"visibility\": \"all\"\n    },\n    \"agentToAgent\": {\n      \"enabled\": true,\n      \"allow\": [\n        \"main\",\n        \"xixi\",\n        \"ling\",\n        \"aoao\",\n        \"weiwei\"\n      ]\n    }\n  },\n  \"bindings\": [\n    {\n      \"agentId\": \"main\",\n      \"match\": {\n        \"channel\": \"feishu\",\n        \"accountId\": \"default\"\n      }\n    },\n    {\n      \"agentId\": \"xixi\",\n      \"match\": {\n        \"channel\": \"feishu\",\n        \"accountId\": \"xixi\"\n      }\n    },\n    {\n      \"agentId\": \"ling\",\n      \"match\": {