\n    'apiKey':'sk-b79de257f650935b3f593b405f6448067a8b3ac208498d630f162777826b1dd2',\n    'api':'openai-completions',\n    'models':[\n        {'id':'gpt-5.4','name':'GPT-5.4'}\n    ]\n}\n\nagents=data.setdefault('agents', {})\ndefaults=agents.setdefault('defaults', {})\nmodel=defaults.setdefault('model', {})\nold_primary=model.get('primary')\nnew_primary='hgapi/gpt-5.4'\nmodel['primary']=new_primary\nfallbacks=model.get('fallbacks', [])\nif not isinstance(fallbacks, list):\n    fallbacks=[]\nnew_fallbacks=[]\nif old_primary and old_primary != new_primary:\n    new_fallbacks.append(old_primary)\nfor x in fallbacks:\n    if x != new_primary and x not in new_fallbacks:\n        new_fallbacks.append(x)\nmodel['fallbacks']=new_fallbacks\n\nallowed=defaults.setdefault('models', {})\nallowed[new_primary]={}\nif old_primary and old_primary not in allowed:\n    allowed[old_primary]={}\nfor x in new_fallbacks:\n    if x not in allowed:\n        allowed[x]={}\n\nwith open(p,'w',encoding='utf-8') as f:\n    json.dump(data,f,ensure_ascii=False,indent=2)\n    f.write('\\n')\nprint('backup', backup)\nprint('primary', model['primary'])\nprint('fallbacks', model['fallbacks'])\nPY\nopenclaw gateway restart\nsleep 2\npython3 - <<'PY'\nimport json\ncfg=json.load(open('/root/.openclaw/openclaw.json','r',encoding='utf-8'))\nprint('primary=', cfg['agents']['defaults']['model']['primary'])\nprint('fallbacks=', cfg['agents']['defaults']['model']['fallbacks'])\nprint('provider_exists=', 'hgapi' in cfg['models']['providers'])\nPY\nopenclaw gateway status","workdir":"/root/.openclaw/workspace","yieldMs":1000,"timeout":180},"partialJson":"{\"command\":\"python3 - <<'PY'\\nimport json, shutil, time\\np='/root/.openclaw/openclaw.json'\\nbackup=p+f'.provider-switch-{time.strftime(\\\"%Y%m%d-%H%M%S\\\")}.bak'\\nshutil.copy2(p, backup)\\nwith open(p,'r',encoding='utf-8') as f:\\n    data=json.load(f)\\n\\nmodels=data.setdefault('models', {})\\nproviders=models.setdefault('providers', {})\\nproviders['hgapi']={\\n    'baseUrl':'https://11531817.cc.cd/openai',\\n    'apiKey':'sk-b79de257f650935b3f593b405f6448067a8b3ac208498d630f162777826b1dd2',\\n    'api':'openai-completions',\\n    'models':[\\n        {'id':'gpt-5.4','name':'GPT-5.4'}\\n    ]\\n}\\n\\nagents=data.setdefault('agents', {})\\ndefaults=agents.setdefault('defaults', {})\\nmodel=defaults.setdefault('model', {})\\nold_primary=model.get('primary')\\nnew_primary='hgapi/gpt-5.4'\\nmodel['primary']=new_primary\\nfallbacks=model.get('fallbacks', [])\\nif not isinstance(fallbacks, list):\\n    fallbacks=[]\\nnew_fallbacks=[]\\nif old_primary and old_primary != new_primary:\\n    new_fallbacks.append(old_primary)\\nfor x in fallbacks:\\n    if x != new_primary and x not in new_fallbacks:\\n        new_fallbacks.append(x)\\nmodel['fallbacks']=new_fallbacks\\n\\nallowed=defaults.setdefault('models', {})\\nallowed[new_primary]={}\\nif old_primary and old_primary not in allowed:\\n    allowed[old_primary]={}\\nfor x in new_fallbacks:\\n    if x not in allowed:\\n        allowed[x]={}\\n\\nwith open(p,'w',encoding='utf-8') as f:\\n    json.dump(data,f,ensure_ascii=False,indent=2)\\n    f.write('\\\\n')\\nprint('backup', backup)\\nprint('primary', model['primary'])\\nprint('fallbacks', model['fallbacks'])\\nPY\\nopenclaw gateway restart\\nsleep 2\\npython3 - <<'PY'\\nimport json\\ncfg=json.load(open('/root/.openclaw/openclaw.json','r',encoding='utf-8'))\\nprint('primary=', cfg['agents']['defaults']['model']['primary'])\\nprint('fallbacks=', cfg['agents']['defaults']['model']['fallbacks'])\\nprint('provider_exists=', 'hgapi' in cfg['models']['providers'])\\nPY\\nopenclaw gateway status\",\"workdir\":\"/root/.openclaw/workspace\",\"yieldMs\":1000,\"timeout\":180}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":407,"output":718,"cacheRead":164736,"cacheWrite":0,"totalTokens":165861,"cost":{"input":0.0010175000000000002,"output":0.01077,"cacheRead":0.041184,"cacheWrit